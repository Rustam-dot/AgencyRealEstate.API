@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://kit.fontawesome.com/628c8d2499.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="AgencyRealEstate.WebUI.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="js/menu.js"></script>
    <HeadOutlet />
</head>
<body>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @if (NavigationManager.Uri != $"{NavigationManager.BaseUri}login")
                        {
                            <div class="alert alert-warning m-4">
                                <p>Вы должны авторизоваться для доступа к этой странице.</p>
                                <a href="/login" class="btn btn-primary">Войти</a>
                            </div>
                        }
                        else
                        {
                            <PageTitle>Вход</PageTitle>
                            <Login />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Страница не найдена</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Извините, такой страницы нет.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>