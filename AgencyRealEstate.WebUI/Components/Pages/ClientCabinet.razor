@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using AgencyRealEstate.WebUI.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "Client")]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<div class="profile-page-container">
    <div class="profile-card animate__animated animate__fadeIn">
        <div class="profile-bg-glow"></div>

        <div class="profile-header">
            <div class="profile-avatar-large">
                @(profileData.FullName?.Length > 0 ? profileData.FullName.Substring(0, 1).ToUpper() : "U")
            </div>
            <div class="profile-title">
                <h2>Личный кабинет<span class="accent-dot">.</span></h2>
                <p>Управление профилем и безопасностью</p>
            </div>
        </div>

        <div class="profile-body">
            <div class="input-section">
                <h3 class="section-subtitle">Персональная информация</h3>
                
                <div class="luxury-input-group">
                    <label><i class="fas fa-user"></i> ФИО</label>
                    <div class="input-wrapper">
                        <input @bind="profileData.FullName" type="text" placeholder="Ваше полное имя" />
                        <div class="input-focus-border"></div>
                    </div>
                </div>

                <div class="luxury-input-group">
                    <label><i class="fas fa-phone"></i> Телефон</label>
                    <div class="input-wrapper">
                        <input @bind="profileData.Phone" type="text" placeholder="+7 (___) ___-__-__" />
                        <div class="input-focus-border"></div>
                    </div>
                </div>

                <div class="luxury-input-group">
                    <label><i class="fas fa-envelope"></i> Email</label>
                    <div class="input-wrapper">
                        <input @bind="profileData.Email" type="email" placeholder="example@mail.com" />
                        <div class="input-focus-border"></div>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="password-section">
                <h3 class="section-subtitle">Изменение пароля</h3>
                <p class="section-hint">Оставьте пустым, если не хотите менять</p>

                <div class="luxury-input-group">
                    <label><i class="fas fa-key"></i> Новый пароль</label>
                    <div class="input-wrapper">
                        <input @bind="passwordModel.NewPassword" type="password" placeholder="••••••••" />
                        <div class="input-focus-border"></div>
                    </div>
                </div>

                <div class="luxury-input-group">
                    <label><i class="fas fa-shield-alt"></i> Подтверждение</label>
                    <div class="input-wrapper">
                        <input @bind="passwordModel.ConfirmPassword" type="password" placeholder="••••••••" />
                        <div class="input-focus-border"></div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-msg animate__animated animate__shakeX">
                        <i class="fas fa-exclamation-triangle"></i> @errorMessage
                    </div>
                }
            </div>

            <div class="profile-actions">
                <button @onclick="HandleUpdate" class="save-profile-btn @(isSaving ? "loading" : "")" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <div class="spinner"></div>
                        <span>Сохранение...</span>
                    }
                    else
                    {
                        <i class="fas fa-save"></i>
                        <span>Сохранить изменения</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-page-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 120px 20px 60px;
        background: radial-gradient(circle at top right, #1e1e1e 0%, #121212 100%);
    }

    .profile-card {
        width: 100%;
        max-width: 600px;
        background: rgba(30, 30, 30, 0.6);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 40px;
        padding: 50px;
        position: relative;
        box-shadow: 0 50px 100px rgba(0,0,0,0.5);
    }

    .profile-bg-glow {
        position: absolute;
        top: -100px;
        right: -100px;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(243, 156, 18, 0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 40px;
    }

    .profile-avatar-large {
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        border-radius: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        font-weight: 900;
        color: white;
        margin-bottom: 20px;
        box-shadow: 0 15px 35px rgba(243, 156, 18, 0.3);
        transform: rotate(-3deg);
    }

    .profile-title h2 { font-size: 1.8rem; font-weight: 800; color: white; margin: 0; }
    .profile-title p { color: #666; font-size: 0.9rem; margin-top: 5px; text-align: center; }
    .accent-dot { color: #f39c12; }

    .section-subtitle {
        color: #f39c12;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 800;
        margin-bottom: 20px;
        opacity: 0.9;
    }

    .section-hint { color: #555; font-size: 0.75rem; margin: -15px 0 20px; }

    .luxury-input-group { margin-bottom: 22px; }
    .luxury-input-group label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #999;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 8px;
    }
    .luxury-input-group label i { color: #f39c12; width: 15px; }

    .input-wrapper { position: relative; }
    .input-wrapper input {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 14px 18px;
        border-radius: 15px;
        color: white;
        font-size: 0.95rem;
        transition: 0.3s;
    }
    .input-wrapper input:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.07);
        border-color: rgba(243, 156, 18, 0.5);
    }

    .input-focus-border {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: #f39c12;
        transition: 0.4s ease;
        transform: translateX(-50%);
    }
    .input-wrapper input:focus + .input-focus-border { width: 50%; }

    .divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
        margin: 35px 0;
    }

    .error-msg {
        background: rgba(255, 94, 94, 0.1);
        color: #ff5e5e;
        padding: 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        margin-bottom: 20px;
        border: 1px solid rgba(255, 94, 94, 0.2);
    }

    .save-profile-btn {
        width: 100%;
        height: 55px;
        background: #f39c12;
        border: none;
        border-radius: 18px;
        color: white;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 10px 25px rgba(243, 156, 18, 0.2);
    }

    .save-profile-btn:hover:not(:disabled) {
        background: #e67e22;
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(243, 156, 18, 0.3);
    }

    .save-profile-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s infinite linear;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private ProfileModel profileData = new();
    private PasswordChangeModel passwordModel = new();
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            // Заполняем из Claims (токена)
            profileData.FullName = user.Identity.Name ?? "";
            profileData.Email = user.FindFirst(ClaimTypes.Email)?.Value 
                                ?? user.FindFirst("email")?.Value ?? "";
            profileData.Phone = user.FindFirst(ClaimTypes.MobilePhone)?.Value 
                                ?? user.FindFirst("phone")?.Value ?? "";
        }
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;

        // 1. Валидация пароля (если начали вводить)
        if (!string.IsNullOrEmpty(passwordModel.NewPassword))
        {
            if (passwordModel.NewPassword.Length < 6)
            {
                errorMessage = "Пароль должен быть не менее 6 символов.";
                return;
            }
            if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
            {
                errorMessage = "Пароли не совпадают.";
                return;
            }
        }

        isSaving = true;

        try
        {
            // Здесь твой реальный вызов API:
            // var response = await Api.UpdateProfile(profileData, passwordModel.NewPassword);
            
            await Task.Delay(1500); // Имитация долгого запроса
            
            // Если успех:
            passwordModel = new(); // Сброс полей пароля
            // Snackbar.Add("Данные успешно обновлены!", Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = "Ошибка при сохранении: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public class ProfileModel
    {
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }

    public class PasswordChangeModel
    {
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}