@page "/profile"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "Client")]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudThemeProvider IsDarkMode="true" Theme="_luxeTheme" />
<MudSnackbarProvider />

<div class="luxe-profile-wrapper">

    <div class="luxe-bg-elements">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
    </div>

    <div class="luxe-container animate__animated animate__fadeIn">
       
        <div class="luxe-profile-header">
            <div class="avatar-container">
                <div class="avatar-ring"></div>
                <div class="avatar-main">
                    @(profileData.FullName?.Length > 0 ? profileData.FullName.Substring(0, 1).ToUpper() : "U")
                </div>
            </div>
            <div class="header-text">
                <h1>Личный кабинет<span class="gold-dot">.</span></h1>
                <p>Управление вашим эксклюзивным доступом и персональными данными</p>
            </div>
        </div>

        <div class="luxe-grid">
           
            <div class="luxe-card main-info">
                <div class="card-head">
                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Color="Color.Warning" />
                    <h3>Персональная информация</h3>
                </div>
                
                <div class="luxe-form-grid">
                    <div class="luxe-input-group">
                        <label>Ваше имя</label>
                     
                        <InputText @bind-Value="profileData.FullName" class="luxe-csharp-input" placeholder="Иван Иванов" />
                    </div>

                    <div class="luxe-form-row">
                        <div class="luxe-input-group">
                            <label>Телефон</label>
                         
                            <input type="text" value="@profileData.Phone" @oninput="HandlePhoneInput" class="luxe-csharp-input" maxlength="18" placeholder="+7 (___) ___-__-__" />
                        </div>
                        <div class="luxe-input-group">
                            <label>Email</label>
                            <InputText @bind-Value="profileData.Email" type="email" class="luxe-csharp-input" placeholder="vip@agency.ru" />
                        </div>
                    </div>

                    <div class="luxe-input-group">
                        <label>Паспортные данные</label>
                        <InputText @bind-Value="profileData.PassportData" class="luxe-csharp-input" placeholder="Серия и номер" />
                    </div>

                    <div class="luxe-input-group">
                        <label>Особые пожелания к недвижимости</label>
                        <InputTextArea @bind-Value="profileData.Preferences" rows="4" class="luxe-csharp-input" placeholder="Например: Пентхаус с видом на набережную, минимум 4 спальни..." />
                    </div>
                </div>
            </div>

            
            <div class="luxe-sidebar">
                <div class="luxe-card security-card">
                    <div class="card-head">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Warning" />
                        <h3>Безопасность</h3>
                    </div>

                    <div class="luxe-input-group">
                        <label>Логин системы</label>
                        <InputText @bind-Value="profileData.Login" Class="luxe-csharp-input" />
                    </div>

                    <div class="divider"></div>

                    <div class="luxe-input-group">
                        <label>Новый пароль</label>
                        <InputText @bind-Value="passwordModel.NewPassword" type="password" class="luxe-csharp-input" placeholder="••••••••" />
                    </div>

                    <div class="luxe-input-group">
                        <label>Подтверждение</label>
                        <InputText @bind-Value="passwordModel.ConfirmPassword" type="password" class="luxe-csharp-input" placeholder="••••••••" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="luxe-error">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                            <span>@errorMessage</span>
                        </div>
                    }
                </div>

                <button @onclick="HandleUpdate" class="luxe-save-btn @(isSaving ? "is-loading" : "")" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                        <span>Обработка...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                        <span>Обновить профиль</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --gold: #f39c12;
        --gold-light: #fbc531;
        --bg: #0a0a0a;
        --card-bg: rgba(25, 25, 25, 0.8); 
        --border: rgba(255, 255, 255, 0.08);
        --input-bg: rgba(255, 255, 255, 0.03);
    }

   
    .luxe-profile-wrapper {
        min-height: 100vh;
        background: var(--bg);
        color: #fff;
        
       
        padding-top: 120px; 
        padding-bottom: 60px;
        padding-left: 20px;
        padding-right: 20px;
        
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
        z-index: 1; 
    }

   
    .luxe-bg-elements {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none; 
    }
    .glow-orb { position: absolute; width: 400px; height: 400px; border-radius: 50%; filter: blur(100px); opacity: 0.15; }
    .orb-1 { top: -100px; right: -100px; background: var(--gold); }
    .orb-2 { bottom: -100px; left: -100px; background: #3498db; }

    .luxe-container { max-width: 1200px; margin: 0 auto; position: relative; z-index: 2; }

   
    .luxe-profile-header { display: flex; align-items: center; gap: 30px; margin-bottom: 50px; }
    .avatar-container { position: relative; }
    .avatar-main { width: 100px; height: 100px; background: linear-gradient(135deg, #1a1a1a, #000); border: 2px solid var(--border); border-radius: 30px; display: flex; align-items: center; justify-content: center; font-size: 40px; font-weight: 800; color: var(--gold); box-shadow: 0 15px 35px rgba(0,0,0,0.5); }
    .avatar-ring { position: absolute; inset: -5px; border: 2px solid var(--gold); border-radius: 35px; opacity: 0.3; animation: pulse 3s infinite; }
    .header-text h1 { font-size: 36px; font-weight: 900; margin: 0; letter-spacing: -1px; }
    .gold-dot { color: var(--gold); }
    .header-text p { color: #666; margin-top: 5px; font-size: 16px; }

    
    .luxe-grid { display: grid; grid-template-columns: 1fr 400px; gap: 30px; }
    .luxe-card { background: var(--card-bg); backdrop-filter: blur(20px); border: 1px solid var(--border); border-radius: 32px; padding: 40px; box-shadow: 0 25px 50px rgba(0,0,0,0.3); }
    .card-head { display: flex; align-items: center; gap: 15px; margin-bottom: 30px; }
    .card-head h3 { font-size: 20px; font-weight: 700; margin: 0; }

    
    .luxe-input-group { margin-bottom: 25px; }
    .luxe-input-group label { display: block; font-size: 12px; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; padding-left: 5px; }

    
    .luxe-csharp-input, 
    .luxe-input-group input, 
    .luxe-input-group textarea, 
    input.luxe-csharp-input {
        width: 100% !important;
        background: var(--input-bg) !important;
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        padding: 15px 20px !important;
        color: #fff !important;
        font-size: 15px !important;
        transition: 0.3s !important;
        outline: none !important;
    }

    .luxe-csharp-input:focus, 
    .luxe-input-group input:focus, 
    .luxe-input-group textarea:focus {
        border-color: var(--gold) !important;
        background: rgba(255,255,255,0.06) !important;
        box-shadow: 0 0 20px rgba(243,156,18,0.1) !important;
    }

    .luxe-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  
    .luxe-save-btn { width: 100%; margin-top: 25px; background: var(--gold); color: #000; border: none; padding: 20px; border-radius: 20px; font-weight: 900; font-size: 16px; display: flex; align-items: center; justify-content: center; gap: 12px; cursor: pointer; transition: 0.4s; }
    .luxe-save-btn:hover:not(:disabled) { transform: translateY(-5px); background: #fff; box-shadow: 0 15px 30px rgba(243,156,18,0.3); }
    .luxe-save-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    .divider { height: 1px; background: var(--border); margin: 25px 0; }
    
    .luxe-error { background: rgba(231, 76, 60, 0.1); border: 1px solid rgba(231, 76, 60, 0.2); padding: 12px; border-radius: 12px; color: #e74c3c; font-size: 13px; display: flex; align-items: center; gap: 8px; margin-top: 15px; }

    @@keyframes pulse { 0% { transform: scale(1); opacity: 0.3; } 50% { transform: scale(1.05); opacity: 0.5; } 100% { transform: scale(1); opacity: 0.3; } }

    @@media (max-width: 1000px) {
        .luxe-grid { grid-template-columns: 1fr; }
        .luxe-profile-header { flex-direction: column; text-align: center; }
        .luxe-profile-wrapper { padding-top: 100px; } /* Чуть меньше отступ на мобильных */
    }
</style>

@code {
    private ProfileDto profileData = new();
    private PasswordChangeModel passwordModel = new();
    private bool isSaving = false;
    private string? errorMessage;

    private MudTheme _luxeTheme = new MudTheme() {
        PaletteDark = new PaletteDark() {
            Primary = "#f39c12",
            Surface = "#1a1a1a",
            Background = "#0a0a0a",
            Warning = "#f39c12"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try {
            profileData = await Api.GetProfileAsync();
        }
        catch { }
    }

    
    private void HandlePhoneInput(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";
        string digits = new string(input.Where(char.IsDigit).ToArray());

        if (digits.Length > 0 && digits[0] != '7') 
        {
            if (digits[0] == '8') digits = "7" + digits.Substring(1);
            else digits = "7" + digits;
        }
        
        if (digits.Length == 0) digits = "7";
        if (digits.Length > 11) digits = digits.Substring(0, 11);

        string formatted = "+7";
        if (digits.Length > 1)
        {
            var areaCode = digits.Substring(1, Math.Min(3, digits.Length - 1));
            formatted += $" ({areaCode}";
            if (digits.Length > 4)
            {
                formatted += ") ";
                var firstPart = digits.Substring(4, Math.Min(3, digits.Length - 4));
                formatted += firstPart;
                if (digits.Length > 7)
                {
                    formatted += "-";
                    var secondPart = digits.Substring(7, Math.Min(2, digits.Length - 7));
                    formatted += secondPart;
                    if (digits.Length > 9)
                    {
                        formatted += "-";
                        var thirdPart = digits.Substring(9, Math.Min(2, digits.Length - 9));
                        formatted += thirdPart;
                    }
                }
            }
        }
        profileData.Phone = formatted;
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;

        if (!string.IsNullOrEmpty(passwordModel.NewPassword))
        {
            if (passwordModel.NewPassword.Length < 6)
            {
                errorMessage = "Пароль слишком короткий (мин. 6 символов)";
                return;
            }
            if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
            {
                errorMessage = "Подтверждение пароля не совпадает";
                return;
            }
        }

        isSaving = true;

        try {
            var request = new UpdateProfileRequest
            {
                Login = profileData.Login,
                Email = profileData.Email,
                NewPassword = passwordModel.NewPassword,
                FullName = profileData.FullName,
                Phone = profileData.Phone,
                PassportData = profileData.PassportData,
                Preferences = profileData.Preferences
            };

            await Api.UpdateProfileAsync(request);
            passwordModel = new();
            Snackbar.Add("Профиль успешно обновлен", Severity.Success);
        }
        catch (Exception ex) {
            errorMessage = "Ошибка сервера: " + ex.Message;
        }
        finally {
            isSaving = false;
        }
    }

    public class PasswordChangeModel
    {
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}