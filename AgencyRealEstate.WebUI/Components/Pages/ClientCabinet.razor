@page "/profile"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using System.Security.Claims
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<div class="profile-page">
    <div class="bg-gradient"></div>
    
    <div class="profile-container">
        <div class="profile-header animate-fade-in">
            <div class="header-left">
                <h1 class="page-title">Настройки <span class="purple-text">профиля</span></h1>
                <p class="page-subtitle">Управление настройками аккаунта и предпочтениями</p>
            </div>
            <button class="btn-save-header" @onclick="HandleUpdate" disabled="@isSaving">
                <i class="fas fa-save"></i>
                <span>@(isSaving ? "Сохранение..." : "Сохранить изменения")</span>
            </button>
        </div>

        <div class="profile-grid">
            <div class="sidebar-left">
                <div class="card avatar-card animate-slide-up">
                    <div class="avatar-wrapper">
                        @if (!string.IsNullOrEmpty(profileData.AvatarUrl))
                        {
                            <img src="@profileData.AvatarUrl" class="avatar-large" alt="Аватар" />
                        }
                        else
                        {
                            <div class="avatar-large">
                                @(profileData.FullName?.Length > 0 ? profileData.FullName.Substring(0, 1).ToUpper() : "U")
                            </div>
                        }
                        <label class="avatar-upload">
                            <i class="fas fa-camera"></i>
                            <InputFile OnChange="HandleAvatarUpload" hidden accept="image/*" />
                        </label>
                    </div>
                    <h3 class="user-name">@profileData.FullName</h3>
                    <p class="user-role">@GetRoleName(userRole)</p>
                    <div class="user-badge">@profileData.Login</div>
                </div>

                @if (isEmployee)
                {
                    <div class="card stats-card animate-slide-up" style="animation-delay: 0.1s;">
                        <h4>Должность</h4>
                        <p class="position-text">@(profileData.Position ?? "Не указана")</p>
                        <p class="position-hint">Должность можно изменить только через администратора</p>
                    </div>
                }
            </div>

            <div class="main-content">
                <div class="card animate-slide-up" style="animation-delay: 0.1s;">
                    <div class="card-header">
                        <i class="fas fa-user"></i>
                        <h3>Личная информация</h3>
                    </div>
                    
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Полное имя</label>
                            <InputText @bind-Value="profileData.FullName" class="form-input" placeholder="Иванов Иван Иванович" />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Телефон</label>
                                <InputText @bind-Value="profileData.Phone" class="form-input" placeholder="+7 (999) 999-99-99" />
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <InputText @bind-Value="profileData.Email" type="email" class="form-input" placeholder="email@example.com" />
                            </div>
                        </div>

                        @if (!isEmployee)
                        {
                            <div class="form-group">
                                <label>Паспортные данные</label>
                                <InputText @bind-Value="profileData.PassportData" class="form-input" placeholder="Серия и номер паспорта" />
                            </div>

                            <div class="form-group">
                                <label>Пожелания к недвижимости</label>
                                <InputTextArea @bind-Value="profileData.Preferences" rows="3" class="form-input form-textarea" 
                                    placeholder="Например: 3-комнатная квартира, центр города, до 15 млн ₽..." />
                            </div>
                        }

                        <div class="form-group">
                            <label>О себе</label>
                            <InputTextArea @bind-Value="profileData.Bio" rows="2" class="form-input form-textarea" 
                                placeholder="Расскажите немного о себе..." />
                        </div>
                    </div>
                </div>

                <div class="card animate-slide-up" style="animation-delay: 0.2s;">
                    <div class="card-header">
                        <i class="fas fa-lock"></i>
                        <h3>Безопасность</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Логин</label>
                            <InputText @bind-Value="profileData.Login" class="form-input" readonly />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Текущий пароль</label>
                                <InputText @bind-Value="passwordModel.CurrentPassword" type="password" class="form-input" placeholder="••••••••" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Новый пароль</label>
                                <InputText @bind-Value="passwordModel.NewPassword" type="password" class="form-input" placeholder="••••••••" />
                            </div>
                            <div class="form-group">
                                <label>Подтвердите пароль</label>
                                <InputText @bind-Value="passwordModel.ConfirmPassword" type="password" class="form-input" placeholder="••••••••" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@code {
    private ProfileDto profileData = new();
    private PasswordChangeModel passwordModel = new();
    private bool isSaving = false;
    private string? errorMessage;
    private string userRole = "";
    private bool isEmployee = false;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            userRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
            isEmployee = userRole is "Administrator" or "Manager" or "Realtor";
            
            profileData = await Api.GetProfileAsync();
        }
        catch { }
    }

    private string GetRoleName(string role) => role switch
    {
        "Administrator" => "Администратор",
        "Manager" => "Менеджер",
        "Realtor" => "Риелтор",
        "Client" => "Клиент",
        _ => "Пользователь"
    };

    private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
    {
        var file = e.GetMultipleFiles().FirstOrDefault();
        if (file == null) return;
        try
        {
            var url = await Api.UploadAvatarAsync(file);
            profileData.AvatarUrl = url;
            Snackbar.Add("Аватар обновлён!", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;

        if (!string.IsNullOrEmpty(passwordModel.NewPassword))
        {
            if (string.IsNullOrEmpty(passwordModel.CurrentPassword))
            {
                errorMessage = "Введите текущий пароль для смены";
                return;
            }
            if (passwordModel.NewPassword.Length < 6)
            {
                errorMessage = "Пароль должен содержать минимум 6 символов";
                return;
            }
            if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
            {
                errorMessage = "Пароли не совпадают";
                return;
            }
        }

        isSaving = true;
        try 
        {
            var request = new UpdateProfileRequest
            {
                Login = profileData.Login,
                Email = profileData.Email,
                NewPassword = string.IsNullOrEmpty(passwordModel.NewPassword) ? null : passwordModel.NewPassword,
                FullName = profileData.FullName,
                Phone = profileData.Phone,
                PassportData = profileData.PassportData,
                Preferences = profileData.Preferences,
                Bio = profileData.Bio
            };

            await Api.UpdateProfileAsync(request);
            passwordModel = new();
            Snackbar.Add("Профиль успешно обновлен", Severity.Success);
        }
        catch (Exception ex) 
        {
            errorMessage = "Ошибка: " + ex.Message;
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally 
        {
            isSaving = false;
        }
    }

    public class PasswordChangeModel
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}