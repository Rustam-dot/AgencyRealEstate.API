@page "/about"
@rendermode InteractiveServer

<div class="about-page">
    <div class="bg-gradient"></div>
    
    <div class="container">
        <!-- Hero Section -->
        <section class="about-hero animate-fade-in">
            <h1 class="page-title">О <span class="purple-text">компании</span></h1>
            <p class="page-subtitle">Ваш надежный партнер в мире недвижимости с 2014 года</p>
        </section>

        <!-- Mission Section -->
        <section class="mission-section animate-fade-up">
            <div class="mission-grid">
                <div class="mission-content">
                    <h2>Наша <span class="purple-text">миссия</span></h2>
                    <p>Мы помогаем людям находить недвижимость мечты, предоставляя профессиональные услуги на всех этапах сделки. Наша цель — сделать процесс покупки или продажи максимально комфортным и безопасным.</p>
                    
                    <div class="values-list">
                        <div class="value-item">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <h4>Профессионализм</h4>
                                <p>Команда сертифицированных специалистов с многолетним опытом</p>
                            </div>
                        </div>
                        <div class="value-item">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <h4>Прозрачность</h4>
                                <p>Полная открытость на всех этапах работы</p>
                            </div>
                        </div>
                        <div class="value-item">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <h4>Надежность</h4>
                                <p>Гарантия безопасности сделок и конфиденциальности</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mission-image">
                    <div class="image-placeholder">
                        <i class="fas fa-building"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="stats-section animate-fade-up">
            <h2>Наши <span class="purple-text">достижения</span></h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number" data-target="1000">0</div>
                    <div class="stat-label">Проданных объектов</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" data-target="500">0</div>
                    <div class="stat-label">Довольных клиентов</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" data-target="50">0</div>
                    <div class="stat-label">Профессиональных агентов</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" data-target="10">0</div>
                    <div class="stat-label">Лет на рынке</div>
                </div>
            </div>
        </section>

        <!-- Team Section -->
        <section class="team-section animate-fade-up">
            <h2>Наша <span class="purple-text">команда</span></h2>
            <p class="section-subtitle">Профессионалы, которые помогут вам найти идеальный дом</p>
            
            <div class="team-grid">
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3>Александр Петров</h3>
                    <p class="team-role">Генеральный директор</p>
                    <p class="team-desc">15 лет опыта в сфере недвижимости</p>
                </div>
                
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3>Елена Смирнова</h3>
                    <p class="team-role">Ведущий риелтор</p>
                    <p class="team-desc">Специалист по элитной недвижимости</p>
                </div>
                
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3>Михаил Иванов</h3>
                    <p class="team-role">Финансовый консультант</p>
                    <p class="team-desc">Эксперт по ипотечному кредитованию</p>
                </div>
                
                <div class="team-card">
                    <div class="team-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3>Анна Козлова</h3>
                    <p class="team-role">Юрист</p>
                    <p class="team-desc">Сопровождение сделок любой сложности</p>
                </div>
            </div>
        </section>

        <!-- Why Us Section -->
        <section class="why-us-section animate-fade-up">
            <h2>Почему <span class="purple-text">выбирают нас</span></h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3>Безопасность</h3>
                    <p>Полная юридическая проверка объектов и сопровождение сделки</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h3>Экономия времени</h3>
                    <p>Подберем варианты под ваши критерии за 24 часа</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <h3>Выгодные условия</h3>
                    <p>Поможем получить лучшую цену и выгодную ипотеку</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h3>Поддержка 24/7</h3>
                    <p>Всегда на связи и готовы ответить на ваши вопросы</p>
                </div>
            </div>
        </section>
    </div>
</div>



@code {
    protected override void OnInitialized()
    {
        
    }
}