@page "/"
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@inject ApiClient ApiClient

<div class="page-wrapper">
    <div class="hero-header">
        <h1>Избранные объекты</h1>
        <p>Найдите дом своей мечты в нашей эксклюзивной коллекции</p>
    </div>

    <div class="property-grid">
        @if (popularProperties == null)
        {
            <div class="loader" style="color: white;">Загрузка...</div>
        }
        else
        {
            @foreach (var prop in popularProperties)
            {
                <div class="luxury-card">
                    <div class="card-image-box">
                        @if (prop.PhotoUrls != null && prop.PhotoUrls.Any())
                        {
                            <img src="@prop.PhotoUrls.First()" alt="Фото объекта" />
                        }
                        else
                        {
                            <div class="no-photo">Нет фото</div>
                        }
                    </div>
                    <div class="card-body-luxury">
                        <h3 class="card-address-title">@prop.Address</h3>
                        <p class="card-location-subtitle">Центральный район</p>
                        <div class="card-price-tag">@prop.Price?.ToString("N0") ₽</div>
                        
                        <a href="/property/@prop.PropertyID" class="card-btn-pill">Посмотреть</a>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    List<PropertyDto>? popularProperties;

    protected override async Task OnInitializedAsync()
    {
        try { popularProperties = await ApiClient.GetPropertiesAsync(); }
        catch { popularProperties = new(); }
    }
}