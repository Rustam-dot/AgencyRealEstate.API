@page "/"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="main-wrapper">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container hero-content">
            <AuthorizeView>
                <Authorized>
                    <div class="hero-greeting fade-in-up">
                        <i class="fas fa-hand-wave"></i>
                        <span>Добро пожаловать, <strong>@context.User.Identity?.Name</strong>!</span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <h1 class="hero-title fade-in-up delay-1">
                Найдите свой <span class="text-gradient">дом мечты</span>
            </h1>
            
            <p class="hero-subtitle fade-in-up delay-2">
                Современная платформа для поиска и продажи недвижимости премиум-класса
            </p>
            
            <div class="search-container fade-in-up delay-3">
                <div class="search-box">
                    <div class="search-input-group">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" 
                               placeholder="Поиск по городу, району или адресу..." 
                               @bind="searchQuery" 
                               @onkeydown="OnKeyDown" />
                    </div>
                    <button class="btn btn-primary btn-search" @onclick="Search">
                        Найти
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card glass-card fade-in-up delay-4">
                    <div class="stat-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="stat-content">
                        <h3>1000+</h3>
                        <p>Объектов в базе</p>
                    </div>
                </div>
                
                <div class="stat-card glass-card fade-in-up delay-5">
                    <div class="stat-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="stat-content">
                        <h3>50+</h3>
                        <p>Опытных агентов</p>
                    </div>
                </div>
                
                <div class="stat-card glass-card fade-in-up delay-6">
                    <div class="stat-icon">
                        <i class="fas fa-award"></i>
                    </div>
                    <div class="stat-content">
                        <h3>10+ лет</h3>
                        <p>Успешной работы</p>
                    </div>
                </div>
                
                <div class="stat-card glass-card fade-in-up delay-7">
                    <div class="stat-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="stat-content">
                        <h3>98%</h3>
                        <p>Успешных сделок</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Properties -->
    <section class="section">
        <div class="container">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <h2 class="section-title">Избранные объекты</h2>
                    <p class="section-subtitle">Лучшие предложения этого месяца</p>
                </div>
                <a href="/properties" class="btn-link">
                    Все объекты
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="property-grid">
                @if (popularProperties == null)
                {
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="property-card skeleton-card"></div>
                    }
                }
                else if (!popularProperties.Any())
                {
                    <div class="empty-state glass-card">
                        <i class="fas fa-inbox"></i>
                        <h3>Ничего не найдено</h3>
                        <p>Попробуйте изменить параметры поиска</p>
                    </div>
                }
                else
                {
                    @foreach (var prop in popularProperties.Take(3))
                    {
                        <div class="property-card glass-card animate-on-scroll">
                            <div class="card-image">
                                @if (prop.PhotoUrls != null && prop.PhotoUrls.Any())
                                {
                                    <img src="@prop.PhotoUrls.First()" alt="@prop.Title" />
                                }
                                else
                                {
                                    <div class="no-image">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }
                                <div class="card-badge">@prop.Price?.ToString("N0") ₽</div>
                            </div>
                            <div class="card-content">
                                <h3 class="card-title">@prop.Title</h3>
                                <div class="card-location">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <span>@prop.Address</span>
                                </div>
                                
                                <div class="card-specs">
                                    <div class="spec">
                                        <i class="fas fa-bed"></i>
                                        <span>@prop.Rooms</span>
                                    </div>
                                    <div class="spec">
                                        <i class="fas fa-bath"></i>
                                        <span>@prop.Bathrooms</span>
                                    </div>
                                    <div class="spec">
                                        <i class="fas fa-ruler-combined"></i>
                                        <span>@prop.TotalArea м²</span>
                                    </div>
                                </div>

                                <AuthorizeView Roles="Client">
                                    <Authorized>
                                        <a href="/properties/@prop.PropertyID" class="btn btn-primary btn-block">
                                            Записаться на показ
                                        </a>
                                    </Authorized>
                                    <NotAuthorized>
                                        <button class="btn btn-primary btn-block btn-disabled" disabled>
                                            Записаться на показ
                                        </button>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</div>

@code {
    string searchQuery = "";
    List<PropertyDto>? allProperties;
    List<PropertyDto>? popularProperties;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allProperties = await ApiClient.GetPropertiesAsync();
            popularProperties = allProperties?.Take(3).ToList() ?? new(); 
        }
        catch
        {
            allProperties = new();
            popularProperties = new();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Search();
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        var encoded = Uri.EscapeDataString(searchQuery);
        Navigation.NavigateTo($"/properties?search={encoded}");
    }
}