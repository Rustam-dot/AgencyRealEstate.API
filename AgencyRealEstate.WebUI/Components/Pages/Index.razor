@page "/"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="main-container">
    @* Декоративные фоновые свечения *@
    <div class="bg-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <section class="hero-block">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            
            <AuthorizeView>
                <Authorized>
                    <div class="user-badge fade-in">
                        <span class="status-dot"></span>
                        Добро пожаловать, <span class="user-name">@context.User.Identity?.Name</span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <h1 class="hero-title fade-in">Эксклюзивная <br/><span class="gold-gradient">недвижимость</span></h1>
            <p class="hero-subtitle fade-in-delay">Найдите идеальное место для жизни в Elite Estates</p>
            
            <div class="search-bar-premium fade-in-delay">
                <div class="search-input-wrapper">
                    <i class="fas fa-map-marker-alt"></i>
                    <input type="text" placeholder="Город, район или ЖК..." @bind="searchQuery" @onkeydown="OnKeyDown" />
                </div>
                <button class="search-btn" @onclick="Search">
                    <span>Найти</span>
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </section>

    <div class="page-wrapper">
        <div class="section-header">
            <div class="title-area">
                <h2 class="section-title">Популярные объекты<span class="gold-dot">.</span></h2>
                <div class="section-line"></div>
            </div>
            <div class="filter-pills">
                <button class="pill @(selectedType == null ? "active" : "")" @onclick='() => FilterByType(null)'>
                    <i class="fas fa-layer-group"></i> Все
                </button>
                <button class="pill @(selectedType == "Apartment" ? "active" : "")" @onclick='() => FilterByType("Apartment")'>
                    <i class="fas fa-building"></i> Квартиры
                </button>
                <button class="pill @(selectedType == "House" ? "active" : "")" @onclick='() => FilterByType("House")'>
                    <i class="fas fa-home"></i> Дома
                </button>
                <button class="pill @(selectedType == "Land" ? "active" : "")" @onclick='() => FilterByType("Land")'>
                    <i class="fas fa-tree"></i> Участки
                </button>
            </div>
        </div>

        <div class="property-grid">
            @if (popularProperties == null)
            {
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-img"></div>
                        <div class="skeleton-text"></div>
                        <div class="skeleton-text short"></div>
                    </div>
                }
            }
            else if (!popularProperties.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon-box">
                        <i class="fas fa-search"></i>
                    </div>
                    <h3>Ничего не найдено</h3>
                    <p>По вашему запросу нет доступных объектов. Попробуйте изменить параметры.</p>
                </div>
            }
            else
            {
                @foreach (var prop in popularProperties)
                {
                    <div class="luxury-card">
                        <div class="card-image-box">
                            @if (prop.PhotoUrls != null && prop.PhotoUrls.Any())
                            {
                                <img src="@prop.PhotoUrls.First()" alt="@prop.PropertyTypeName" />
                            }
                            else
                            {
                                <div class="no-photo-placeholder">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                            <div class="card-tag">@prop.PropertyTypeName</div>
                            <div class="card-gradient-overlay"></div>
                        </div>
                        <div class="card-body-luxury">
                            <h3 class="card-address-title">@prop.Address</h3>
                            
                            <div class="card-specs">
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-bed"></i></div>
                                    <span>@prop.Rooms комн.</span>
                                </div>
                                <div class="spec-divider"></div>
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-ruler-combined"></i></div>
                                    <span>@prop.TotalArea м²</span>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="price-container">
                                    <span class="price-label">Стоимость</span>
                                    <div class="card-price-tag">@prop.Price?.ToString("N0") <span class="currency">₽</span></div>
                                </div>
                                <a href="/property/@prop.PropertyID" class="btn-view-circle">
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    :root {
        --gold: #f39c12;
        --bg-dark: #0a0a0a;
        --card-bg: rgba(25, 25, 25, 0.7);
        --border-glass: rgba(255, 255, 255, 0.08);
    }

    /* ГЛОБАЛЬНЫЕ КОНТЕЙНЕРЫ */
    .main-container { background: var(--bg-dark); min-height: 100vh; color: #fff; position: relative; overflow-x: hidden; font-family: 'Inter', sans-serif; }
    .page-wrapper { max-width: 1400px; margin: 0 auto; padding: 80px 40px; position: relative; z-index: 2; }

    /* ФОНОВЫЕ СВЕЧЕНИЯ */
    .bg-orbs { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .orb { position: absolute; filter: blur(130px); border-radius: 50%; opacity: 0.15; animation: floatOrb 10s infinite alternate ease-in-out; }
    .orb-1 { top: 10%; right: -5%; width: 500px; height: 500px; background: var(--gold); }
    .orb-2 { bottom: 20%; left: -10%; width: 600px; height: 600px; background: #3498db; }

    @@keyframes floatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(-30px, 50px) scale(1.1); } }

    /* HERO SECTION */
    .hero-block {
        height: 75vh;
        min-height: 600px;
        position: relative;
        background: url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=2075&auto=format&fit=crop') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,10,10,0.6) 0%, var(--bg-dark) 100%); }
    .hero-content { position: relative; z-index: 5; max-width: 900px; padding: 0 20px; }

    /* WELCOME BADGE */
    .user-badge {
        display: inline-flex; align-items: center; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px);
        border: 1px solid var(--border-glass); padding: 8px 20px; border-radius: 50px; margin-bottom: 30px;
        font-size: 0.9rem; color: #ccc; box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }
    .status-dot { width: 8px; height: 8px; background: #4ade80; border-radius: 50%; margin-right: 12px; box-shadow: 0 0 10px #4ade80; }
    .user-name { font-weight: 700; margin-left: 5px; color: #fff; }

    .hero-title { font-size: 4.5rem; font-weight: 900; line-height: 1.1; margin-bottom: 20px; letter-spacing: -2px; }
    .gold-gradient { background: linear-gradient(135deg, #fbc531, #e67e22); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero-subtitle { font-size: 1.25rem; color: #aaa; margin-bottom: 50px; font-weight: 300; }

    /* SEARCH BAR PREMIUM */
    .search-bar-premium {
        background: rgba(20, 20, 20, 0.6); backdrop-filter: blur(25px);
        padding: 12px; border-radius: 24px; display: flex; gap: 10px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1);
        transition: 0.3s;
    }
    .search-bar-premium:focus-within { border-color: rgba(243, 156, 18, 0.5); box-shadow: 0 30px 60px rgba(0,0,0,0.6), 0 0 20px rgba(243, 156, 18, 0.2); }
    
    .search-input-wrapper { flex: 1; display: flex; align-items: center; padding: 0 25px; gap: 15px; }
    .search-input-wrapper i { color: var(--gold); font-size: 1.2rem; }
    .search-input-wrapper input { background: transparent; border: none; color: #fff; width: 100%; font-size: 1.1rem; outline: none; font-family: inherit; }
    .search-input-wrapper input::placeholder { color: #666; }
    
    .search-btn {
        background: var(--gold); color: #000; border: none; padding: 15px 40px; border-radius: 16px;
        font-weight: 800; font-size: 1rem; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 10px;
    }
    .search-btn:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(243,156,18,0.3); }

    /* FILTERS & HEADERS */
    .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 50px; }
    .section-title { font-size: 2.5rem; font-weight: 800; margin: 0; letter-spacing: -1px; }
    .gold-dot { color: var(--gold); }
    .section-line { width: 60px; height: 4px; background: var(--gold); margin-top: 15px; border-radius: 4px; }
    
    .filter-pills { display: flex; gap: 12px; }
    .pill {
        padding: 12px 24px; border-radius: 50px; background: rgba(255,255,255,0.03); color: #888;
        cursor: pointer; transition: 0.3s; font-weight: 600; border: 1px solid var(--border-glass);
        display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-family: inherit;
    }
    .pill i { font-size: 1rem; transition: 0.3s; }
    .pill.active { background: var(--gold); color: #000; border-color: var(--gold); box-shadow: 0 10px 20px rgba(243, 156, 18, 0.2); }
    .pill:hover:not(.active) { background: rgba(255,255,255,0.08); color: #fff; }

    /* PROPERTY CARDS */
    .property-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 35px; }
    
    .luxury-card {
        background: var(--card-bg); backdrop-filter: blur(20px); border-radius: 32px; overflow: hidden;
        transition: 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); border: 1px solid var(--border-glass);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }
    .luxury-card:hover { transform: translateY(-10px); border-color: rgba(243, 156, 18, 0.4); box-shadow: 0 40px 80px rgba(0,0,0,0.7); }

    .card-image-box { height: 280px; position: relative; overflow: hidden; }
    .card-image-box img { width: 100%; height: 100%; object-fit: cover; transition: 0.7s ease; }
    .luxury-card:hover .card-image-box img { transform: scale(1.08); }
    .card-gradient-overlay { position: absolute; inset: 0; background: linear-gradient(to top, var(--card-bg) 0%, transparent 40%); pointer-events: none; }
    
    .card-tag {
        position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.5); backdrop-filter: blur(10px);
        color: #fff; padding: 8px 16px; border-radius: 12px; font-size: 0.8rem; font-weight: 700;
        border: 1px solid rgba(255,255,255,0.1); text-transform: uppercase; letter-spacing: 1px; z-index: 2;
    }

    .card-body-luxury { padding: 30px; position: relative; z-index: 2; }
    .card-address-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 20px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    
    .card-specs { display: flex; align-items: center; gap: 15px; margin-bottom: 30px; color: #ccc; background: rgba(255,255,255,0.03); padding: 12px 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .spec-item { display: flex; align-items: center; gap: 10px; font-size: 1rem; font-weight: 600; }
    .spec-icon { color: var(--gold); display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; }
    .spec-divider { width: 1px; height: 20px; background: rgba(255,255,255,0.1); }

    .card-footer { display: flex; justify-content: space-between; align-items: center; }
    .price-label { font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; display: block; }
    .card-price-tag { font-size: 1.8rem; font-weight: 900; color: #fff; }
    .currency { font-size: 1.2rem; color: var(--gold); margin-left: 4px; }

    .btn-view-circle {
        width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--border-glass);
        display: flex; align-items: center; justify-content: center; transition: 0.4s; text-decoration: none; font-size: 1.2rem;
    }
    .luxury-card:hover .btn-view-circle { background: var(--gold); color: #000; border-color: var(--gold); transform: scale(1.1) rotate(-45deg); box-shadow: 0 10px 20px rgba(243,156,18,0.3); }

    /* SKELETON & EMPTY STATE */
    .skeleton-card { height: 500px; background: var(--card-bg); border-radius: 32px; border: 1px solid var(--border-glass); animation: pulse 1.5s infinite; }
    @@keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 0.2; } 100% { opacity: 0.5; } }
    
    .empty-state { grid-column: 1/-1; text-align: center; padding: 100px 20px; background: var(--card-bg); border-radius: 32px; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-icon-box { width: 80px; height: 80px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem; color: var(--gold); }
    .empty-state h3 { font-size: 1.8rem; font-weight: 700; margin-bottom: 10px; }
    .empty-state p { color: #888; font-size: 1.1rem; }

    /* ANIMATIONS */
    .fade-in { animation: fadeIn 0.8s cubic-bezier(0.165, 0.84, 0.44, 1); }
    .fade-in-delay { animation: fadeIn 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) 0.2s backwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

    @@media (max-width: 900px) {
        .hero-title { font-size: 3rem; }
        .section-header { flex-direction: column; align-items: flex-start; gap: 30px; }
        .filter-pills { flex-wrap: wrap; }
        .search-bar-premium { flex-direction: column; padding: 20px; border-radius: 20px; }
        .search-input-wrapper { padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 15px; }
    }
</style>

@code {
    string searchQuery = "";
    string? selectedType = null;
    List<PropertyDto>? allProperties;
    List<PropertyDto>? popularProperties;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allProperties = await ApiClient.GetPropertiesAsync();
            ApplyFilter();
        }
        catch
        {
            allProperties = new();
            popularProperties = new();
        }
    }

    private void FilterByType(string? type)
    {
        selectedType = type;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allProperties == null)
        {
            popularProperties = new();
            return;
        }

        if (string.IsNullOrEmpty(selectedType))
        {
            popularProperties = allProperties.Take(6).ToList();
        }
        else
        {
            popularProperties = selectedType switch
            {
                "Apartment" => allProperties.Where(p => p.PropertyTypeName == "Квартира").Take(6).ToList(),
                "House" => allProperties.Where(p => p.PropertyTypeName is "Дом" or "Таунхаус").Take(6).ToList(),
                "Land" => allProperties.Where(p => p.PropertyTypeName == "Участок").Take(6).ToList(),
                _ => allProperties.Take(6).ToList()
            };
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            Search();
    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        var encoded = Uri.EscapeDataString(searchQuery);
        Navigation.NavigateTo($"/properties?search={encoded}");
    }
}