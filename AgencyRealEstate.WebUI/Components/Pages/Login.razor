@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject TokenStorage TokenStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<div class="page-background">
    <div class="container-form-1">
        
        <div class="header-titles">
            <h1>Elite Estates</h1>
            <p>Ваш путь к роскошной жизни</p>
        </div>

        <div class="form-1">
            <div class="toggle-wrapper">
                <div class="toggle-bg @(!isLogin ? "right" : "")"></div>
                <button type="button" class="toggle-btn @(isLogin ? "active" : "")" @onclick="() => isLogin = true">Вход</button>
                <button type="button" class="toggle-btn @(!isLogin ? "active" : "")" @onclick="() => isLogin = false">Регистрация</button>
            </div>

            <div class="form-content">
                @if (isLogin)
                {
                    <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="loginForm" class="fade-in-form">
                        <DataAnnotationsValidator />
                        <h2 class="form-title">Добро пожаловать</h2>
                        
                        <InputText @bind-Value="loginModel.Login" placeholder="Электронная почта" class="input-solid" />
                        <InputText @bind-Value="loginModel.Password" type="password" placeholder="Пароль" class="input-solid" />
                        
                        <div class="bottom-row login-bottom">
                            <button type="submit" class="submit-pill">Войти</button>
                            <a href="#" @onclick:preventDefault class="forgot-link">Забыли пароль?</a>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="error-msg">@errorMessage</div>
                        }
                    </EditForm>
                }
                else
                {
                    <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="registerForm" class="fade-in-form">
                        <DataAnnotationsValidator />
                        <h2 class="form-title">Создать аккаунт</h2>
                        
                        <InputText @bind-Value="registerModel.FullName" placeholder="Полное имя" class="input-solid" />
                        <InputText @bind-Value="registerModel.Email" placeholder="Электронная почта" class="input-solid" />
                        <InputText @bind-Value="registerModel.Password" type="password" placeholder="Пароль" class="input-solid" />
                        
                        <div class="bottom-row register-bottom">
                            <button type="submit" class="submit-pill">Регистрация</button>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="error-msg">@errorMessage</div>
                        }
                    </EditForm>
                }
            </div>
        </div>

        <div class="drops">
            <div class="drop-form-1 drop-1-form-1"></div>
            <div class="drop-form-1 drop-2-form-1"></div>
            <div class="drop-form-1 drop-3-form-1"></div>
            <div class="drop-form-1 drop-4-form-1"></div>
            <div class="drop-form-1 drop-5-form-1"></div>
        </div>
    </div>
</div>

@code {
    private bool isLogin = true;
    private LoginRequest loginModel = new();
    private RegisterRequest registerModel = new();
    private string? errorMessage;

    public class LoginRequest
    {
        [Required(ErrorMessage = "Введите логин")]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }

    public class RegisterRequest
    {
        [Required(ErrorMessage = "Введите полное имя")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        public string Password { get; set; } = "";
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("auth/login", loginModel);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null)
                {
                    await JS.InvokeVoidAsync("eval", $"document.cookie = 'authToken={result.Token}; path=/; secure; samesite=strict; max-age=86400'");
                    ((TokenAuthenticationStateProvider)AuthStateProvider).NotifyAuthStateChanged();
                    Navigation.NavigateTo("/", forceLoad: true);
                }
                else
                {
                    errorMessage = "Ошибка чтения ответа.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = errorContent.Contains("error") ? errorContent : "Неверный логин или пароль";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка соединения: {ex.Message}";
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        try
        {
            errorMessage = "Функция регистрации в разработке.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка соединения: {ex.Message}";
        }
    }
}

<style>
    /* Фоновые стили страницы */
    .page-background {
        background-color: #212121;
        min-height: 100vh;
        width: 100%;
        position: relative;
        overflow: hidden;
        font-family: "Montserrat", sans-serif;
    }

    /* Заголовок Elite Estates */
    .header-titles {
        text-align: center;
        margin-bottom: 20px;
        color: #ffffff;
        position: relative;
        z-index: 2;
    }
    .header-titles h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: 1px;
    }
    .header-titles p {
        color: #8da1b9;
        font-size: 1rem;
        margin-top: 5px;
    }

    /* Контейнер */
    .container-form-1 {
        position: absolute;
        transform: translate(-50%, -50%);
        top: 50%;
        left: 50%;
        width: 100%;
        max-width: 450px;
    }

    /* Сама форма (теперь полупрозрачная) */
    .form-1 {
        background: rgba(45, 45, 45, 0.6); /* Полупрозрачный фон */
        backdrop-filter: blur(12px);       /* Эффект матового стекла */
        -webkit-backdrop-filter: blur(12px);
        padding: 2.5em 3em;
        border-radius: 20px;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 20px 20px 40px -6px rgba(0, 0, 0, 0.6);
        position: relative;
        z-index: 2;
    }

    /* Переключатель Вход/Регистрация */
    .toggle-wrapper {
        display: flex;
        position: relative;
        margin: 0 auto 30px auto;
        width: 80%;
        justify-content: space-between;
    }
    .toggle-btn {
        flex: 1;
        padding: 12px 0;
        background: transparent;
        border: none;
        color: #999;
        font-weight: 600;
        font-size: 1rem;
        font-family: "Montserrat", sans-serif;
        cursor: pointer;
        z-index: 2;
        transition: color 0.3s ease;
        text-align: center;
    }
    .toggle-btn.active {
        color: #fff;
    }
    .toggle-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 50%;
        height: 100%;
        background: rgba(80, 80, 80, 0.5); /* Немного прозрачный ползунок */
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 5000px;
        transition: transform 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
        z-index: 1;
    }
    .toggle-bg.right {
        transform: translateX(100%);
    }

    /* Анимация смены форм */
    .fade-in-form {
        animation: fadeIn 0.4s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Текст внутри формы */
    h2.form-title {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 25px;
        text-align: left;
    }

    /* Поля ввода */
    .input-solid {
        background: #f4f5f7 !important;
        width: 100%;
        box-sizing: border-box;
        padding: 1.2em 1.5em;
        margin-bottom: 1.2em;
        border: none;
        border-radius: 5000px !important;
        color: #333;
        font-family: Montserrat, sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }
    .input-solid::placeholder {
        color: #8a94a6;
    }
    .input-solid:focus {
        outline: 2px solid #aaa;
        background: #ffffff !important;
    }

    /* Кнопки и ссылки снизу */
    .bottom-row {
        display: flex;
        align-items: center;
        margin-top: 10px;
    }
    .login-bottom {
        justify-content: space-between;
    }
    .register-bottom {
        justify-content: flex-start;
    }
    
    .submit-pill {
        width: auto;
        min-width: 130px;
        font-size: 1rem;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 5000px;
        color: #fff;
        font-family: Montserrat, sans-serif;
        font-weight: 600;
        padding: 0.8em 1.5em;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .submit-pill:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .forgot-link {
        text-decoration: none;
        color: #c0c0c0;
        font-size: 0.85rem;
        transition: color 0.2s ease;
    }
    .forgot-link:hover {
        color: #ffffff;
    }
    
    .error-msg {
        color: #ffaaaa;
        margin-top: 15px;
        font-size: 0.9rem;
        text-align: center;
    }

    /* --- КУБЫ --- */
    .drop-form-1 {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: 15px;
        border-left: 1px solid rgba(255, 255, 255, 0.15);
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 10px 10px 40px -8px rgba(0, 0, 0, 0.3);
        position: absolute;
    }

    /* Более сложные и «рандомные» анимации */
    @@keyframes driftRandom1 {
        0%   { transform: translate(0, 0) rotate(0deg); }
        33%  { transform: translate(25px, -15px) rotate(10deg); }
        66%  { transform: translate(-10px, 20px) rotate(-5deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
    }
    @@keyframes driftRandom2 {
        0%   { transform: translate(0, 0) rotate(0deg); }
        33%  { transform: translate(-20px, -25px) rotate(-15deg); }
        66%  { transform: translate(15px, -10px) rotate(10deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
    }
    @@keyframes driftRandom3 {
        0%   { transform: translate(0, 0) scale(1); }
        33%  { transform: translate(-30px, 15px) scale(1.05); }
        66%  { transform: translate(10px, -20px) scale(0.95); }
        100% { transform: translate(0, 0) scale(1); }
    }
    @@keyframes driftRandom4 {
        0%   { transform: translate(0, 0) rotate(0deg); }
        25%  { transform: translate(20px, -30px) rotate(5deg); }
        50%  { transform: translate(40px, 0px) rotate(-5deg); }
        75%  { transform: translate(10px, 20px) rotate(8deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
    }
    @@keyframes driftRandom5 {
        0%   { transform: translate(0, 0); }
        33%  { transform: translate(-15px, 25px); }
        66%  { transform: translate(-30px, -10px); }
        100% { transform: translate(0, 0); }
    }

    .drop-1-form-1 { height: 80px; width: 80px; top: -20px; left: -40px; z-index: 1; animation: driftRandom1 8s ease-in-out infinite; }
    
    /* Нижний правый угол (drop-2 и drop-3). z-index: 3 делает их поверх формы */
    .drop-2-form-1 { height: 80px; width: 80px; bottom: -30px; right: -10px; z-index: 3; animation: driftRandom2 9s ease-in-out infinite; }
    .drop-3-form-1 { height: 100px; width: 100px; bottom: 120px; right: -50px; z-index: 3; animation: driftRandom3 11s ease-in-out infinite; }
    
    /* Большой квадрат: z-index: 3, летает НАД формой */
    .drop-4-form-1 { height: 120px; width: 120px; top: -60px; right: -40px; z-index: 3; animation: driftRandom4 14s ease-in-out infinite; }
    
    .drop-5-form-1 { height: 60px; width: 60px; bottom: 170px; left: 90px; z-index: 1; animation: driftRandom5 10s ease-in-out infinite; }
</style>