@page "/reports"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager")]
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="reports-dashboard">
    <div class="dashboard-header mb-4 fade-in-up" style="animation-delay: 0s;">
        <div class="header-text">
            <h1>Отчёты и <span class="text-primary">аналитика</span></h1>
            <p>Обзор эффективности бизнеса</p>
        </div>
    </div>

    @if (report == null)
    {
        <div class="loader-container">
            <div class="premium-spinner"></div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3" @onclick="() => ShowObjectsModal(null)" style="cursor:pointer;">
                <div class="stat-card-v2 fade-in-up" style="animation-delay: 0.1s;">
                    <div class="card-icon-box"><i class="fas fa-building"></i></div>
                    <div class="card-info">
                        <span class="v-number">@report.Properties.Total</span>
                        <span class="v-label">Всего объектов</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3" @onclick='() => ShowObjectsModal("Available")' style="cursor:pointer;">
                <div class="stat-card-v2 fade-in-up" style="animation-delay: 0.2s;">
                    <div class="card-icon-box primary-icon"><i class="fas fa-check-circle"></i></div>
                    <div class="card-info">
                        <span class="v-number">@report.Properties.Available</span>
                        <span class="v-label">Доступно</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3" @onclick='() => ShowObjectsModal("Sold")' style="cursor:pointer;">
                <div class="stat-card-v2 fade-in-up" style="animation-delay: 0.3s;">
                    <div class="card-icon-box"><i class="fas fa-chart-line"></i></div>
                    <div class="card-info">
                        <span class="v-number">@report.Properties.Sold</span>
                        <span class="v-label">Продано</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card-v2 fade-in-up" style="animation-delay: 0.4s;">
                    <div class="card-icon-box primary-icon"><i class="fas fa-dollar-sign"></i></div>
                    <div class="card-info">
                        <span class="v-number">@(report.MonthlyRevenue.LastOrDefault()?.TotalAmount.ToString("N0") ?? "0") ₽</span>
                        <span class="v-label">Общая выручка</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-glass-card fade-in-up" style="animation-delay: 0.5s;">
                    <div class="chart-header">
                        <i class="fas fa-dollar-sign text-primary me-2"></i> Выручка по месяцам
                    </div>
                    <div class="canvas-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="chart-glass-card fade-in-up" style="animation-delay: 0.6s;">
                    <div class="chart-header">
                        <i class="fas fa-exchange-alt text-primary me-2"></i> Количество сделок
                    </div>
                    <div class="canvas-container">
                        <canvas id="transactionsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="top-performers-section fade-in-up" style="animation-delay: 0.7s;">
            <div class="section-title">
                <i class="fas fa-award text-primary me-2"></i> Лучшие риелторы
            </div>
            <div class="performers-list">
                @foreach (var r in report.Realtors.List)
                {
                    <div class="performer-horizontal-item animate-hover" @onclick='() => ShowRealtorDeals(r.RealtorName)' style="cursor:pointer;">
                        <div class="rank-badge">@(report.Realtors.List.IndexOf(r) + 1)</div>
                        <div class="p-avatar">@r.RealtorName[0]</div>
                        <div class="p-details">
                            <span class="p-name">@r.RealtorName</span>
                            <span class="p-sub">@r.DealsCount сделок</span>
                        </div>
                        <div class="p-revenue">
                            <span class="p-amount">@r.TotalAmount.ToString("N0") ₽</span>
                            <span class="p-sub">доход</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showObjectsModal)
{
    <div class="modal-backdrop animate-fade-in" @onclick="CloseModals">
        <div class="modal-card animate-modal-in" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-list me-2 text-primary"></i> @modalTitle</h3>
                <button class="close-btn" @onclick="CloseModals">×</button>
            </div>
            <div class="modal-body">
                @if (modalObjects != null && modalObjects.Any())
                {
                    <div class="table-responsive">
                        <table class="premium-table">
                            <thead>
                                <tr>
                                    <th @onclick='() => SortList(modalObjects, "Id", x => x.PropertyId)' style="cursor:pointer;">
                                        ID <i class="@GetSortIcon("Id")"></i>
                                    </th>
                                    <th @onclick='() => SortList(modalObjects, "Address", x => x.Address)' style="cursor:pointer;">
                                        Адрес <i class="@GetSortIcon("Address")"></i>
                                    </th>
                                    <th @onclick='() => SortList(modalObjects, "Price", x => x.Price)' style="cursor:pointer;">
                                        Цена <i class="@GetSortIcon("Price")"></i>
                                    </th>
                                    <th @onclick='() => SortList(modalObjects, "Status", x => x.StatusName)' style="cursor:pointer;">
                                        Статус <i class="@GetSortIcon("Status")"></i>
                                    </th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var obj in modalObjects)
                                {
                                    <tr class="@(editingProperty?.PropertyId == obj.PropertyId ? "d-none" : "") animate-row-in">
                                        <td class="text-primary fw-bold">#@obj.PropertyId</td>
                                        <td><div class="text-truncate" style="max-width: 300px; font-size: 0.9rem;">@obj.Address</div></td>
                                        <td class="fw-bold">@obj.Price?.ToString("N0") ₽</td>
                                        <td>
                                            <span class="status-badge @(obj.StatusName == "Available" ? "status-available" : "status-sold")">
                                                @(obj.StatusName == "Available" ? "ДОСТУПНО" : "ПРОДАНО")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn-icon btn-edit" @onclick="() => StartEdit(obj)" title="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn-icon btn-delete" @onclick="() => DeleteProperty(obj)" title="Удалить">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    @if (editingProperty?.PropertyId == obj.PropertyId)
                                    {
                                        <tr class="animate-slide-down">
                                            <td colspan="5" class="edit-panel">
                                                <div class="edit-content">
                                                    <h5 class="edit-title mb-4">
                                                        <i class="fas fa-pen-nib me-2 text-primary"></i> 
                                                        Редактирование объекта #@obj.PropertyId
                                                    </h5>
                                                    <EditForm Model="editModel" OnValidSubmit="SaveEdit">
                                                        <div class="edit-grid">
                                                            <div class="edit-field full">
                                                                <label>Название объекта</label>
                                                                <InputText @bind-Value="editModel.Title" class="form-input" placeholder="Введите название" />
                                                            </div>
                                                            <div class="edit-field full">
                                                                <label>Адрес объекта</label>
                                                                <InputText @bind-Value="editModel.Address" class="form-input" placeholder="Введите адрес" />
                                                            </div>
                                                            <div class="edit-field">
                                                                <label>Стоимость (₽)</label>
                                                                <InputNumber @bind-Value="editModel.Price" class="form-input" placeholder="0" />
                                                            </div>
                                                            <div class="edit-field">
                                                                <label>Комнат</label>
                                                                <InputNumber @bind-Value="editModel.Rooms" class="form-input" />
                                                            </div>
                                                            <div class="edit-field">
                                                                <label>Ванных</label>
                                                                <InputNumber @bind-Value="editModel.Bathrooms" class="form-input" />
                                                            </div>
                                                            <div class="edit-field">
                                                                <label>Площадь (м²)</label>
                                                                <InputNumber @bind-Value="editModel.TotalArea" class="form-input" />
                                                            </div>
                                                            <div class="edit-field">
                                                                <label>Этаж</label>
                                                                <InputNumber @bind-Value="editModel.Floor" class="form-input" />
                                                            </div>
                                                            <div class="edit-field full">
                                                                <label>Описание</label>
                                                                <InputTextArea @bind-Value="editModel.Description" class="form-input textarea" rows="2" placeholder="Описание объекта..." />
                                                            </div>
                                                        </div>
                                                        <div class="edit-actions">
                                                            <button type="button" class="btn-cancel" @onclick="CancelEdit">
                                                                <i class="fas fa-times me-1"></i> Отмена
                                                            </button>
                                                            <button type="submit" class="btn-save">
                                                                <i class="fas fa-check me-1"></i> Сохранить
                                                            </button>
                                                        </div>
                                                    </EditForm>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state animate-fade-in">
                        <i class="fas fa-folder-open"></i>
                        <p>Нет объектов для отображения</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showRealtorModal)
{
    <div class="modal-backdrop animate-fade-in" @onclick="CloseModals">
        <div class="modal-card modal-card-large animate-modal-in" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <span class="modal-subtitle text-uppercase">Аналитика агента</span>
                    <h3>@currentRealtorName</h3>
                </div>
                <button class="close-btn" @onclick="CloseModals">×</button>
            </div>
            <div class="modal-body">
                @if (realtorDeals != null && realtorDeals.Any())
                {
                    <div class="table-responsive">
                        <table class="premium-table">
                            <thead>
                                <tr>
                                    <th @onclick='() => SortList(realtorDeals, "DealId", x => x.DealId)' style="cursor:pointer;">
                                        ID <i class="@GetSortIcon("DealId")"></i>
                                    </th>
                                    <th @onclick='() => SortList(realtorDeals, "Property", x => x.PropertyAddress)' style="cursor:pointer;">
                                        Объект <i class="@GetSortIcon("Property")"></i>
                                    </th>
                                    <th @onclick='() => SortList(realtorDeals, "Amount", x => x.Amount)' style="cursor:pointer;">
                                        Сумма <i class="@GetSortIcon("Amount")"></i>
                                    </th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deal in realtorDeals)
                                {
                                    <tr class="animate-row-in">
                                        <td class="text-primary fw-bold">#@deal.DealId</td>
                                        <td><div class="text-truncate" style="max-width: 300px; font-size: 0.85rem;">@deal.PropertyAddress</div></td>
                                        <td class="fw-bold">@deal.Amount?.ToString("N0") ₽</td>
                                        <td>
                                            <span class="status-badge status-completed">ВЫПОЛНЕНО</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state animate-fade-in">
                        <i class="fas fa-chart-bar"></i>
                        <p>У данного риелтора нет активных сделок</p>
                    </div>
                }
            </div>
        </div>
    </div>
}



@code {
    private ReportData? report;
    private bool showObjectsModal = false;
    private string modalTitle = "";
    private List<PropertyItem>? modalObjects;
    private bool showRealtorModal = false;
    private string currentRealtorName = "";
    private List<RealtorDealInfo>? realtorDeals;

    // Флаг для однократной отрисовки графиков
    private bool chartsRendered = false;

    // Переменные для редактирования
    private PropertyItem? editingProperty;
    private EditPropertyModel editModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Delay(500);
            report = await Http.GetFromJsonAsync<ReportData>("reports");
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Проверяем, что report не null, и мы ещё не отрисовывали графики
        if (report != null && !chartsRendered)  
        {
            chartsRendered = true; // Сразу ставим флаг, чтобы не дублировать логику
            await Task.Delay(100);
            
            var labels = report.MonthlyRevenue.Select(x => x.Period).ToArray();
            var revenueData = report.MonthlyRevenue.Select(x => (double)x.TotalAmount).ToArray();
            var transactionData = report.MonthlyRevenue.Select(x => x.Count).ToArray();
            
            var canvasExists = await JS.InvokeAsync<bool>("eval", "document.getElementById('revenueChart') !== null");
            if (canvasExists)
            {
                await JS.InvokeVoidAsync("setupDoubleCharts", labels, revenueData, transactionData);
            }
        }
    }

    private void ShowObjectsModal(string? statusFilter)
    {
        if (report == null || report.Properties?.List == null) return;

        modalObjects = statusFilter switch
        {
            "Available" => report.Properties.List.Where(p => p.StatusName == "Available").ToList(),
            "Sold" => report.Properties.List.Where(p => p.StatusName == "Sold" || p.StatusName == "Rented").ToList(),
            _ => report.Properties.List.ToList()
        };

        modalTitle = statusFilter switch
        {
            "Available" => "Доступные объекты",
            "Sold" => "Проданные/Сданные объекты",
            _ => "Все объекты"
        };

        editingProperty = null;
        showObjectsModal = true;
    }

    private async Task ShowRealtorDeals(string realtorName)
    {
        currentRealtorName = realtorName;
        realtorDeals = null;
        showRealtorModal = true;
        StateHasChanged();
        try
        {
            realtorDeals = await Http.GetFromJsonAsync<List<RealtorDealInfo>>($"reports/realtor/{Uri.EscapeDataString(realtorName)}");
            StateHasChanged();
        }
        catch
        {
            realtorDeals = new();
            StateHasChanged();
        }
    }

    private void CloseModals()
    {
        showObjectsModal = false;
        showRealtorModal = false;
        editingProperty = null;
    }

    private void StartEdit(PropertyItem item)
    {
        editingProperty = item;
        editModel = new EditPropertyModel
        {
            Title = item.Title,
            Address = item.Address,
            Price = item.Price,
            Rooms = item.Rooms,
            Bathrooms = item.Bathrooms,
            TotalArea = item.TotalArea,
            LivingArea = null,
            Floor = null,
            Description = null
        };
    }

    private void CancelEdit() => editingProperty = null;

    private async Task SaveEdit()
    {
        if (editingProperty == null) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"properties/{editingProperty.PropertyId}", editModel);

            if (response.IsSuccessStatusCode)
            {
                var updated = await Http.GetFromJsonAsync<PropertyItem>($"properties/{editingProperty.PropertyId}");

                if (updated != null && modalObjects != null)
                {
                    var index = modalObjects.FindIndex(o => o.PropertyId == editingProperty.PropertyId);
                    if (index >= 0) modalObjects[index] = updated;
                }
                CancelEdit();
            }
        }
        catch { }
    }

    private async Task DeleteProperty(PropertyItem item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить объект #{item.PropertyId}?");

        if (!confirmed) return;
        try
        {
            var response = await Http.DeleteAsync($"properties/{item.PropertyId}");

            if (response.IsSuccessStatusCode)
            {
                modalObjects?.RemoveAll(o => o.PropertyId == item.PropertyId);
                report = await Http.GetFromJsonAsync<ReportData>("reports");
                StateHasChanged();
            }
        }
        catch { }
    }

    private string activeSortColumn = "";
    private bool isAscending = true;

    private void SortList<T>(List<T>? list, string column, Func<T, object?> selector)
    {
        if (list == null || !list.Any()) return;

        if (activeSortColumn == column) isAscending = !isAscending;
        else { activeSortColumn = column; isAscending = true; }
        var sorted = isAscending ? list.OrderBy(selector).ToList() : list.OrderByDescending(selector).ToList();

        if (typeof(T) == typeof(PropertyItem) && modalObjects != null) modalObjects = sorted.Cast<PropertyItem>().ToList();
        else if (typeof(T) == typeof(RealtorDealInfo) && realtorDeals != null) realtorDeals = sorted.Cast<RealtorDealInfo>().ToList();
        StateHasChanged();
    }

    private string GetSortIcon(string column)
    {
        if (activeSortColumn != column) return "fas fa-sort ms-1 opacity-50";
        return isAscending ? "fas fa-sort-up ms-1 text-primary" : "fas fa-sort-down ms-1 text-primary";
    }
    
    // === МОДЕЛИ ===
    public class ReportData
    {
        public PropertiesReport Properties { get; set; } = new();
        public List<MonthlyRevenue> MonthlyRevenue { get; set; } = new();
        public RealtorsReport Realtors { get; set; } = new();
    }
    
    public class PropertiesReport 
    { 
        public int Total { get; set; } 
        public int Available { get; set; } 
        public int Sold { get; set; } 
        public int Rented { get; set; } 
        public List<PropertyItem> List { get; set; } = new();
    }
    
    public class PropertyItem 
    { 
        public int PropertyId { get; set; } 
        public string Title { get; set; } = "";
        public string Address { get; set; } = "";
        public string StatusName { get; set; } = ""; 
        public decimal? Price { get; set; } 
        public int? Rooms { get; set; } 
        public int? Bathrooms { get; set; }
        public decimal? TotalArea { get; set; } 
    }
    
    public class MonthlyRevenue 
    { 
        public string Period { get; set; } = ""; 
        public decimal TotalAmount { get; set; } 
        public int Count { get; set; } 
    }
    
    public class RealtorsReport 
    { 
        public List<RealtorStat> List { get; set; } = new(); 
    }
    
    public class RealtorStat 
    { 
        public string RealtorName { get; set; } = ""; 
        public int DealsCount { get; set; } 
        public decimal TotalAmount { get; set; } 
    }
    
    public class RealtorDealInfo 
    { 
        public int DealId { get; set; } 
        public string PropertyAddress { get; set; } = "";
        public string BuyerName { get; set; } = ""; 
        public decimal? Amount { get; set; } 
        public string StatusName { get; set; } = "";
    }

    public class EditPropertyModel
    {
        public string? Title { get; set; }
        public string? Address { get; set; }
        public decimal? Price { get; set; }
        public int? Rooms { get; set; }
        public int? Bathrooms { get; set; }
        public decimal? TotalArea { get; set; }
        public decimal? LivingArea { get; set; }
        public int? Floor { get; set; }
        public int? TotalFloors { get; set; }
        public int? PropertyTypeId { get; set; }
        public int? WallMaterialId { get; set; }
        public string? Description { get; set; }
    }
}