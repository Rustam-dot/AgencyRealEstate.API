@page "/reports"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager")]
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="reports-dashboard">
    <div class="dashboard-header mb-4">
        <div class="header-text">
            <h1>Отчёты и аналитика</h1>
            <p>Обзор эффективности бизнеса</p>
        </div>
    </div>

    @if (report == null)
    {
        <div class="loader-container">
            <div class="premium-spinner"></div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3" @onclick="() => ShowObjectsModal(null)" style="cursor:pointer;">
                <div class="stat-card-v2">
                    <div class="card-icon-box"><i class="fas fa-building"></i></div>
                    <div class="card-info">
                        <span class="v-number">@report.Properties.Total</span>
                        <span class="v-label">Всего объектов</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3" @onclick='() => ShowObjectsModal("Available")' style="cursor:pointer;">
                <div class="stat-card-v2">
                    <div class="card-icon-box gold-icon"><i class="fas fa-check-circle"></i></div>
                    <div class="card-info">
                        <span class="v-number">@report.Properties.Available</span>
                        <span class="v-label">Доступно</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3" @onclick='() => ShowObjectsModal("Sold")' style="cursor:pointer;">
                <div class="stat-card-v2">
                    <div class="card-icon-box"><i class="fas fa-chart-line"></i></div>
                    <div class="card-info">
                        <span class="v-number">@report.Properties.Sold</span>
                        <span class="v-label">Продано</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card-v2">
                    <div class="card-icon-box gold-icon"><i class="fas fa-dollar-sign"></i></div>
                    <div class="card-info">
                        <span class="v-number">@(report.MonthlyRevenue.LastOrDefault()?.TotalAmount.ToString("N0") ?? "0") ₽</span>
                        <span class="v-label">Общая выручка</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="chart-glass-card">
                    <div class="chart-header">
                        <i class="fas fa-dollar-sign text-gold me-2"></i> Выручка по месяцам
                    </div>
                    <div class="canvas-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="chart-glass-card">
                    <div class="chart-header">
                        <i class="fas fa-exchange-alt text-gold me-2"></i> Количество сделок
                    </div>
                    <div class="canvas-container">
                        <canvas id="transactionsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="top-performers-section">
            <div class="section-title">
                <i class="fas fa-award text-gold me-2"></i> Лучшие риелторы
            </div>
            <div class="performers-list">
                @foreach (var r in report.Realtors.List)
                {
                    <div class="performer-horizontal-item" @onclick='() => ShowRealtorDeals(r.RealtorName)' style="cursor:pointer;">
                        <div class="rank-badge">@(report.Realtors.List.IndexOf(r) + 1)</div>
                        <div class="p-avatar">@r.RealtorName[0]</div>
                        <div class="p-details">
                            <span class="p-name">@r.RealtorName</span>
                            <span class="p-sub">@r.DealsCount сделок</span>
                        </div>
                        <div class="p-revenue">
                            <span class="p-amount">@r.TotalAmount.ToString("N0") ₽</span>
                            <span class="p-sub">доход</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showObjectsModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="fas fa-list me-2"></i> @modalTitle</h3>
                <button class="close-btn" @onclick="CloseModals">×</button>
            </div>
            <div class="modal-body">
                @if (modalObjects != null && modalObjects.Any())
                {
                    <table class="premium-table">
                       <thead>
    <tr>
        <th @onclick='() => SortList(modalObjects, "Id", x => x.PropertyId)' style="cursor:pointer;">
            ID <i class="@GetSortIcon("Id")"></i>
        </th>
        <th @onclick='() => SortList(modalObjects, "Address", x => x.Address)' style="cursor:pointer;">
            Адрес <i class="@GetSortIcon("Address")"></i>
        </th>
        <th @onclick='() => SortList(modalObjects, "Price", x => x.Price)' style="cursor:pointer;">
            Цена <i class="@GetSortIcon("Price")"></i>
        </th>
        <th @onclick='() => SortList(modalObjects, "Status", x => x.StatusName)' style="cursor:pointer;">
            Статус <i class="@GetSortIcon("Status")"></i>
        </th>
        <th class="text-end">Действия</th>
    </tr>
</thead>
                        <tbody>
                            @foreach (var obj in modalObjects)
                            {
                                <tr class="@(editingProperty?.PropertyId == obj.PropertyId ? "d-none" : "")">
                                    <td style="color: var(--premium-gold); font-weight: bold;">#@obj.PropertyId</td>
                                    <td><div style="max-width: 300px; font-size: 0.9rem;">@obj.Address</div></td>
                                    <td class="fw-bold">@obj.Price?.ToString("N0") ₽</td>
                                    <td>
                                        <span class="status-badge @(obj.StatusName == "Available" ? "status-available" : "status-sold")">
                                            @(obj.StatusName == "Available" ? "ДОСТУПНО" : "ПРОДАНО")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-warning me-2" style="border-radius: 8px;" @onclick="() => StartEdit(obj)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" @onclick="() => DeleteProperty(obj)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                @if (editingProperty?.PropertyId == obj.PropertyId)
                                {
                                    <tr>
                                        <td colspan="5" class="edit-panel">
                                            <div class="p-2">
                                                <h5 class="mb-4 text-white"><i class="fas fa-pen-nib me-2 text-gold"></i> Редактирование объекта</h5>
                                                <EditForm Model="editModel" OnValidSubmit="SaveEdit">
                                                    <div class="row g-3">
                                                        <div class="col-md-8">
                                                            <label class="v-label mb-1">Адрес объекта</label>
                                                            <InputText @bind-Value="editModel.Address" class="form-control premium-input" />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="v-label mb-1">Стоимость (₽)</label>
                                                            <InputNumber @bind-Value="editModel.Price" class="form-control premium-input" />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="v-label mb-1">Комнат</label>
                                                            <InputNumber @bind-Value="editModel.Rooms" class="form-control premium-input" />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="v-label mb-1">Общая площадь</label>
                                                            <InputNumber @bind-Value="editModel.TotalArea" class="form-control premium-input" />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="v-label mb-1">Этаж</label>
                                                            <InputNumber @bind-Value="editModel.Floor" class="form-control premium-input" />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="v-label mb-1">Описание</label>
                                                            <InputTextArea @bind-Value="editModel.Description" class="form-control premium-input" rows="2" />
                                                        </div>
                                                        <div class="col-md-12 text-end mt-4">
                                                            <button type="button" class="btn btn-link text-dim me-3 text-decoration-none" @onclick="CancelEdit">Отмена</button>
                                                            <button type="submit" class="btn btn-save">Сохранить изменения</button>
                                                        </div>
                                                    </div>
                                                </EditForm>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5 text-dim">
                        <i class="fas fa-folder-open fa-3x mb-3"></i>
                        <p>Нет объектов для отображения.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showRealtorModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-card" style="max-width: 800px;">
            <div class="modal-header">
                <div>
                    <span class="v-label text-uppercase" style="letter-spacing: 2px;">Аналитика агента</span>
                    <h3>@currentRealtorName</h3>
                </div>
                <button class="close-btn" @onclick="CloseModals">×</button>
            </div>
            <div class="modal-body">
                @if (realtorDeals != null && realtorDeals.Any())
                {
                    <table class="premium-table">
                  <thead>
    <tr>
        <th @onclick='() => SortList(realtorDeals, "DealId", x => x.DealId)' style="cursor:pointer;">
            ID <i class="@GetSortIcon("DealId")"></i>
        </th>
        <th @onclick='() => SortList(realtorDeals, "Property", x => x.PropertyAddress)' style="cursor:pointer;">
            Объект <i class="@GetSortIcon("Property")"></i>
        </th>
        <th @onclick='() => SortList(realtorDeals, "Amount", x => x.Amount)' style="cursor:pointer;">
            Сумма <i class="@GetSortIcon("Amount")"></i>
        </th>
        <th>Статус</th>
    </tr>
</thead>
                        <tbody>
                            @foreach (var deal in realtorDeals)
                            {
                                <tr>
                                    <td class="text-gold fw-bold">#@deal.DealId</td>
                                    <td><div style="font-size: 0.85rem; color: #eee;">@deal.PropertyAddress</div></td>
                                    <td class="fw-bold text-white">@deal.Amount?.ToString("N0") ₽</td>
                                    <td>
                                        <span class="status-badge status-available">ВЫПОЛНЕНО</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-center py-4 text-dim">У данного риелтора нет активных сделок.</p>
                }
            </div>
        </div>
    </div>
}

<style>
    :root {
        --premium-gold: #f39c12;
        --dark-surface: #121212;
        --glass-panel: rgba(255, 255, 255, 0.03);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-dim: #888;
    }

    .reports-dashboard {
        padding: 120px 30px 30px 30px;
        background: #080808;
        min-height: 100vh;
        color: white;
    }

    .dashboard-header { display: flex; align-items: center; gap: 20px; }
    .header-text h1 { font-size: 1.8rem; font-weight: 700; margin: 0; }
    .header-text p { color: var(--text-dim); margin: 0; font-size: 0.9rem; }

    .stat-card-v2 {
        background: var(--glass-panel);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 25px;
        display: flex; align-items: center; gap: 20px;
        transition: 0.3s;
    }
    .stat-card-v2:hover { border-color: var(--premium-gold); transform: translateY(-5px); }
    .card-icon-box {
        width: 55px; height: 55px;
        background: rgba(255,255,255,0.05);
        border-radius: 15px;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.4rem;
    }
    .card-icon-box.gold-icon { background: rgba(243, 156, 18, 0.15); color: var(--premium-gold); }
    .v-number { display: block; font-size: 1.6rem; font-weight: 800; }
    .v-label { color: var(--text-dim); font-size: 0.85rem; font-weight: 500; }

    .chart-glass-card {
        background: var(--glass-panel);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 25px;
        height: 100%;
    }
    .chart-header { font-weight: 700; margin-bottom: 20px; font-size: 1.1rem; }
    .canvas-container { position: relative; height: 300px; }

    .section-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 20px; }
    .performers-list {
        background: var(--glass-panel);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 10px;
    }
    .performer-horizontal-item {
        display: flex; align-items: center; gap: 20px;
        padding: 15px 25px;
        border-bottom: 1px solid var(--glass-border);
    }
    .performer-horizontal-item:last-child { border: none; }
    .rank-badge { width: 30px; height: 30px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: var(--premium-gold); font-weight: bold; }
    .p-avatar { width: 45px; height: 45px; background: var(--premium-gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white; }
    .p-details { flex-grow: 1; display: flex; flex-direction: column; }
    .p-name { font-weight: 700; font-size: 1rem; }
    .p-sub { color: var(--text-dim); font-size: 0.8rem; }
    .p-revenue { text-align: right; }
    .p-amount { display: block; color: var(--premium-gold); font-weight: 800; font-size: 1.1rem; }

    .loader-container { display: flex; justify-content: center; padding: 100px; }
    .premium-spinner { width: 50px; height: 50px; border: 3px solid rgba(243,156,18,0.1); border-top-color: var(--premium-gold); border-radius: 50%; animation: spin 1s infinite linear; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Модальные окна */
   .modal-backdrop {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        animation: fadeIn 0.3s ease;
    }

    .modal-card {
        background: linear-gradient(145deg, #1a1a1a, #111);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 28px;
        width: 95%;
        max-width: 1000px;
        max-height: 85vh;
        overflow: hidden;
        box-shadow: 0 25px 80px rgba(0,0,0,0.9);
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        padding: 25px 35px;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        font-weight: 700;
        letter-spacing: -0.5px;
        color: var(--premium-gold);
        margin: 0;
    }

    .modal-body {
        padding: 30px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--premium-gold) transparent;
    }

    /* Стилизация таблицы в модалке */
    .premium-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .premium-table thead th {
        padding: 15px 20px;
        color: var(--text-dim);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        border: none;
    }

    .premium-table tbody tr {
        background: rgba(255, 255, 255, 0.03);
        transition: 0.2s;
    }

    .premium-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.07);
    }

    .premium-table td {
        padding: 18px 20px;
        border: none;
        vertical-align: middle;
    }

    .premium-table td:first-child { border-radius: 12px 0 0 12px; }
    .premium-table td:last-child { border-radius: 0 12px 12px 0; }

    .status-badge {
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        background: rgba(255,255,255,0.1);
    }
    .status-available { color: #2ecc71; background: rgba(46, 204, 113, 0.1); }
    .status-sold { color: #e74c3c; background: rgba(231, 76, 60, 0.1); }

    /* Форма редактирования внутри таблицы */
    .edit-panel {
        background: rgba(243, 156, 18, 0.03) !important;
        border: 1px solid rgba(243, 156, 18, 0.2) !important;
        border-radius: 16px !important;
        margin: 10px 0;
    }

    .premium-input {
        background: #0f0f0f !important;
        border: 1px solid #333 !important;
        color: white !important;
        border-radius: 10px !important;
        padding: 10px 15px !important;
    }

    .premium-input:focus {
        border-color: var(--premium-gold) !important;
        box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.1) !important;
    }

    .btn-save {
        background: var(--premium-gold);
        color: black;
        font-weight: 700;
        border-radius: 10px;
        padding: 8px 25px;
        border: none;
        transition: 0.3s;
    }

    .btn-save:hover {
        background: #e67e22;
        transform: translateY(-2px);
    }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

@code {
    private ReportData? report;
    private bool showObjectsModal = false;
    private string modalTitle = "";
    private List<PropertyItem>? modalObjects;
    private bool showRealtorModal = false;
    private string currentRealtorName = "";
    private List<RealtorDealInfo>? realtorDeals;

    // Переменные для редактирования
    private PropertyItem? editingProperty;
    private EditPropertyModel editModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Delay(500);
            report = await Http.GetFromJsonAsync<ReportData>("reports");
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (report != null)  
        {
            var labels = report.MonthlyRevenue.Select(x => x.Period).ToArray();
            var revenueData = report.MonthlyRevenue.Select(x => x.TotalAmount).ToArray();
            var transactionData = report.MonthlyRevenue.Select(x => x.Count).ToArray();
            await JS.InvokeVoidAsync("setupDoubleCharts", (object)labels, (object)revenueData, (object)transactionData);
        }
    }

    private void ShowObjectsModal(string statusFilter)
    {
        if (report == null) return;

        modalObjects = statusFilter switch
        {
            "Available" => report.Properties.List.Where(p => p.StatusName == "Available").ToList(),
            "Sold" => report.Properties.List.Where(p => p.StatusName == "Sold" || p.StatusName == "Rented").ToList(),
            _ => report.Properties.List
        };

        modalTitle = statusFilter switch
        {
            "Available" => "Доступные объекты",
            "Sold" => "Проданные/Сданные объекты",
            _ => "Все объекты"
        };

        editingProperty = null;
        showObjectsModal = true;
    }

    private async Task ShowRealtorDeals(string realtorName)
    {
        currentRealtorName = realtorName;
        try
        {
            realtorDeals = await Http.GetFromJsonAsync<List<RealtorDealInfo>>($"reports/realtor/{Uri.EscapeDataString(realtorName)}");
        }
        catch
        {
            realtorDeals = new();
        }
        showRealtorModal = true;
    }

    private void CloseModals()
    {
        showObjectsModal = false;
        showRealtorModal = false;
    }

    private void StartEdit(PropertyItem item)
    {
        editingProperty = item;
        editModel = new EditPropertyModel
        {
            Address = item.Address,
            Price = item.Price,
        };
    }

    private void CancelEdit()
    {
        editingProperty = null;
    }

    private async Task SaveEdit()
    {
        if (editingProperty == null) return;
        try
        {
            var response = await Http.PutAsJsonAsync($"properties/{editingProperty.PropertyId}", editModel);
            if (response.IsSuccessStatusCode)
            {
                
                var updated = await Http.GetFromJsonAsync<PropertyItem>($"properties/{editingProperty.PropertyId}");
                if (updated != null)
                {
                    var index = modalObjects.FindIndex(o => o.PropertyId == editingProperty.PropertyId);
                    if (index >= 0) modalObjects[index] = updated;
                }
                CancelEdit();
            }
        }
        catch { }
    }

    private async Task DeleteProperty(PropertyItem item)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить объект #{item.PropertyId}?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"properties/{item.PropertyId}");
            if (response.IsSuccessStatusCode)
            {
              
                modalObjects?.RemoveAll(o => o.PropertyId == item.PropertyId);
                
                report = await Http.GetFromJsonAsync<ReportData>("reports");
                StateHasChanged();
            }
        }
        catch { }
    }
    private string activeSortColumn = "";
private bool isAscending = true;

private void SortList<T>(List<T>? list, string column, Func<T, object?> selector)
{
    if (list == null || !list.Any()) return;

    if (activeSortColumn == column)
    {
        isAscending = !isAscending;
    }
    else
    {
        activeSortColumn = column;
        isAscending = true;
    }

    var sorted = isAscending 
        ? list.OrderBy(selector).ToList() 
        : list.OrderByDescending(selector).ToList();

   
    if (typeof(T) == typeof(PropertyItem)) modalObjects = sorted.Cast<PropertyItem>().ToList();
    if (typeof(T) == typeof(RealtorDealInfo)) realtorDeals = sorted.Cast<RealtorDealInfo>().ToList();
}


private string GetSortIcon(string column)
{
    if (activeSortColumn != column) return "fas fa-sort ms-1 opacity-50";
    return isAscending ? "fas fa-sort-up ms-1 text-gold" : "fas fa-sort-down ms-1 text-gold";
}
    
    public class ReportData
    {
        public PropertiesReport Properties { get; set; } = new();
        public List<MonthlyRevenue> MonthlyRevenue { get; set; } = new();
        public RealtorsReport Realtors { get; set; } = new();
    }
    public class PropertiesReport { public int Total { get; set; } public int Available { get; set; } public int Sold { get; set; } public int Rented { get; set; } public List<PropertyItem> List { get; set; } = new(); }
    public class PropertyItem { public int PropertyId { get; set; } public string Address { get; set; } = ""; public string StatusName { get; set; } = ""; public decimal? Price { get; set; } }
    public class MonthlyRevenue { public string Period { get; set; } = ""; public decimal TotalAmount { get; set; } public int Count { get; set; } }
    public class RealtorsReport { public List<RealtorStat> List { get; set; } = new(); }
    public class RealtorStat { public string RealtorName { get; set; } = ""; public int DealsCount { get; set; } public decimal TotalAmount { get; set; } }
