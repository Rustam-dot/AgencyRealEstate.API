@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="admin-container">
    <div class="admin-content">
        @* ВЕРХНЯЯ ПАНЕЛЬ *@
        <div class="admin-header">
            <div class="header-text">
                <h2 class="admin-title">Команда Elite Estates<span class="accent-dot">.</span></h2>
                <p class="admin-subtitle">Управление доступом и привилегиями сотрудников</p>
            </div>
            <button class="add-user-btn" @onclick="OpenAddModal">
                <div class="btn-icon"><i class="fas fa-user-plus"></i></div>
                <span>Новый сотрудник</span>
            </button>
        </div>

        @* СЕТКА ПОЛЬЗОВАТЕЛЕЙ *@
        @if (users == null)
        {
            <div class="loading-wrap">
                <div class="luxury-spinner"></div>
                <p>Загрузка данных...</p>
            </div>
        }
        else if (!users.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                <p>В штате пока нет сотрудников</p>
            </div>
        }
        else
        {
            <div class="users-grid">
                @foreach (var user in users)
                {
                    <div class="user-card" @onclick="() => OpenEditModal(user)">
                        <div class="role-line @user.Role.ToLower()"></div>
                        
                        <div class="user-card-body">
                            <div class="avatar-box">
                                <img src="https://ui-avatars.com/api/?name=@user.Login&background=252525&color=f39c12&bold=true" alt="Avatar" />
                                <div class="status-ring @(user.IsActive ? "active" : "blocked")"></div>
                            </div>
                            
                            <div class="info-box">
                                <h4 class="login-name">@user.Login</h4>
                                <p class="email-text">@user.Email</p>
                                
                                <div class="tags-row">
                                    <span class="badge-role @user.Role.ToLower()">@user.Role</span>
                                    <span class="badge-date"><i class="far fa-calendar-alt"></i> @user.CreatedAt.ToString("dd.MM.yyyy")</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-footer">
                            <span>ID: #@user.UserId</span>
                            <span class="edit-link">Настроить <i class="fas fa-chevron-right"></i></span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* МОДАЛЬНОЕ ОКНО (ОБЩЕЕ ДЛЯ ДОБАВЛЕНИЯ И ПРАВКИ) *@
@if (selectedUser != null || isAdding)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="luxury-modal" @onclick:stopPropagation="true">
            <div class="modal-top">
                <h3>@(isAdding ? "Регистрация специалиста" : "Параметры доступа")</h3>
                <button class="close-x" @onclick="CloseModals">&times;</button>
            </div>

            <div class="modal-main">
                @if (isAdding)
                {
                    <EditForm Model="addModel" OnValidSubmit="CreateUser">
                        <DataAnnotationsValidator />
                        <div class="elite-form">
                            <div class="input-group">
                                <label>Логин в системе</label>
                                <InputText @bind-Value="addModel.Login" class="luxury-input" placeholder="Введите логин..." />
                                <ValidationMessage For="@(() => addModel.Login)" class="val-msg" />
                            </div>

                            <div class="input-group">
                                <label>Электронная почта</label>
                                <InputText @bind-Value="addModel.Email" class="luxury-input" placeholder="email@elite.ru" />
                            </div>

                            <div class="input-group">
                                <label>Временный пароль</label>
                                <InputText @bind-Value="addModel.Password" type="password" class="luxury-input" placeholder="••••••••" />
                            </div>

                            <div class="input-group">
                                <label>Должность</label>
                                <select @bind="addModel.RoleId" class="luxury-input">
                                    <option value="" disabled selected>Выберите роль</option>
                                    <option value="1">Администратор</option>
                                    <option value="2">Менеджер</option>
                                    <option value="3">Риелтор</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-actions">
                            <button type="submit" class="save-btn">Активировать аккаунт</button>
                        </div>
                    </EditForm>
                }
                else if (selectedUser != null)
                {
                    <div class="edit-profile-layout">
                        <div class="profile-preview">
                            <div class="avatar-large">@selectedUser.Login.Substring(0, 1).ToUpper()</div>
                            <div class="profile-status">
                                <span class="status-pill @(selectedUser.IsActive ? "ok" : "warn")">
                                    @(selectedUser.IsActive ? "Доступ открыт" : "Заблокирован")
                                </span>
                            </div>
                        </div>

                        <EditForm Model="editModel" OnValidSubmit="SaveChanges">
                            <div class="elite-form">
                                <div class="input-group">
                                    <label>Обновить логин</label>
                                    <InputText @bind-Value="editModel.NewLogin" class="luxury-input" />
                                </div>
                                <div class="input-group">
                                    <label>Новый пароль (если требуется)</label>
                                    <InputText @bind-Value="editModel.NewPassword" type="password" class="luxury-input" />
                                </div>
                            </div>

                            <div class="modal-actions-between">
                                <button type="button" class="block-btn" @onclick="() => ToggleActive(selectedUser)">
                                    @(selectedUser.IsActive ? "Заблокировать" : "Разблокировать")
                                </button>
                                <button type="submit" class="save-btn">Применить</button>
                            </div>
                        </EditForm>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    :root {
        --accent: #f39c12;
        --bg: #0f0f0f;
        --card-bg: #1a1a1a;
        --text-dim: #888;
        --admin-color: #f39c12;
        --manager-color: #3498db;
        --realtor-color: #2ecc71;
    }

    .admin-container {
        background: var(--bg);
        min-height: 100vh;
        padding-top: 120px;
        color: #fff;
    }

    .admin-content { max-width: 1400px; margin: 0 auto; padding: 0 40px; }

    /* HEADER */
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 60px;
    }
    .admin-title { font-size: 2.5rem; font-weight: 800; margin: 0; }
    .accent-dot { color: var(--accent); }
    .admin-subtitle { color: var(--text-dim); margin-top: 10px; font-size: 1.1rem; }

    .add-user-btn {
        background: var(--accent);
        border: none;
        padding: 5px 25px 5px 5px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 15px;
        cursor: pointer;
        font-weight: 700;
        transition: 0.3s;
    }
    .btn-icon {
        background: rgba(0,0,0,0.15);
        width: 45px; height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .add-user-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(243, 156, 18, 0.2); }

    /* USERS GRID */
    .users-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
    }

    .user-card {
        background: var(--card-bg);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.03);
        transition: 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        cursor: pointer;
        position: relative;
    }
    .user-card:hover {
        transform: translateY(-8px);
        border-color: rgba(243, 156, 18, 0.3);
        background: #222;
    }

    .role-line { height: 4px; width: 100%; }
    .role-line.administrator { background: var(--admin-color); }
    .role-line.manager { background: var(--manager-color); }
    .role-line.realtor { background: var(--realtor-color); }

    .user-card-body { padding: 30px; display: flex; gap: 20px; }

    .avatar-box { position: relative; width: 70px; height: 70px; }
    .avatar-box img { width: 100%; border-radius: 15px; border: 2px solid #333; }
    
    .status-ring {
        position: absolute; bottom: -5px; right: -5px;
        width: 18px; height: 18px; border-radius: 50%;
        border: 3px solid var(--card-bg);
    }
    .status-ring.active { background: #2ecc71; box-shadow: 0 0 10px #2ecc71; }
    .status-ring.blocked { background: #e74c3c; }

    .login-name { margin: 0; font-size: 1.2rem; font-weight: 700; }
    .email-text { color: var(--text-dim); font-size: 0.9rem; margin: 5px 0 15px 0; }

    .tags-row { display: flex; gap: 10px; }
    .badge-role {
        padding: 4px 10px; border-radius: 6px; font-size: 0.7rem;
        font-weight: 800; text-transform: uppercase;
    }
    .badge-role.administrator { background: rgba(243, 156, 18, 0.1); color: var(--admin-color); }
    .badge-role.manager { background: rgba(52, 152, 219, 0.1); color: var(--manager-color); }
    .badge-role.realtor { background: rgba(46, 204, 113, 0.1); color: var(--realtor-color); }

    .badge-date { font-size: 0.8rem; color: #555; display: flex; align-items: center; gap: 5px; }

    .card-footer {
        background: rgba(0,0,0,0.2);
        padding: 15px 30px;
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #555;
    }
    .edit-link { color: var(--accent); font-weight: 600; }

    /* MODALS */
    .modal-backdrop {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.85); backdrop-filter: blur(10px);
        display: flex; align-items: center; justify-content: center; z-index: 10001;
    }

    .luxury-modal {
        background: #181818; width: 100%; max-width: 550px;
        border-radius: 24px; border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 40px 100px rgba(0,0,0,0.8);
        animation: slideUp 0.4s ease-out;
    }

    @@keyframes slideUp {
        from { transform: translateY(30px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .modal-top { padding: 30px; display: flex; justify-content: space-between; border-bottom: 1px solid #222; }
    .modal-top h3 { margin: 0; color: var(--accent); }
    .close-x { background: none; border: none; color: #444; font-size: 1.8rem; cursor: pointer; }

    .modal-main { padding: 30px; }

    .input-group { margin-bottom: 20px; }
    .input-group label { display: block; color: #666; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; }
    
    .luxury-input {
        width: 100%; background: #222; border: 1px solid #333;
        padding: 14px 18px; border-radius: 12px; color: #fff;
        transition: 0.3s;
    }
    .luxury-input:focus { border-color: var(--accent); outline: none; background: #282828; }

    .save-btn {
        background: var(--accent); color: #000; border: none;
        padding: 14px 40px; border-radius: 12px; font-weight: 800; cursor: pointer;
    }
    
    .block-btn {
        background: transparent; border: 1px solid #e74c3c; color: #e74c3c;
        padding: 12px 25px; border-radius: 12px; font-weight: 600; cursor: pointer;
    }

    .modal-actions-between { display: flex; justify-content: space-between; gap: 20px; margin-top: 30px; }
    
    .edit-profile-layout { display: flex; flex-direction: column; gap: 30px; }
    .profile-preview { display: flex; align-items: center; gap: 20px; }
    .avatar-large { width: 80px; height: 80px; background: var(--accent); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: #000; }
    
    .status-pill { padding: 6px 15px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; }
    .status-pill.ok { background: rgba(46, 204, 113, 0.1); color: #2ecc71; }
    .status-pill.warn { background: rgba(231, 76, 60, 0.1); color: #e74c3c; }

    .luxury-spinner {
        width: 40px; height: 40px; border: 3px solid rgba(243, 156, 18, 0.1);
        border-top-color: var(--accent); border-radius: 50%;
        animation: spin 1s linear infinite; margin: 0 auto 20px;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private List<UserDto>? users;
    private UserDto? selectedUser;
    private bool isAdding = false;
    private UpdateUserRequest editModel = new();
    private AddUserRequest addModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            // Имитация задержки для демонстрации спиннера
            await Task.Delay(500); 
            users = await Http.GetFromJsonAsync<List<UserDto>>("admin/users");
        }
        catch { users = new List<UserDto>(); }
    }

    private void OpenEditModal(UserDto user)
    {
        selectedUser = user;
        isAdding = false;
        editModel = new UpdateUserRequest { NewLogin = user.Login };
    }

    private void OpenAddModal()
    {
        isAdding = true;
        selectedUser = null;
        addModel = new AddUserRequest();
    }

    private void CloseModals()
    {
        selectedUser = null;
        isAdding = false;
    }

    private async Task SaveChanges()
    {
        if (selectedUser == null) return;
        var response = await Http.PutAsJsonAsync($"admin/users/{selectedUser.UserId}", editModel);
        if (response.IsSuccessStatusCode)
        {
            await LoadUsers();
            CloseModals();
        }
    }

    private async Task ToggleActive(UserDto user)
    {
        var request = new UpdateUserRequest { IsActive = !user.IsActive };
        await Http.PutAsJsonAsync($"admin/users/{user.UserId}", request);
        user.IsActive = !user.IsActive;
        StateHasChanged();
    }

    private async Task CreateUser()
    {
        var response = await Http.PostAsJsonAsync("admin/users", addModel);
        if (response.IsSuccessStatusCode)
        {
            await LoadUsers();
            CloseModals();
        }
    }

    public class UserDto
    {
        public int UserId { get; set; }
        public string Login { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class UpdateUserRequest
    {
        public string? NewLogin { get; set; }
        public string? NewPassword { get; set; }
        public bool? IsActive { get; set; }
    }

    public class AddUserRequest
    {
        [Required(ErrorMessage = "Логин обязателен")]
        public string Login { get; set; } = "";
        [Required(ErrorMessage = "Пароль обязателен")]
        public string Password { get; set; } = "";
        [EmailAddress]
        public string Email { get; set; } = "";
        public int? RoleId { get; set; }
    }
}