@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="admin-container">
    <div class="admin-content">
        @* HEADER SECTION *@
        <div class="admin-header">
            <div class="header-text">
                <h2 class="admin-title">Управление персоналом<span class="accent-dot">.</span></h2>
                <p class="admin-subtitle">Контроль доступа и учетных записей сотрудников агентства</p>
            </div>
            <button class="add-user-btn" @onclick="OpenAddModal">
                <i class="fas fa-plus"></i> Добавить специалиста
            </button>
        </div>

        @* USERS DISPLAY *@
        @if (users == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Синхронизация данных...</p>
            </div>
        }
        else if (!users.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                <p>Пользователи не найдены</p>
            </div>
        }
        else
        {
            <div class="users-grid">
                @foreach (var user in users)
                {
                    <div class="user-card" @onclick="() => OpenEditModal(user)">
                        <div class="card-glow"></div>
                        <div class="user-avatar-wrapper">
                            <img src="https://ui-avatars.com/api/?name=@user.Login&background=3d3d3d&color=f39c12&bold=true&size=128" alt="Avatar" />
                            <span class="status-indicator @(user.IsActive ? "online" : "offline")"></span>
                        </div>
                        <div class="user-details">
                            <h4 class="user-name">@user.Login</h4>
                            <p class="user-email">@user.Email</p>
                            <div class="user-meta">
                                <span class="role-badge @user.Role.ToLower()">@user.Role</span>
                                <span class="date-info">@user.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <div class="card-action-hint">Нажмите для редактирования</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* MODAL: ADD / EDIT *@
@if (selectedUser != null || isAdding)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-window" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isAdding ? "Новый сотрудник" : "Профиль специалиста")</h3>
                <button class="close-modal-btn" @onclick="CloseModals">&times;</button>
            </div>

            <div class="modal-body">
                @if (isAdding)
                {
                    <EditForm Model="addModel" OnValidSubmit="CreateUser">
                        <DataAnnotationsValidator />
                       @* Пример для окна "Новый сотрудник" *@
<div class="elite-form-grid">
    <div class="input-container">
        <label class="elite-label">Логин</label>
        <div class="input-wrapper">
            <i class="fas fa-user input-icon"></i>
            <InputText @bind-Value="addModel.Login" class="elite-input" placeholder="admin" />
        </div>
        <ValidationMessage For="@(() => addModel.Login)" class="error-msg" />
    </div>

    <div class="input-container">
        <label class="elite-label">Email</label>
        <div class="input-wrapper">
            <i class="fas fa-envelope input-icon"></i>
            <InputText @bind-Value="addModel.Email" class="elite-input" placeholder="example@estate.ru" />
        </div>
        <ValidationMessage For="@(() => addModel.Email)" class="error-msg" />
    </div>

    <div class="input-container">
        <label class="elite-label">Пароль</label>
        <div class="input-wrapper">
            <i class="fas fa-lock input-icon"></i>
            <InputText @bind-Value="addModel.Password" type="password" class="elite-input" placeholder="•••••" />
        </div>
    </div>

    <div class="input-container">
        <label class="elite-label">Роль в системе</label>
        <div class="input-wrapper">
            <i class="fas fa-shield-alt input-icon"></i>
            <select @bind="addModel.RoleId" class="elite-input elite-select">
                <option value="" disabled selected>Выберите роль</option>
                <option value="1">Администратор</option>
                <option value="2">Менеджер</option>
                <option value="3">Риелтор</option>
            </select>
        </div>
    </div>
</div>
                        <div class="modal-footer">
                            <button type="submit" class="btn-prime">Создать аккаунт</button>
                        </div>
                    </EditForm>
                }
                else if (selectedUser != null)
                {
                    <div class="user-profile-view">
    @* Верхняя часть: Аватар и статус *@
    <div class="profile-header-elite">
        <div class="avatar-big">
            <span>@(selectedUser.Login.Substring(0, 2).ToUpper())</span>
        </div>
        <div class="profile-main-info">
            <h4 class="profile-login">@selectedUser.Login</h4>
            <p class="profile-email">@selectedUser.Email</p>
            <div class="status-badge-container">
                <span class="status-dot @(selectedUser.IsActive ? "active" : "inactive")"></span>
                <span class="status-text">@(selectedUser.IsActive ? "Доступ разрешен" : "Доступ ограничен")</span>
            </div>
        </div>
    </div>

    @* Форма редактирования *@
    <EditForm Model="editModel" OnValidSubmit="SaveChanges">
        <div class="elite-form-vertical">
            <div class="input-container">
                <label class="elite-label">Изменить логин</label>
                <div class="input-wrapper">
                    <i class="fas fa-user-edit input-icon"></i>
                    <InputText @bind-Value="editModel.NewLogin" class="elite-input" placeholder="Введите новый логин" />
                </div>
            </div>

            <div class="input-container">
                <label class="elite-label">Новый пароль (оставьте пустым, если не меняете)</label>
                <div class="input-wrapper">
                    <i class="fas fa-key input-icon"></i>
                    <InputText @bind-Value="editModel.NewPassword" type="password" class="elite-input" placeholder="••••••••" />
                </div>
            </div>
        </div>

        <div class="modal-divider"></div>

        @* Кнопки действий *@
        <div class="modal-footer-elite">
            <button type="button" class="btn-block-elite" @onclick="() => ToggleActive(selectedUser)">
                @(selectedUser.IsActive ? "Заблокировать" : "Разблокировать")
            </button>
            <button type="submit" class="btn-save-elite">Сохранить изменения</button>
        </div>
    </EditForm>
</div>
                }
            </div>
        </div>
    </div>
}

<style>
    /* ОБЩИЙ КОНТЕЙНЕР */
    .admin-container {
        background: #121212;
        min-height: 100vh;
        color: #fff;
        padding-top: 100px; /* Отступ под фиксированный NavMenu */
        font-family: 'Inter', sans-serif;
    }

    .admin-content {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 30px;
    }

    /* HEADER */
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 50px;
    }

    .admin-title { font-size: 2.2rem; font-weight: 800; margin: 0; }
    .accent-dot { color: #f39c12; }
    .admin-subtitle { color: #888; margin: 5px 0 0 0; font-size: 1.1rem; }

    .add-user-btn {
        background: #f39c12;
        color: #000;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(243, 156, 18, 0.2);
    }

    .add-user-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(243, 156, 18, 0.3);
        background: #ffac2f;
    }

    /* GRID & CARDS */
    .users-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        padding-bottom: 50px;
    }

    .user-card {
        background: #1e1e1e;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 30px;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .user-card:hover {
        transform: translateY(-10px);
        border-color: rgba(243, 156, 18, 0.4);
        background: #252525;
    }

    .card-glow {
        position: absolute;
        top: 0; right: 0;
        width: 100px; height: 100px;
        background: radial-gradient(circle, rgba(243, 156, 18, 0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .user-avatar-wrapper {
        position: relative;
        width: 80px;
        height: 80px;
        margin-bottom: 20px;
    }

    .user-avatar-wrapper img {
        width: 100%; height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #333;
    }

    .status-indicator {
        position: absolute;
        bottom: 5px; right: 5px;
        width: 16px; height: 16px;
        border-radius: 50%;
        border: 3px solid #1e1e1e;
    }
    .status-indicator.online { background: #2ecc71; box-shadow: 0 0 10px #2ecc71; }
    .status-indicator.offline { background: #e74c3c; }

    .user-name { font-size: 1.3rem; font-weight: 700; margin-bottom: 5px; }
    .user-email { color: #777; font-size: 0.9rem; margin-bottom: 20px; }

    .user-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 15px;
    }

    .role-badge {
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.05);
        color: #bbb;
    }
    .role-badge.administrator { color: #f39c12; background: rgba(243, 156, 18, 0.1); }
    .role-badge.manager { color: #3498db; background: rgba(52, 152, 219, 0.1); }
    
    .date-info { font-size: 0.8rem; color: #555; }

    .card-action-hint {
        position: absolute;
        bottom: -30px; left: 0; width: 100%;
        background: #f39c12; color: #000;
        text-align: center; font-size: 0.75rem; font-weight: 700;
        padding: 5px 0;
        transition: bottom 0.3s;
    }
    .user-card:hover .card-action-hint { bottom: 0; }

    /* MODALS */
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 20000;
        padding: 20px;
    }

    .modal-window {
        background: #1e1e1e;
        width: 100%;
        max-width: 600px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 50px 100px rgba(0,0,0,0.5);
        overflow: hidden;
        animation: modalEntry 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes modalEntry {
        from { transform: scale(0.9) translateY(30px); opacity: 0; }
        to { transform: scale(1) translateY(0); opacity: 1; }
    }

    .modal-header {
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .modal-header h3 { margin: 0; font-size: 1.4rem; color: #f39c12; }
    .close-modal-btn { background: none; border: none; color: #555; font-size: 2rem; cursor: pointer; }

    .modal-body { padding: 30px; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    
    .input-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px; }
    .input-group label { font-size: 0.85rem; color: #888; font-weight: 600; }

    .elite-input {
        background: #2a2a2a;
        border: 1px solid #3d3d3d;
        color: #fff;
        padding: 12px 16px;
        border-radius: 10px;
        transition: all 0.3s;
    }
    .elite-input:focus { border-color: #f39c12; outline: none; box-shadow: 0 0 0 3px rgba(243, 156, 18, 0.1); }

    .modal-footer {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        justify-content: flex-end;
    }

    .btn-prime {
        background: #f39c12; color: #000; font-weight: 700;
        padding: 12px 30px; border-radius: 10px; border: none; cursor: pointer;
    }

    .btn-outline {
        background: transparent; border: 1px solid #e74c3c; color: #e74c3c;
        padding: 12px 25px; border-radius: 10px; font-weight: 600; cursor: pointer;
    }

    .btn-outline:hover { background: #e74c3c; color: #fff; }

    /* LOADING SPINNER */
    .loading-state { text-align: center; padding: 100px 0; }
    .spinner {
        width: 50px; height: 50px; border: 3px solid rgba(243, 156, 18, 0.1);
        border-top-color: #f39c12; border-radius: 50%;
        animation: spin 1s linear infinite; margin: 0 auto 20px;
    }
    .profile-header-elite {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
}
.avatar-big {
    width: 100px;
    height: 100px;
    background: #f39c12;
    border-radius: 4px; /* Квадратный со скруглением как на фото */
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
}
.profile-login { font-size: 1.8rem; margin: 0; color: #fff; }
.profile-email { color: #888; margin: 5px 0; }
.status-badge-container {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
}

.status-text {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
}

/* ФОРМА (Вертикальная) */
.elite-form-vertical {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ИСПРАВЛЕНИЕ: Отступы для текста, чтобы не было наслоения на иконки */
.input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.input-icon {
    position: absolute;
    left: 16px;
    color: #555;
    z-index: 2;
}

.elite-input {
    width: 100%;
    background: #242424;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 14px 16px 14px 45px; /* 45px слева дают место для иконки */
    color: #fff;
    transition: all 0.3s;
}

.elite-input:focus {
    border-color: #f39c12;
    background: #2a2a2a;
    outline: none;
}

/* Футер и кнопки */
.modal-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 25px 0;
}

.modal-footer-elite {
    display: flex;
    justify-content: space-between;
    gap: 15px;
}

.btn-save-elite {
    background: #f39c12;
    color: #000;
    border: none;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
    flex-grow: 1;
}

.btn-block-elite {
    background: transparent;
    border: 1px solid #e74c3c;
    color: #e74c3c;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-block-elite:hover {
    background: rgba(231, 76, 60, 0.1);
}
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private List<UserDto>? users;
    private UserDto? selectedUser;
    private bool isEditing = false;
    private bool isAdding = false;
    private UpdateUserRequest editModel = new();
    private AddUserRequest addModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await Http.GetFromJsonAsync<List<UserDto>>("admin/users");
        }
        catch { users = new List<UserDto>(); }
    }

    private void OpenEditModal(UserDto user)
    {
        selectedUser = user;
        isAdding = false;
        editModel = new UpdateUserRequest { NewLogin = user.Login };
    }

    private void OpenAddModal()
    {
        isAdding = true;
        selectedUser = null;
        addModel = new AddUserRequest();
    }

    private void CloseModals()
    {
        selectedUser = null;
        isAdding = false;
    }

    private async Task SaveChanges()
    {
        if (selectedUser == null) return;
        try
        {
            var response = await Http.PutAsJsonAsync($"admin/users/{selectedUser.UserId}", editModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
                CloseModals();
            }
        }
        catch { }
    }

    private async Task ToggleActive(UserDto user)
    {
        var request = new UpdateUserRequest { IsActive = !user.IsActive };
        await Http.PutAsJsonAsync($"admin/users/{user.UserId}", request);
        user.IsActive = !user.IsActive;
        StateHasChanged();
    }

    private async Task CreateUser()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("admin/users", addModel);
            if (response.IsSuccessStatusCode)
            {
                await LoadUsers();
                CloseModals();
            }
        }
        catch { }
    }

    // DTO CLASSES
    public class UserDto
    {
        public int UserId { get; set; }
        public string Login { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class UpdateUserRequest
    {
        public string? NewLogin { get; set; }
        public string? NewPassword { get; set; }
        public bool? IsActive { get; set; }
    }

    public class AddUserRequest
    {
        [Required] public string Login { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        [Required, EmailAddress] public string Email { get; set; } = "";
        public int? RoleId { get; set; }
    }
}