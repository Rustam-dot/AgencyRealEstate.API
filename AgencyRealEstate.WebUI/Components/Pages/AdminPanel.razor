@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="elite-admin-layout">
    @* Фоновое свечение для объема *@
    <div class="ambient-glow"></div>

    <div class="admin-wrapper">
        <header class="elite-header">
            <div class="header-text">
                <h2 class="elite-title">Команда Elite Estates<span class="gold-dot">.</span></h2>
                <p class="elite-subtitle">Контроль доступа и управление привилегиями сотрудников</p>
            </div>
            <button class="btn-gold-main" @onclick="OpenAddModal">
                <i class="fas fa-plus"></i>
                <span>Новый сотрудник</span>
            </button>
        </header>

        @if (users == null)
        {
            <div class="luxe-loader">
                <div class="spinner"></div>
                <span>Загрузка базы данных...</span>
            </div>
        }
        else
        {
            <div class="staff-grid">
                @foreach (var user in users)
                {
                    <div class="staff-card" @onclick="() => OpenEditModal(user)">
                        <div class="status-line @user.Role.ToLower()"></div>
                        <div class="card-inner">
                            <div class="user-identity">
                                <div class="avatar-wrapper">
                                    <img src="https://ui-avatars.com/api/?name=@user.Login&background=1a1a1a&color=f39c12&bold=true" />
                                    <div class="online-indicator @(user.IsActive ? "active" : "inactive")"></div>
                                </div>
                                <div class="user-info">
                                    <h4 class="user-name">@user.Login</h4>
                                    <p class="user-email">@user.Email</p>
                                </div>
                            </div>
                            
                            <div class="meta-row">
                                <span class="role-pill @user.Role.ToLower()">@user.Role</span>
                                <span class="user-id">ID: #@user.UserId</span>
                            </div>
                        </div>
                        <div class="card-action">
                            <span>Управление доступом</span>
                            <i class="fas fa-angle-right"></i>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Единое модальное окно в стиле Luxury *@
@if (selectedUser != null || isAdding)
{
    <div class="luxe-overlay" @onclick="CloseModals">
        <div class="luxe-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(isAdding ? "Регистрация специалиста" : "Параметры доступа")</h3>
                <button class="btn-close" @onclick="CloseModals">&times;</button>
            </div>

            <div class="modal-body">
                @if (isAdding)
                {
                    <EditForm Model="addModel" OnValidSubmit="CreateUser">
                        <DataAnnotationsValidator />
                        <div class="form-container">
                            <div class="elite-group">
                                <label>Логин в системе</label>
                                <InputText @bind-Value="addModel.Login" class="elite-input" placeholder="Введите логин..." />
                                <ValidationMessage For="@(() => addModel.Login)" class="val-error" />
                            </div>
                            <div class="elite-group">
                                <label>Электронная почта</label>
                                <InputText @bind-Value="addModel.Email" class="elite-input" placeholder="example@elite.ru" />
                            </div>
                            <div class="elite-group">
                                <label>Временный пароль</label>
                                <InputText @bind-Value="addModel.Password" type="password" class="elite-input" placeholder="••••••••" />
                            </div>
                            <div class="elite-group">
                                <label>Уровень доступа</label>
                                <select @bind="addModel.RoleId" class="elite-input elite-select">
                                    <option value="" disabled selected>Выберите роль...</option>
                                    <option value="1">Администратор</option>
                                    <option value="2">Менеджер</option>
                                    <option value="3">Риелтор</option>
                                </select>
                            </div>
                            <button type="submit" class="btn-gold-submit">Активировать аккаунт</button>
                        </div>
                    </EditForm>
                }
                else if (selectedUser != null)
                {
                    <div class="profile-edit-view">
                        <div class="profile-header">
                            <div class="avatar-big">@selectedUser.Login.Substring(0, 1).ToUpper()</div>
                            <span class="status-badge @(selectedUser.IsActive ? "ok" : "blocked")">
                                @(selectedUser.IsActive ? "Доступ активен" : "Доступ ограничен")
                            </span>
                        </div>

                        <EditForm Model="editModel" OnValidSubmit="SaveChanges">
                            <div class="form-container">
                                <div class="elite-group">
                                    <label>Обновить логин</label>
                                    <InputText @bind-Value="editModel.NewLogin" class="elite-input" />
                                </div>
                                <div class="elite-group">
                                    <label>Сменить пароль</label>
                                    <InputText @bind-Value="editModel.NewPassword" type="password" class="elite-input" placeholder="Оставьте пустым, если не меняете" />
                                </div>
                                <div class="modal-footer-btns">
                                    <button type="button" class="btn-outline-danger" @onclick="() => ToggleActive(selectedUser)">
                                        @(selectedUser.IsActive ? "Заблокировать" : "Разблокировать")
                                    </button>
                                    <button type="submit" class="btn-gold-submit">Сохранить</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    :root {
        --gold: #f39c12;
        --gold-dark: #d68910;
        --bg-main: #0a0a0a;
        --bg-card: #141414;
        --bg-input: #1c1c1c;
        --text-main: #ffffff;
        --text-dim: #777777;
        --radius: 16px;
        --transition: 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    .elite-admin-layout {
        background: var(--bg-main);
        min-height: 100vh;
        color: var(--text-main);
        padding: 100px 40px 60px;
        position: relative;
        overflow: hidden;
    }

    .ambient-glow {
        position: fixed; top: -10%; right: -10%; width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(243, 156, 18, 0.05) 0%, transparent 70%);
        pointer-events: none;
    }

    .admin-wrapper { max-width: 1400px; margin: 0 auto; position: relative; z-index: 2; }

    /* HEADER */
    .elite-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 50px; }
    .elite-title { font-size: 2.8rem; font-weight: 800; margin: 0; letter-spacing: -1px; }
    .gold-dot { color: var(--gold); }
    .elite-subtitle { color: var(--text-dim); font-size: 1.1rem; margin-top: 10px; }

    .btn-gold-main {
        background: var(--gold); color: #000; border: none;
        padding: 14px 28px; border-radius: var(--radius);
        font-weight: 800; display: flex; align-items: center; gap: 12px;
        cursor: pointer; transition: var(--transition);
    }
    .btn-gold-main:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(243, 156, 18, 0.2); }

    /* GRID & CARDS */
    .staff-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 25px; }

    .staff-card {
        background: var(--bg-card); border-radius: var(--radius);
        border: 1px solid rgba(255,255,255,0.05); overflow: hidden;
        cursor: pointer; transition: var(--transition);
    }
    .staff-card:hover { transform: translateY(-5px); border-color: rgba(243, 156, 18, 0.3); background: #1a1a1a; }

    .status-line { height: 4px; width: 100%; }
    .status-line.administrator { background: var(--gold); }
    .status-line.manager { background: #3498db; }
    .status-line.realtor { background: #2ecc71; }

    .card-inner { padding: 30px; }
    .user-identity { display: flex; gap: 20px; align-items: center; margin-bottom: 25px; }
    
    .avatar-wrapper { position: relative; }
    .avatar-wrapper img { width: 64px; height: 64px; border-radius: 14px; border: 1px solid #333; }
    .online-indicator {
        position: absolute; bottom: -4px; right: -4px; width: 16px; height: 16px;
        border-radius: 50%; border: 3px solid var(--bg-card);
    }
    .online-indicator.active { background: #2ecc71; box-shadow: 0 0 10px #2ecc71; }
    .online-indicator.inactive { background: #e74c3c; }

    .user-name { margin: 0; font-size: 1.3rem; font-weight: 700; }
    .user-email { color: var(--text-dim); font-size: 0.9rem; margin-top: 4px; }

    .meta-row { display: flex; justify-content: space-between; align-items: center; }
    .role-pill {
        padding: 5px 12px; border-radius: 8px; font-size: 0.7rem; font-weight: 800;
        text-transform: uppercase; background: rgba(255,255,255,0.05);
    }
    .role-pill.administrator { color: var(--gold); }
    .user-id { color: #444; font-size: 0.8rem; font-family: monospace; }

    .card-action {
        background: rgba(0,0,0,0.2); padding: 15px 30px;
        display: flex; justify-content: space-between; color: var(--gold);
        font-weight: 700; font-size: 0.85rem; border-top: 1px solid rgba(255,255,255,0.02);
    }

    /* MODAL */
    .luxe-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);
        display: flex; align-items: center; justify-content: center; z-index: 1000;
    }

    .luxe-modal {
        background: var(--bg-card); width: 100%; max-width: 500px;
        border-radius: 24px; border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 30px 60px rgba(0,0,0,0.5); animation: modalIn 0.4s ease-out;
    }

    @@keyframes modalIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .modal-header { padding: 30px; border-bottom: 1px solid #222; display: flex; justify-content: space-between; align-items: center; }
    .modal-header h3 { margin: 0; color: var(--gold); font-size: 1.5rem; }
    .btn-close { background: none; border: none; color: #555; font-size: 2rem; cursor: pointer; }

    .modal-body { padding: 30px; }

    .elite-group { margin-bottom: 20px; }
    .elite-group label { display: block; color: var(--text-dim); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px; }
    
    .elite-input {
        width: 100%; background: var(--bg-input); border: 1px solid #333;
        padding: 14px 20px; border-radius: var(--radius); color: #fff;
        font-size: 1rem; transition: var(--transition);
    }
    .elite-input:focus { border-color: var(--gold); outline: none; box-shadow: 0 0 15px rgba(243, 156, 18, 0.1); }
    
    .elite-select { appearance: none; cursor: pointer; }

    .btn-gold-submit {
        width: 100%; background: var(--gold); border: none; padding: 16px;
        border-radius: var(--radius); font-weight: 800; cursor: pointer; margin-top: 10px;
    }

    .modal-footer-btns { display: flex; justify-content: space-between; gap: 15px; margin-top: 25px; }
    .btn-outline-danger {
        background: transparent; border: 1px solid #e74c3c; color: #e74c3c;
        padding: 12px 25px; border-radius: var(--radius); font-weight: 700; cursor: pointer;
    }

    .profile-header { display: flex; flex-direction: column; align-items: center; gap: 15px; margin-bottom: 30px; }
    .avatar-big { width: 80px; height: 80px; background: var(--gold); color: #000; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 900; }
    .status-badge { padding: 6px 16px; border-radius: 50px; font-size: 0.8rem; font-weight: 700; }
    .status-badge.ok { background: rgba(46, 204, 113, 0.1); color: #2ecc71; }
    .status-badge.blocked { background: rgba(231, 76, 60, 0.1); color: #e74c3c; }

    .spinner { width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.05); border-top-color: var(--gold); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
@code {
    private List<UserDto>? users;
    private UserDto? selectedUser;
    private bool isAdding = false;
    private UpdateUserRequest editModel = new();
    private AddUserRequest addModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
           
            await Task.Delay(500); 
            users = await Http.GetFromJsonAsync<List<UserDto>>("admin/users");
        }
        catch { users = new List<UserDto>(); }
    }

    private void OpenEditModal(UserDto user)
    {
        selectedUser = user;
        isAdding = false;
        editModel = new UpdateUserRequest { NewLogin = user.Login };
    }

    private void OpenAddModal()
    {
        isAdding = true;
        selectedUser = null;
        addModel = new AddUserRequest();
    }

    private void CloseModals()
    {
        selectedUser = null;
        isAdding = false;
    }

    private async Task SaveChanges()
    {
        if (selectedUser == null) return;
        var response = await Http.PutAsJsonAsync($"admin/users/{selectedUser.UserId}", editModel);
        if (response.IsSuccessStatusCode)
        {
            await LoadUsers();
            CloseModals();
        }
    }

    private async Task ToggleActive(UserDto user)
    {
        var request = new UpdateUserRequest { IsActive = !user.IsActive };
        await Http.PutAsJsonAsync($"admin/users/{user.UserId}", request);
        user.IsActive = !user.IsActive;
        StateHasChanged();
    }

    private async Task CreateUser()
    {
        var response = await Http.PostAsJsonAsync("admin/users", addModel);
        if (response.IsSuccessStatusCode)
        {
            await LoadUsers();
            CloseModals();
        }
    }

    public class UserDto
    {
        public int UserId { get; set; }
        public string Login { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class UpdateUserRequest
    {
        public string? NewLogin { get; set; }
        public string? NewPassword { get; set; }
        public bool? IsActive { get; set; }
    }

    public class AddUserRequest
    {
        [Required(ErrorMessage = "Логин обязателен")]
        public string Login { get; set; } = "";
        [Required(ErrorMessage = "Пароль обязателен")]
        public string Password { get; set; } = "";
        [EmailAddress]
        public string Email { get; set; } = "";
        public int? RoleId { get; set; }
    }
}