@page "/property/{Id:int}"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@inject ApiClient Api
@inject IJSRuntime JsRuntime

<div class="page-wrapper">
    @if (property == null)
    {
        <div class="loader-container">
            <div class="loader"></div>
            <p>Загрузка элитной недвижимости...</p>
        </div>
    }
    else
    {
        <div class="property-detail-header">
            <a href="/properties" class="back-link">← Вернуться в каталог</a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                @* Галерея *@
                <div class="main-gallery">
                    @if (property.PhotoUrls?.Any() == true)
                    {
                        <img src="@property.PhotoUrls.First()" class="featured-image" alt="Main Photo" />
                        <div class="thumbnails-row">
                            @foreach (var url in property.PhotoUrls.Skip(1).Take(4))
                            {
                                <img src="@url" class="thumb" alt="Thumbnail" />
                            }
                        </div>
                    }
                </div>

                @* ПРЕМИУМ БАР ЦЕНЫ (Под фото) *@
                <div class="price-action-bar mt-4">
                    <div class="price-info">
                        <span class="badge-type-alt">@property.PropertyTypeName</span>
                        <div class="price-tag-large">
                            @property.Price?.ToString("N0") <span class="currency">₽</span>
                        </div>
                    </div>
                    <div class="status-indicator">
                        <div class="pulse-dot"></div>
                        <span>@property.StatusName</span>
                    </div>
                </div>

                @* ОПИСАНИЕ И АДРЕС *@
                <div class="description-section">
                    <div class="address-context">
                        <i class="fas fa-map-marker-alt"></i>
                        <h2 class="street-title-main">@property.Address</h2>
                    </div>
                    <div class="premium-divider"></div>
                    
                    <h3 class="section-subtitle">О объекте</h3>
                    <p class="description-text">@property.Description</p>
                </div>

                @* Характеристики *@
                <div class="specs-grid">
                    <div class="spec-item">
                        <span class="spec-label">Общая площадь</span>
                        <span class="spec-value">@property.TotalArea м²</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Жилая площадь</span>
                        <span class="spec-value">@property.LivingArea м²</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Комнат</span>
                        <span class="spec-value">@property.Rooms</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Этаж</span>
                        <span class="spec-value">@property.Floor / @property.TotalFloors</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-booking">
                    <div class="booking-card shadow-lg">
                        <h4>Записаться на показ</h4>
                        <p class="text-muted small mb-4">Выберите удобное время, и наш агент свяжется с вами.</p>
                        
                        <EditForm Model="@newShowing" OnValidSubmit="SubmitShowing">
                            <DataAnnotationsValidator />
                            
                            <div class="form-group mb-3">
                                <label class="custom-label">Дата показа</label>
                                <MudDatePicker @bind-Date="newShowing.Date" 
                                               MinDate="DateTime.Today" 
                                               Rounded="true" 
                                               Variant="Variant.Filled"
                                               Color="Color.Dark"
                                               PickerVariant="PickerVariant.Dialog"
                                               Placeholder="Выберите дату"
                                               Class="elite-picker" />
                                <ValidationMessage For="@(() => newShowing.Date)" />
                            </div>

                            <div class="form-group mb-3">
                                <label class="custom-label">Время</label>
                                <MudTimePicker @bind-Time="newShowing.Time" 
                                               Rounded="true" 
                                               Variant="Variant.Filled"
                                               Color="Color.Dark"
                                               AmPm="false"
                                               PickerVariant="PickerVariant.Dialog"
                                               Placeholder="00:00"
                                               Class="elite-picker" />
                                <ValidationMessage For="@(() => newShowing.Time)" />
                            </div>

                            <div class="form-group mb-3">
                                <label class="custom-label">Ваше имя</label>
                                <InputText @bind-Value="newShowing.ClientName" class="input-solid" placeholder="Имя Фамилия" />
                                <ValidationMessage For="@(() => newShowing.ClientName)" />
                            </div>

                            <div class="form-group mb-3">
                                <label class="custom-label">Телефон</label>
                                <InputText @bind-Value="newShowing.Phone" class="input-solid" placeholder="+7 (___) ___-__-__" />
                                <ValidationMessage For="@(() => newShowing.Phone)" />
                            </div>

                            <div class="form-group mb-4">
                                <label class="custom-label">Комментарий (необязательно)</label>
                                <InputTextArea @bind-Value="newShowing.Comments" class="input-solid" rows="2" placeholder="Например: есть ли парковка?" />
                            </div>

                            <button type="submit" class="card-btn-pill w-100">
                                <i class="fas fa-calendar-check me-2"></i> Отправить заявку
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PropertyDto? property;
    private ShowingRequest newShowing = new() { Date = DateTime.Today };

    protected override async Task OnInitializedAsync()
    {
        property = await Api.GetPropertyAsync(Id);
    }

    private async Task SubmitShowing()
    {
        // Валидация времени в прошлом (если выбрана сегодняшняя дата)
        if (newShowing.Date == DateTime.Today && newShowing.Time.HasValue)
        {
            if (newShowing.Time.Value < DateTime.Now.TimeOfDay)
            {
                await JsRuntime.InvokeVoidAsync("alert", "Упс! Нельзя записаться на время, которое уже прошло. Выберите более поздний час.");
                return;
            }
        }

        var request = new CreateShowingRequest
        {
            PropertyId = Id,
            Date = newShowing.Date ?? DateTime.Today,
            Time = newShowing.Time,
            ClientName = newShowing.ClientName,
            ClientPhone = newShowing.Phone,
            Comments = newShowing.Comments
        };

        try
        {
            await Api.CreateShowingAsync(request);
            await JsRuntime.InvokeVoidAsync("alert", "Заявка успешно отправлена! Мы свяжемся с вами в ближайшее время.");
            newShowing = new ShowingRequest { Date = DateTime.Today };
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Ошибка при отправке: {ex.Message}");
        }
    }

    public class ShowingRequest
    {
        [Required(ErrorMessage = "Выберите дату")]
        public DateTime? Date { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Выберите время")]
        public TimeSpan? Time { get; set; }

        [Required(ErrorMessage = "Как вас зовут?")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Имя слишком короткое")]
        public string ClientName { get; set; } = "";

        [Required(ErrorMessage = "Укажите номер телефона")]
        [Phone(ErrorMessage = "Неверный формат телефона")]
        public string Phone { get; set; } = "";

        public string? Comments { get; set; }
    }
}