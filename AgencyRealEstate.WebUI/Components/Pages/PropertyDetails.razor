@page "/property/{Id:int}"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject IJSRuntime JsRuntime

<div class="main-container">
    <div class="page-wrapper-premium">
        @if (property == null)
        {
            <div class="loader-container">
                <div class="spinner-premium"></div>
                <p>Загружаем детали объекта...</p>
            </div>
        }
        else
        {
            <div class="container-premium">
                @* Навигация назад *@
                <div class="property-detail-header fade-in">
                    <a href="/properties" class="back-link">
                        <i class="fas fa-arrow-left"></i> Назад к списку объектов
                    </a>
                </div>

                <div class="premium-grid">
                    @* ЛЕВАЯ КОЛОНКА: Контент *@
                    <div class="content-section fade-in">
                        
                        @* Главная галерея *@
                        <div class="main-gallery-card">
                            <div class="featured-image-wrapper">
                                @if (property.PhotoUrls?.Any() == true)
                                {
                                    <img src="@(selectedPhotoUrl ?? property.PhotoUrls.First())" class="featured-image" alt="Property Photo" />
                                }
                                else
                                {
                                    <div class="no-photo-placeholder-lg">
                                        <i class="fas fa-camera-retro"></i>
                                        <span>Фотографии скоро появятся</span>
                                    </div>
                                }
                                
                                <div class="status-badge-premium @property.StatusName?.ToLower()">
                                    <span class="status-dot"></span>
                                    @TranslateStatus(property.StatusName)
                                </div>
                            </div>

                            @if (property.PhotoUrls?.Count > 1)
                            {
                                <div class="thumbnails-container">
                                    @foreach (var url in property.PhotoUrls)
                                    {
                                        <div class="thumb-item @(url == (selectedPhotoUrl ?? property.PhotoUrls.First()) ? "active" : "")"
                                             @onclick="() => selectedPhotoUrl = url">
                                            <img src="@url" alt="Preview" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @* Описание и Характеристики *@
                        <div class="property-info-card">
                            <div class="info-main-header">
                                <div class="type-badge">@property.PropertyTypeName</div>
                                <h1 class="property-address-title">@property.Address</h1>
                                <div class="price-hero">
                                    <span class="price-label">Предложение месяца</span>
                                    <div class="price-value">@property.Price?.ToString("N0") <span class="currency">₽</span></div>
                                </div>
                            </div>

                            <div class="specs-grid">
                                <div class="spec-card">
                                    <i class="fas fa-ruler-combined"></i>
                                    <div class="spec-info">
                                        <span class="label">Общая площадь</span>
                                        <span class="val">@property.TotalArea м²</span>
                                    </div>
                                </div>
                                <div class="spec-card">
                                    <i class="fas fa-bed"></i>
                                    <div class="spec-info">
                                        <span class="label">Комнат</span>
                                        <span class="val">@property.Rooms</span>
                                    </div>
                                </div>
                                <div class="spec-card">
                                    <i class="fas fa-layer-group"></i>
                                    <div class="spec-info">
                                        <span class="label">Этаж</span>
                                        <span class="val">@property.Floor / @property.TotalFloors</span>
                                    </div>
                                </div>
                                <div class="spec-card">
                                    <i class="fas fa-couch"></i>
                                    <div class="spec-info">
                                        <span class="label">Жилая</span>
                                        <span class="val">@(property.LivingArea?.ToString() ?? "—") м²</span>
                                    </div>
                                </div>
                            </div>

                            <div class="description-block">
                                <h3 class="block-title">Описание объекта</h3>
                                <div class="description-text">
                                    @property.Description
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ПРАВАЯ КОЛОНКА: Форма (Sticky) *@
                    <div class="sidebar-section fade-in-delay">
                        <div class="sticky-sidebar">
                            <div class="booking-card-premium">
                                <div class="booking-header-box">
                                    <h4>Записаться на просмотр</h4>
                                    <p>Персональный показ в удобное время</p>
                                </div>
                                
                                <EditForm Model="@newShowing" OnValidSubmit="SubmitShowing">
                                    <DataAnnotationsValidator />
                                    
                                    <div class="luxe-form-group">
                                        <label><i class="far fa-calendar-alt"></i> Дата</label>
                                        <InputDate @bind-Value="newShowing.Date" class="luxe-input" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                        <ValidationMessage For="@(() => newShowing.Date)" class="luxe-error" />
                                    </div>

                                    <div class="luxe-form-group">
                                        <label><i class="far fa-clock"></i> Время</label>
                                        <input type="time" @bind="newShowing.Time" class="luxe-input" />
                                        <ValidationMessage For="@(() => newShowing.Time)" class="luxe-error" />
                                    </div>

                                    <div class="luxe-form-group">
                                        <label><i class="far fa-user"></i> Ваше имя</label>
                                        <InputText @bind-Value="newShowing.ClientName" class="luxe-input" placeholder="Иван Иванов" />
                                        <ValidationMessage For="@(() => newShowing.ClientName)" class="luxe-error" />
                                    </div>

                                    <div class="luxe-form-group">
                                        <label><i class="fas fa-phone-alt"></i> Телефон</label>
                                        <InputText @bind-Value="newShowing.Phone" class="luxe-input" placeholder="+7 (___) ___-__-__" />
                                        <ValidationMessage For="@(() => newShowing.Phone)" class="luxe-error" />
                                    </div>

                                    <div class="luxe-form-group">
                                        <label><i class="far fa-comment-dots"></i> Комментарий</label>
                                        <InputTextArea @bind-Value="newShowing.Comments" class="luxe-textarea" rows="2" placeholder="Особые пожелания..." />
                                    </div>

                                    <button type="submit" class="btn-luxe-primary">
                                        <span>Отправить запрос</span>
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </EditForm>
                            </div>
                            
                            <div class="agent-mini-card">
                                <i class="fas fa-headset"></i>
                                <div>
                                    <p>Нужна консультация?</p>
                                    <a href="tel:+79998887766">+7 (999) 888-77-66</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .main-container { background: #121212; min-height: 100vh; }
    .page-wrapper-premium { padding: 120px 40px 60px 40px; }
    .container-premium { max-width: 1400px; margin: 0 auto; }

    /* ХЛЕБНЫЕ КРОШКИ */
    .property-detail-header { margin-bottom: 30px; }
    .back-link { color: #888; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: 0.3s; display: flex; align-items: center; gap: 10px; }
    .back-link:hover { color: #f39c12; transform: translateX(-5px); }

    /* ГРИД */
    .premium-grid { display: grid; grid-template-columns: 1fr 400px; gap: 40px; align-items: start; }

    /* ГАЛЕРЕЯ */
    .main-gallery-card { background: #1a1a1a; border-radius: 32px; padding: 15px; border: 1px solid rgba(255,255,255,0.05); margin-bottom: 30px; }
    .featured-image-wrapper { position: relative; height: 600px; border-radius: 24px; overflow: hidden; }
    .featured-image { width: 100%; height: 100%; object-fit: cover; transition: 0.5s; }
    
    .thumbnails-container { display: flex; gap: 12px; margin-top: 15px; overflow-x: auto; padding-bottom: 10px; }
    .thumb-item { width: 110px; height: 75px; border-radius: 12px; overflow: hidden; cursor: pointer; opacity: 0.4; transition: 0.3s; border: 2px solid transparent; flex-shrink: 0; }
    .thumb-item.active { opacity: 1; border-color: #f39c12; transform: scale(1.05); }
    .thumb-item img { width: 100%; height: 100%; object-fit: cover; }

    /* БЭЙДЖ СТАТУСА */
    .status-badge-premium { 
        position: absolute; top: 25px; left: 25px; padding: 10px 22px; border-radius: 50px; 
        font-weight: 800; font-size: 0.75rem; letter-spacing: 1px; backdrop-filter: blur(12px);
        background: rgba(0,0,0,0.6); display: flex; align-items: center; gap: 10px;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .status-badge-premium.available { color: #4ade80; }
    .status-badge-premium.reserved { color: #f39c12; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; }

    /* ИНФО-КАРТОЧКА */
    .property-info-card { background: #1a1a1a; border-radius: 32px; padding: 45px; border: 1px solid rgba(255,255,255,0.05); }
    .type-badge { color: #f39c12; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; margin-bottom: 15px; }
    .property-address-title { font-size: 2.8rem; font-weight: 800; margin-bottom: 30px; line-height: 1.2; }
    
    .price-hero { background: rgba(255,255,255,0.03); padding: 25px; border-radius: 20px; display: inline-block; margin-bottom: 40px; }
    .price-label { font-size: 0.75rem; color: #666; text-transform: uppercase; display: block; margin-bottom: 5px; }
    .price-value { font-size: 2.5rem; font-weight: 800; color: #fff; }
    .price-value .currency { color: #f39c12; }

    /* ХАРАКТЕРИСТИКИ */
    .specs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 50px; }
    .spec-card { background: #222; padding: 20px; border-radius: 18px; display: flex; align-items: center; gap: 20px; border: 1px solid transparent; transition: 0.3s; }
    .spec-card:hover { border-color: rgba(243, 156, 18, 0.3); background: #252525; }
    .spec-card i { font-size: 1.5rem; color: #f39c12; width: 30px; text-align: center; }
    .spec-info .label { display: block; font-size: 0.8rem; color: #666; }
    .spec-info .val { font-size: 1.1rem; font-weight: 700; }

    .description-block .block-title { font-size: 1.4rem; font-weight: 700; margin-bottom: 20px; }
    .description-text { color: #aaa; line-height: 1.8; font-size: 1.05rem; }

    /* ФОРМА БРОНИРОВАНИЯ */
    .sticky-sidebar { position: sticky; top: 120px; }
    .booking-card-premium { background: #1e1e1e; border-radius: 32px; padding: 35px; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 30px 60px rgba(0,0,0,0.4); }
    .booking-header-box { margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 20px; }
    .booking-header-box h4 { font-size: 1.3rem; font-weight: 800; margin-bottom: 5px; }
    .booking-header-box p { font-size: 0.9rem; color: #666; margin: 0; }

    .luxe-form-group { margin-bottom: 20px; }
    .luxe-form-group label { display: block; font-size: 0.75rem; font-weight: 700; color: #888; text-transform: uppercase; margin-bottom: 8px; }
    .luxe-input, .luxe-textarea { 
        width: 100%; background: #252525; border: 1px solid #333; border-radius: 14px; 
        padding: 14px 18px; color: #fff; transition: 0.3s; font-size: 0.95rem; 
    }
    .luxe-input:focus, .luxe-textarea:focus { border-color: #f39c12; outline: none; background: #2a2a2a; box-shadow: 0 0 15px rgba(243, 156, 18, 0.1); }
    
    .btn-luxe-primary { 
        width: 100%; background: #f39c12; color: #fff; border: none; border-radius: 16px; 
        padding: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center; 
        gap: 12px; cursor: pointer; transition: 0.3s; margin-top: 10px;
    }
    .btn-luxe-primary:hover { background: #e67e22; transform: translateY(-3px); box-shadow: 0 15px 30px rgba(243, 156, 18, 0.3); }

    .agent-mini-card { display: flex; align-items: center; gap: 15px; margin-top: 25px; padding: 20px; background: rgba(243, 156, 18, 0.05); border-radius: 20px; border: 1px solid rgba(243, 156, 18, 0.1); }
    .agent-mini-card i { font-size: 1.2rem; color: #f39c12; }
    .agent-mini-card p { font-size: 0.8rem; color: #888; margin: 0; }
    .agent-mini-card a { color: #fff; text-decoration: none; font-weight: 700; }

    /* LOADER */
    .loader-container { text-align: center; padding: 150px 0; }
    .spinner-premium { width: 50px; height: 50px; border: 3px solid rgba(243, 156, 18, 0.1); border-top-color: #f39c12; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ANIMATIONS */
    .fade-in { animation: fadeIn 0.8s ease-out forwards; }
    .fade-in-delay { animation: fadeIn 0.8s ease-out 0.3s backwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    @@media (max-width: 1100px) {
        .premium-grid { grid-template-columns: 1fr; }
        .sticky-sidebar { position: static; }
        .featured-image-wrapper { height: 400px; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private PropertyDto? property;
    private string? selectedPhotoUrl;
    private ShowingRequest newShowing = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            property = await Api.GetPropertyAsync(Id);
            if (property?.PhotoUrls?.Any() == true)
                selectedPhotoUrl = property.PhotoUrls.First();
        }
        catch { }
    }

    private async Task SubmitShowing()
    {
        var timeSpan = new TimeSpan(newShowing.Time.Hour, newShowing.Time.Minute, 0);

        var request = new CreateShowingRequest
        {
            PropertyId = Id,
            Date = newShowing.Date ?? DateTime.Today,
            Time = timeSpan,
            ClientName = newShowing.ClientName,
            ClientPhone = newShowing.Phone,
            Comments = newShowing.Comments
        };

        try
        {
            await Api.CreateShowingAsync(request);
            await JsRuntime.InvokeVoidAsync("alert", "Ваша заявка принята! Агент перезвонит вам в ближайшее время.");
            newShowing = new ShowingRequest();
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    string TranslateStatus(string? status) => status switch
    {
        "Available" => "Доступно к просмотру",
        "Reserved" => "В резерве",
        "Sold" => "Объект продан",
        _ => status?.ToUpper() ?? "Статус уточняется"
    };

    public class ShowingRequest
    {
        [Required(ErrorMessage = "Дата обязательна")]
        public DateTime? Date { get; set; } = DateTime.Today.AddDays(1);
        
        [Required(ErrorMessage = "Время обязательно")]
        public TimeOnly Time { get; set; } = new TimeOnly(12, 0);
        
        [Required(ErrorMessage = "Представьтесь, пожалуйста")]
        public string ClientName { get; set; } = "";
        
        [Required(ErrorMessage = "Укажите номер телефона")]
        [Phone(ErrorMessage = "Неверный формат телефона")]
        public string Phone { get; set; } = "";
        
        public string? Comments { get; set; }
    }
}