@page "/property/{Id:int}"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudThemeProvider IsDarkMode="true" Theme="_luxeTheme" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.ExtraSmall" />
<MudSnackbarProvider />

<div class="luxe-page-container">
    <div class="content-max-width">
        @if (property == null)
        {
            <div class="luxe-loader">
                <MudProgressCircular Color="Color.Warning" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else
        {
           
            <div class="luxe-nav fade-in">
                <a href="/properties" class="luxe-back-btn">
                    <div class="btn-circle"><i class="fas fa-chevron-left"></i></div>
                    <span>Вернуться в каталог</span>
                </a>
            </div>

            <div class="luxe-main-grid">
               
                <div class="luxe-content fade-in">
                    <div class="luxe-gallery">
                        <div class="luxe-main-img-wrapper">
                            <img src="@(selectedPhotoUrl ?? property.PhotoUrls?.FirstOrDefault())" class="luxe-main-img" />
                            <div class="luxe-badge-status @property.StatusName?.ToLower()">
                                <span class="status-dot"></span> @TranslateStatus(property.StatusName)
                            </div>
                        </div>

                        @if (property.PhotoUrls?.Count > 1)
                        {
                            <div class="luxe-thumbs">
                                @foreach (var url in property.PhotoUrls)
                                {
                                    <div class="luxe-thumb @(url == (selectedPhotoUrl ?? property.PhotoUrls.First()) ? "is-active" : "")"
                                         @onclick="() => selectedPhotoUrl = url">
                                        <img src="@url" />
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="luxe-info-card">
                        <div class="luxe-header-group">
                            <div class="luxe-tags">
                                <span class="tag-pill gold">@property.PropertyTypeName</span>
                                <span class="tag-pill glass">Эксклюзивное предложение</span>
                            </div>
                            <h1 class="luxe-title">@property.Address</h1>
                            <div class="luxe-price-strip">
                                <span class="val">@property.Price?.ToString("N0")</span>
                                <span class="cur">₽</span>
                            </div>
                        </div>

                        <div class="luxe-specs">
                            <div class="spec"><i class="fas fa-expand-arrows-alt"></i><div><p>ПЛОЩАДЬ</p><strong>@property.TotalArea м²</strong></div></div>
                            <div class="spec"><i class="fas fa-bed"></i><div><p>КОМНАТЫ</p><strong>@property.Rooms</strong></div></div>
                            <div class="spec"><i class="fas fa-layer-group"></i><div><p>ЭТАЖ</p><strong>@property.Floor / @property.TotalFloors</strong></div></div>
                            <div class="spec"><i class="fas fa-gem"></i><div><p>ОТДЕЛКА</p><strong>Premium</strong></div></div>
                        </div>

                        <div class="luxe-desc">
                            <h3>Описание объекта</h3>
                            <p>@property.Description</p>
                        </div>
                    </div>
                </div>

               
                <div class="luxe-sidebar">
                    <div class="luxe-form-glass">
                        <div class="form-title">
                            <h2>Запись на просмотр</h2>
                            <p>Персональный тур в удобное время</p>
                        </div>

                        <EditForm Model="@newShowing" OnValidSubmit="SubmitShowing">
                            <DataAnnotationsValidator />

                            <div class="luxe-field-box">
                                <label>ФИО</label>
                                <InputText @bind-Value="newShowing.FullName" class="luxe-input" placeholder="Иван Иванов" />
                                <ValidationMessage For="@(() => newShowing.FullName)" class="luxe-err" />
                            </div>

                            <div class="luxe-field-box">
                                <label>ТЕЛЕФОН</label>
                                <input type="text" value="@newShowing.Phone" @oninput="HandlePhoneInput" 
                                       class="luxe-input" maxlength="18" placeholder="+7 (___) ___-__-__" />
                                <ValidationMessage For="@(() => newShowing.Phone)" class="luxe-err" />
                            </div>

                            <div class="luxe-row-inputs">
                                <div class="luxe-field-box">
                                    <label>ДАТА</label>
                                    <MudDatePicker @bind-Date="newShowing.Date" Color="Color.Warning" Rounded="true" Class="mud-input-glass" />
                                </div>
                                <div class="luxe-field-box">
                                    <label>ВРЕМЯ</label>
                                    <MudTimePicker @bind-Time="bookingTime" Color="Color.Warning" Rounded="true" Class="mud-input-glass" />
                                </div>
                            </div>

                            <div class="luxe-field-box">
                                <label>КОММЕНТАРИЙ</label>
                                <InputTextArea @bind-Value="newShowing.Comments" class="luxe-input" rows="3" placeholder="Ваши пожелания..." />
                            </div>

                            <button type="submit" class="luxe-submit-btn">
                                <span>Забронировать визит</span>
                                <i class="fas fa-arrow-right"></i>
                            </button>
                        </EditForm>
                    </div>

                    <div class="luxe-agent-card">
                        <div class="agent-icon"><i class="fas fa-user-tie"></i></div>
                        <div class="agent-text">
                            <span>Ваш брокер</span>
                            <strong>Александр Волков</strong>
                            <a href="tel:89998887766">+7 (999) 888-77-66</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    
    :root {
        --accent: #f39c12;
        --bg-dark: #0d0d0d;
        --card-bg: #161616;
        --glass: rgba(255, 255, 255, 0.03);
        --border: rgba(255, 255, 255, 0.08);
    }

    .luxe-page-container {
        background-color: var(--bg-dark);
        min-height: 100vh;
        padding: 40px 5%;
        color: #fff;
        font-family: 'Inter', sans-serif;
    }

    .content-max-width { max-width: 1400px; margin: 0 auto; }

   
    .luxe-nav { margin-bottom: 30px; }
    .luxe-back-btn { display: flex; align-items: center; gap: 15px; text-decoration: none; color: #888; transition: 0.3s; }
    .luxe-back-btn .btn-circle { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; background: var(--glass); }
    .luxe-back-btn:hover { color: var(--accent); }
    .luxe-back-btn:hover .btn-circle { border-color: var(--accent); background: rgba(243,156,18,0.1); }

    
    .luxe-main-grid { display: grid; grid-template-columns: 1fr 400px; gap: 40px; align-items: start; }

   
    .luxe-main-img-wrapper { height: 500px; border-radius: 24px; overflow: hidden; position: relative; border: 1px solid var(--border); }
    .luxe-main-img { width: 100%; height: 100%; object-fit: cover; }
    .luxe-badge-status { position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.6); backdrop-filter: blur(10px); padding: 8px 16px; border-radius: 50px; border: 1px solid var(--border); display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; }
    .luxe-badge-status.available { color: #2ecc71; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; }

    .luxe-thumbs { display: flex; gap: 12px; margin-top: 15px; }
    .luxe-thumb { width: 90px; height: 60px; border-radius: 12px; overflow: hidden; border: 2px solid transparent; opacity: 0.4; cursor: pointer; transition: 0.3s; }
    .luxe-thumb.is-active { opacity: 1; border-color: var(--accent); }
    .luxe-thumb img { width: 100%; height: 100%; object-fit: cover; }

    
    .luxe-info-card { margin-top: 30px; }
    .luxe-tags { display: flex; gap: 10px; margin-bottom: 20px; }
    .tag-pill { padding: 6px 14px; border-radius: 8px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
    .tag-pill.gold { background: var(--accent); color: #000; }
    .tag-pill.glass { background: var(--glass); border: 1px solid var(--border); color: #fff; }

    .luxe-title { font-size: 38px; font-weight: 900; line-height: 1.1; margin-bottom: 20px; }
    .luxe-price-strip { padding: 20px 30px; background: linear-gradient(90deg, rgba(243,156,18,0.15) 0%, transparent 100%); border-left: 4px solid var(--accent); border-radius: 4px 16px 16px 4px; }
    .luxe-price-strip .val { font-size: 32px; font-weight: 800; }
    .luxe-price-strip .cur { color: var(--accent); font-size: 20px; margin-left: 5px; }

    .luxe-specs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin: 30px 0; }
    .spec { background: var(--card-bg); border: 1px solid var(--border); padding: 15px; border-radius: 16px; display: flex; align-items: center; gap: 15px; }
    .spec i { font-size: 20px; color: var(--accent); }
    .spec p { font-size: 9px; color: #555; margin: 0; letter-spacing: 1px; }
    .spec strong { font-size: 16px; }

    .luxe-desc h3 { font-size: 20px; margin-bottom: 10px; color: #fff; }
    .luxe-desc p { color: #aaa; line-height: 1.6; }

  
    .luxe-form-glass { background: rgba(22, 22, 22, 0.7); backdrop-filter: blur(20px); border: 1px solid var(--border); border-radius: 24px; padding: 35px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
    .form-title h2 { font-size: 24px; font-weight: 800; margin-bottom: 5px; }
    .form-title p { color: #666; font-size: 14px; margin-bottom: 25px; }

    .luxe-field-box { margin-bottom: 18px; }
    .luxe-field-box label { display: block; font-size: 10px; font-weight: 700; color: var(--accent); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px; }
    .luxe-input { width: 100%; background: var(--glass); border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; color: #fff; transition: 0.3s; }
    .luxe-input:focus { border-color: var(--accent); outline: none; background: rgba(255,255,255,0.06); }

    .luxe-row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    
    
    .mud-input-glass { background: var(--glass) !important; border-radius: 12px !important; color: white !important; }
    
    .luxe-submit-btn { width: 100%; background: var(--accent); color: #000; border: none; padding: 16px; border-radius: 12px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px; transition: 0.3s; }
    .luxe-submit-btn:hover { background: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(243,156,18,0.2); }

    .luxe-agent-card { margin-top: 20px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 15px; display: flex; align-items: center; gap: 15px; }
    .agent-icon { width: 40px; height: 40px; background: #222; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--accent); }
    .agent-text span { display: block; font-size: 11px; color: #555; }c
    .agent-text a { color: var(--accent); text-decoration: none; font-size: 14px; }

    .luxe-err { color: #ff4757; font-size: 11px; margin-top: 4px; display: block; }

    @@media (max-width: 1100px) {
        .luxe-main-grid { grid-template-columns: 1fr; }
        .luxe-sidebar { position: static; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private PropertyDto? property;
    private string? selectedPhotoUrl;
    private ShowingRequest newShowing = new ShowingRequest();

    private TimeSpan? bookingTime {
        get => newShowing.Time.ToTimeSpan();
        set => newShowing.Time = value.HasValue ? TimeOnly.FromTimeSpan(value.Value) : new TimeOnly(12, 0);
    }

    private MudTheme _luxeTheme = new MudTheme() {
        PaletteDark = new PaletteDark() { 
            Primary = "#f39c12", 
            Surface = "#161616", 
            Background = "#0d0d0d", 
            Warning = "#f39c12",
            AppbarBackground = "#0d0d0d"
        }
    };

    private void HandlePhoneInput(ChangeEventArgs e)
    {
        string input = e.Value?.ToString() ?? "";
        string digits = new string(input.Where(char.IsDigit).ToArray());

        if (digits.Length > 0 && digits[0] != '7') 
        {
            if (digits[0] == '8') digits = "7" + digits.Substring(1);
            else digits = "7" + digits;
        }
        
        if (digits.Length == 0) digits = "7";
        if (digits.Length > 11) digits = digits.Substring(0, 11);

        string formatted = "+7";
        if (digits.Length > 1)
        {
            var areaCode = digits.Substring(1, Math.Min(3, digits.Length - 1));
            formatted += $" ({areaCode}";
            if (digits.Length > 4)
            {
                formatted += ") ";
                var firstPart = digits.Substring(4, Math.Min(3, digits.Length - 4));
                formatted += firstPart;
                if (digits.Length > 7)
                {
                    formatted += "-";
                    var secondPart = digits.Substring(7, Math.Min(2, digits.Length - 7));
                    formatted += secondPart;
                    if (digits.Length > 9)
                    {
                        formatted += "-";
                        var thirdPart = digits.Substring(9, Math.Min(2, digits.Length - 9));
                        formatted += thirdPart;
                    }
                }
            }
        }
        newShowing.Phone = formatted;
    }

    protected override async Task OnInitializedAsync()
    {
        try {
            property = await Api.GetPropertyAsync(Id);
            selectedPhotoUrl = property?.PhotoUrls?.FirstOrDefault();
        } catch { }
    }

    private async Task SubmitShowing()
    {
        try {
            await Api.CreateShowingAsync(new CreateShowingRequest {
                PropertyId = Id,
                Date = newShowing.Date ?? DateTime.Today,
                Time = newShowing.Time.ToTimeSpan(),
                ClientName = newShowing.FullName,
                ClientPhone = newShowing.Phone,
                Comments = newShowing.Comments
            });
            await DialogService.ShowMessageBox("Успех", "Заявка успешно отправлена!");
            newShowing = new ShowingRequest();
        } catch (Exception ex) {
            Snackbar.Add("Ошибка: " + ex.Message, Severity.Error);
        }
    }

    string TranslateStatus(string? status) => status == "Available" ? "Актуально" : "В продаже";

    public class ShowingRequest {
        [Required(ErrorMessage = "Укажите ваше имя")]
        public string FullName { get; set; } = "";
        
        [Required(ErrorMessage = "Укажите телефон")]
        [RegularExpression(@"^\+7 \(\d{3}\) \d{3}-\d{2}-\d{2}$", ErrorMessage = "Введите корректный номер")]
        public string Phone { get; set; } = "+7";
        
        public DateTime? Date { get; set; } = DateTime.Today.AddDays(1);
        public TimeOnly Time { get; set; } = new TimeOnly(12, 0);
        public string? Comments { get; set; }
    }
}