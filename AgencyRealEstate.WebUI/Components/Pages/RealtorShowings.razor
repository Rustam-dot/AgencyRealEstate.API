@page "/realtor-showings"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager,Realtor")]
@using System.Net.Http.Json
@inject HttpClient Http

<div class="showings-dashboard">
    <!-- Header -->
    <div class="dashboard-header animate-fade-in">
        <div class="header-content">
            <h1 class="page-title">Управление <span class="purple-text">показами</span></h1>
            <p class="page-subtitle">@(showings?.Count ?? 0) всего показов</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid animate-fade-in" style="animation-delay: 0.1s;">
        <div class="stat-card @(currentFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
            <div class="stat-icon"><i class="fas fa-list"></i></div>
            <div class="stat-number">@(showings?.Count ?? 0)</div>
            <div class="stat-label">Все показы</div>
        </div>
        <div class="stat-card @(currentFilter == "active" ? "active" : "")" @onclick='() => SetFilter("active")'>
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-number">@activeCount</div>
            <div class="stat-label">Активные</div>
        </div>
        <div class="stat-card @(currentFilter == "interested" ? "active" : "")" @onclick='() => SetFilter("interested")'>
            <div class="stat-icon"><i class="fas fa-eye"></i></div>
            <div class="stat-number">@interestedCount</div>
            <div class="stat-label">Заинтересованы</div>
        </div>
        <div class="stat-card @(currentFilter == "completed" ? "active" : "")" @onclick='() => SetFilter("completed")'>
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-number">@completedCount</div>
            <div class="stat-label">Завершены</div>
        </div>
        <div class="stat-card @(currentFilter == "cancelled" ? "active" : "")" @onclick='() => SetFilter("cancelled")'>
            <div class="stat-icon"><i class="fas fa-times"></i></div>
            <div class="stat-number">@cancelledCount</div>
            <div class="stat-label">Отменены</div>
        </div>
    </div>

    <!-- Section Header -->
    <div class="section-header animate-fade-in" style="animation-delay: 0.2s;">
        <h2><i class="fas fa-filter"></i> @GetFilterTitle</h2>
    </div>

    @if (showings == null)
    {
        <div class="loader-container">
            <div class="premium-spinner"></div>
        </div>
    }
    else if (!FilteredShowings.Any())
    {
        <div class="empty-state animate-fade-in">
            <i class="fas fa-inbox"></i>
            <p>В данной категории нет показов</p>
        </div>
    }
    else
    {
        <div class="showings-grid">
            @foreach (var showing in FilteredShowings)
            {
                <div class="showing-card animate-fade-up">
                    <div class="card-header">
                        <div class="property-info">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <h3>@showing.PropertyTitle</h3>
                                <small class="property-address">@showing.PropertyAddress</small>
                            </div>
                        </div>
                        <span class="status-badge @GetStatusClass(showing.ResultId)">
                            @GetStatusName(showing.ResultId)
                        </span>
                    </div>
                    
                    <div class="card-body">
                        <div class="property-type">
                            <i class="fas fa-building"></i>
                            <span>@showing.PropertyTypeName</span>
                        </div>
                        <div class="client-info">
                            <i class="fas fa-user"></i>
                            <span>@showing.ClientName</span>
                        </div>
                        <div class="client-phone">
                            <i class="fas fa-phone"></i>
                            <a href="tel:@showing.ClientPhone">@showing.ClientPhone</a>
                        </div>
                        <div class="showing-datetime">
                            <span class="date"><i class="fas fa-calendar"></i> @showing.ShowingDateTime.ToString("dd.MM.yyyy")</span>
                            <span class="time"><i class="fas fa-clock"></i> @showing.ShowingDateTime.ToString("HH:mm")</span>
                        </div>
                    </div>

                    <div class="card-footer">
                        <span class="realtor-name">Риелтор: @showing.RealtorName</span>
                        
                        <!-- Красивая кнопка для смены статуса -->
                       <button class="btn-change-status" @onclick="() => OpenChangeStatusModal(showing)">
    <span>Изменить статус</span>
</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Change Status Modal - КРАСИВЫЙ ВАРИАНТ -->
@if (showChangeStatusModal && selectedShowing != null)
{
    <div class="modal-backdrop" @onclick="CloseChangeStatusModal">
        <div class="modal-content small" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Изменить статус</h2>
                <button class="btn-close" @onclick="CloseChangeStatusModal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div class="status-options">
                    <div class="status-option completed" @onclick="() => ChangeStatus(1)">
                        <i class="fas fa-check-circle"></i>
                        <div>
                            <strong>Завершён</strong>
                            <small>Показ успешно проведён</small>
                        </div>
                    </div>
                    <div class="status-option interested" @onclick="() => ChangeStatus(3)">
                        <i class="fas fa-eye"></i>
                        <div>
                            <strong>Заинтересован</strong>
                            <small>Клиент заинтересован в объекте</small>
                        </div>
                    </div>
                    <div class="status-option refused" @onclick="() => ChangeStatus(2)">
                        <i class="fas fa-times-circle"></i>
                        <div>
                            <strong>Отказ</strong>
                            <small>Клиент отказался</small>
                        </div>
                    </div>
                    <div class="status-option postponed" @onclick="() => ChangeStatus(4)">
                        <i class="fas fa-calendar-alt"></i>
                        <div>
                            <strong>Перенесён</strong>
                            <small>Показ перенесён на другое время</small>
                        </div>
                    </div>
                    <div class="status-option noshow" @onclick="() => ChangeStatus(5)">
                        <i class="fas fa-user-times"></i>
                        <div>
                            <strong>Неявка</strong>
                            <small>Клиент не пришёл</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}



@code {
    private List<ShowingDto>? showings;
    private string currentFilter = "all";
    private bool showChangeStatusModal = false;
    private ShowingDto? selectedShowing;

    private int activeCount => showings?.Count(s => s.ResultId == null) ?? 0;
    private int interestedCount => showings?.Count(s => s.ResultId == 3) ?? 0;
    private int completedCount => showings?.Count(s => s.ResultId == 1) ?? 0;
    private int notInterestedCount => showings?.Count(s => s.ResultId == 2) ?? 0;
    private int cancelledCount => showings?.Count(s => s.ResultId == 4 || s.ResultId == 5) ?? 0;

    private string GetFilterTitle => currentFilter switch
    {
        "all" => "Все показы",
        "active" => "Активные показы",
        "interested" => "Заинтересованные клиенты",
        "completed" => "Завершённые показы",
        "cancelled" => "Отменены",
        _ => "Показы"
    };

    private IEnumerable<ShowingDto> FilteredShowings
    {
        get
        {
            if (showings == null) return new List<ShowingDto>();
            
            var filtered = currentFilter switch
            {
                "active" => showings.Where(s => s.ResultId == null),
                "interested" => showings.Where(s => s.ResultId == 3),
                "completed" => showings.Where(s => s.ResultId == 1),
                "cancelled" => showings.Where(s => s.ResultId == 2 || s.ResultId == 4 || s.ResultId == 5),
                _ => showings
            };

            // ✅ СОРТИРОВКА ПО ДАТЕ: ближайшие показы сверху
            return filtered.OrderBy(s => s.ShowingDateTime);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadShowings();
    }

    private async Task LoadShowings()
    {
        try
        {
            await Task.Delay(300);
            var result = await Http.GetFromJsonAsync<List<ShowingDto>>("showings/all-assigned");
            showings = result ?? new List<ShowingDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading showings: {ex.Message}");
            showings = new List<ShowingDto>();
        }
    }

    private void SetFilter(string filter)
    {
        currentFilter = filter;
    }

    private void OpenChangeStatusModal(ShowingDto showing)
    {
        selectedShowing = showing;
        showChangeStatusModal = true;
    }

    private void CloseChangeStatusModal()
    {
        showChangeStatusModal = false;
        selectedShowing = null;
    }

    private async Task ChangeStatus(byte resultId)
    {
        if (selectedShowing == null) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"showings/{selectedShowing.ShowingId}/result", new
            {
                ResultId = resultId,
                Comments = selectedShowing.Comments
            });

            if (response.IsSuccessStatusCode)
            {
                await LoadShowings();
                CloseChangeStatusModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing status: {ex.Message}");
        }
    }

 private string GetStatusClass(byte? resultId)
{
    return resultId switch
    {
        null => "scheduled", 
        1 => "completed",
        2 => "refused",
        3 => "interested",
        4 => "postponed",
        5 => "noshow",
        _ => ""
    };
}

    private string GetStatusName(byte? resultId)
    {
        return resultId switch
        {
            null => "🕐 Запланирован",
            1 => "✅ Завершён",
            2 => "❌ Отказ",
            3 => "👁 Заинтересован",
            4 => "📅 Перенесён",
            5 => "🚫 Неявка",
            _ => "❓ Неизвестно"
        };
    }

    public class ShowingDto
    {
        public int ShowingId { get; set; }
        public DateTime ShowingDateTime { get; set; }
        public string PropertyAddress { get; set; } = "";
        public string PropertyTitle { get; set; } = "";
        public string PropertyTypeName { get; set; } = "";
        public string ClientName { get; set; } = "";
        public string ClientPhone { get; set; } = "";
        public string? ClientEmail { get; set; }
        public string? ClientPassport { get; set; }
        public string? Comments { get; set; }
        public string? RealtorName { get; set; }
        public byte? ResultId { get; set; }
    }
}