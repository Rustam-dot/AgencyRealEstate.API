@page "/clients"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator,Manager,Realtor")]
@using System.Net.Http.Json
@inject HttpClient Http

<div class="clients-page">
    <!-- Animated Background -->
    <div class="bg-gradient"></div>
    
    <div class="clients-container">
        <!-- Header -->
        <div class="page-header animate-fade-in">
            <div class="header-left">
                <h1 class="page-title">База <span class="purple-text">клиентов</span></h1>
                <p class="page-subtitle">Активные зарегистрированные клиенты компании</p>
            </div>
            <div class="stats-badge">
                <i class="fas fa-users"></i>
                <span>@(clients?.Count ?? 0) записей</span>
            </div>
        </div>

        @if (clients != null && clients.Any())
        {
            <div class="search-bar animate-fade-in" style="animation-delay: 0.1s;">
                <i class="fas fa-search"></i>
                <input type="text" @bind="searchText" @bind:event="oninput" placeholder="Поиск по имени, телефону или email..." />
            </div>
        }

        @if (clients == null)
        {
            <div class="loader-container">
                <div class="premium-spinner"></div>
            </div>
        }
        else if (!clients.Any())
        {
            <div class="empty-state animate-fade-in">
                <i class="fas fa-user-friends"></i>
                <h3>База данных пуста</h3>
                <p>Как только пользователи пройдут регистрацию, их профили отобразятся здесь</p>
            </div>
        }
        else if (!FilteredClients.Any())
        {
            <div class="empty-state animate-fade-in">
                <i class="fas fa-search-minus"></i>
                <h3>Совпадений не найдено</h3>
                <p>По вашему запросу «@searchText» нет результатов</p>
            </div>
        }
        else
        {
            <div class="clients-grid">
                @foreach (var client in FilteredClients)
                {
                    <div class="client-card animate-fade-up">
                        <div class="card-body">
                            <div class="avatar-wrapper">
                                @if (!string.IsNullOrWhiteSpace(client.AvatarUrl))
                                {
                                    <img src="@client.AvatarUrl" alt="@client.FullName" class="client-avatar" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder">
                                        @GetInitial(client)
                                    </div>
                                }
                            </div>
                            <div class="client-info">
                                <h4>@(string.IsNullOrWhiteSpace(client.FullName) ? "Без имени" : client.FullName)</h4>
                                <p class="client-email">@client.Email</p>
                                <div class="client-meta">
                                    <span class="meta-item">
                                        <i class="fas fa-phone"></i>
                                        @(string.IsNullOrWhiteSpace(client.Phone) ? "Не указан" : client.Phone)
                                    </span>
                                </div>
                                <div class="client-meta">
                                    <span class="meta-item">
                                        <i class="fas fa-calendar"></i>
                                        @client.CreatedAt.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <span class="client-id">ID: #@client.UserId</span>
                            <span class="status-badge @(client.IsActive ? "active" : "inactive")">
                                <span class="status-dot"></span>
                                @(client.IsActive ? "Активен" : "Заблокирован")
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>



@code {
    private List<ClientDto>? clients;
    private string searchText = "";

    private IEnumerable<ClientDto> FilteredClients =>
        string.IsNullOrWhiteSpace(searchText)
            ? clients ?? new List<ClientDto>()
            : (clients ?? new List<ClientDto>()).Where(c => 
                (c.FullName != null && c.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (c.Phone != null && c.Phone.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (c.Email != null && c.Email.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Delay(300);
            clients = await Http.GetFromJsonAsync<List<ClientDto>>("clients");
        }
        catch
        {
            clients = new();
        }
    }

    private string GetInitial(ClientDto client)
    {
        if (!string.IsNullOrWhiteSpace(client.FullName))
            return client.FullName.Substring(0, 1).ToUpper();
        
        if (!string.IsNullOrWhiteSpace(client.Login))
            return client.Login.Substring(0, 1).ToUpper();
            
        return "U";
    }

    public class ClientDto
    {
        public int UserId { get; set; }
        public string Login { get; set; } = "";
        public string Email { get; set; } = "";
        public bool IsActive { get; set; }
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public string? AvatarUrl { get; set; }
    }
}