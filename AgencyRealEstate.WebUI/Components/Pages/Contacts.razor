@page "/contacts"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="contacts-page">
    <div class="bg-gradient"></div>
    
    <div class="container">
        <!-- Hero Section -->
        <section class="contacts-hero animate-fade-in">
            <h1 class="page-title">Кон<span class="purple-text">такты</span></h1>
            <p class="page-subtitle">Мы всегда на связи и готовы помочь вам</p>
        </section>

        <div class="contacts-grid">
            <!-- Contact Info -->
            <div class="contact-info animate-fade-up">
                <h2>Свяжитесь с <span class="purple-text">нами</span></h2>
                <p>Заполните форму, и мы свяжемся с вами в ближайшее время</p>
                
                <div class="contact-cards">
                    <div class="contact-card">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Адрес офиса</h3>
                            <p>г. Москва, ул. Тверская, д. 12, офис 404</p>
                        </div>
                    </div>
                    
                    <div class="contact-card">
                        <div class="contact-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Телефон</h3>
                            <p>+7 (495) 123-45-67</p>
                            <p>+7 (800) 555-35-35</p>
                        </div>
                    </div>
                    
                    <div class="contact-card">
                        <div class="contact-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Email</h3>
                            <p>info@realtipro.ru</p>
                            <p>support@realtipro.ru</p>
                        </div>
                    </div>
                    
                    <div class="contact-card">
                        <div class="contact-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Режим работы</h3>
                            <p>Пн-Пт: 09:00 - 20:00</p>
                            <p>Сб-Вс: 10:00 - 18:00</p>
                        </div>
                    </div>
                </div>

                <!-- Social Links -->
                <div class="social-section">
                    <h3>Мы в социальных сетях</h3>
                    <div class="social-links">
                        <a href="#" class="social-link"><i class="fab fa-telegram"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-whatsapp"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-vk"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="contact-form-wrapper animate-fade-up" style="animation-delay: 0.2s;">
                <div class="contact-form-card">
                    <h2>Отправить <span class="purple-text">сообщение</span></h2>
                    
                    <EditForm Model="contactModel" OnValidSubmit="SubmitForm">
                        <DataAnnotationsValidator />
                        
                        <div class="form-group">
                            <label>Ваше имя</label>
                            <InputText @bind-Value="contactModel.Name" class="form-input" placeholder="Иван Иванов" />
                            <ValidationMessage For="@(() => contactModel.Name)" class="error-message" />
                        </div>
                        
                        <div class="form-group">
                            <label>Телефон</label>
                            <InputText @bind-Value="contactModel.Phone" class="form-input" placeholder="+7 (999) 999-99-99" />
                            <ValidationMessage For="@(() => contactModel.Phone)" class="error-message" />
                        </div>
                        
                        <div class="form-group">
                            <label>Email</label>
                            <InputText @bind-Value="contactModel.Email" type="email" class="form-input" placeholder="example@mail.ru" />
                            <ValidationMessage For="@(() => contactModel.Email)" class="error-message" />
                        </div>
                        
                        <div class="form-group">
                            <label>Тема обращения</label>
                            <select @bind="contactModel.Subject" class="form-input">
                                <option value="">Выберите тему</option>
                                <option value="buy">Покупка недвижимости</option>
                                <option value="sell">Продажа недвижимости</option>
                                <option value="rent">Аренда</option>
                                <option value="consult">Консультация</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label>Сообщение</label>
                            <InputTextArea @bind-Value="contactModel.Message" class="form-input form-textarea" rows="4" placeholder="Ваш вопрос..." />
                        </div>
                        
                        <button type="submit" class="btn-submit" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <div class="spinner-small"></div>
                                <span>Отправка...</span>
                            }
                            else
                            {
                                <i class="fas fa-paper-plane"></i>
                                <span>Отправить</span>
                            }
                        </button>
                    </EditForm>
                    
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="success-message">
                            <i class="fas fa-check-circle"></i>
                            <span>@successMessage</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Yandex Map Section -->
        <section class="map-section animate-fade-up">
            <h2>Как <span class="purple-text">нас найти</span></h2>
            <div class="map-container">
                <!-- Контейнер для карты -->
                <div id="yandex-map" class="yandex-map"></div>
            </div>
        </section>
    </div>
</div>



@code {
    private ContactFormModel contactModel = new();
    private bool isSubmitting = false;
    private string? successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Вставьте ваш API ключ вместо YOUR_API_KEY
            // Получить ключ можно на https://developer.tech.yandex.ru/
            string apiKey = "f508b7a3-d2a7-46a3-84d5-9bbd47ece110"; 
            
            await JS.InvokeVoidAsync("eval", $@"
                if (typeof ymaps === 'undefined') {{
                    var script = document.createElement('script');
                    script.src = 'https://api-maps.yandex.ru/2.1/?apikey={apiKey}&lang=ru_RU';
                    script.onload = function() {{
                        ymaps.ready(function () {{
                            var myMap = new ymaps.Map('yandex-map', {{
                                center: [55.144842, 60.144198], // Координаты (Москва)
                                zoom: 15,
                                controls: ['zoomControl', 'fullscreenControl']
                            }});

                            var myPlacemark = new ymaps.Placemark([55.144842, 60.144198], {{
                                hintContent: 'РеалтиПро',
                                balloonContent: '<b>Офис РеалтиПро</b><br>г. Москва, ул. Тверская, д. 12'
                            }}, {{
                                preset: 'islands#violetRealEstateIcon'
                            }});

                            myMap.geoObjects.add(myPlacemark);
                        }});
                    }};
                    document.head.appendChild(script);
                }}
            ");
        }
    }

    private async Task SubmitForm()
    {
        isSubmitting = true;
        successMessage = null;
        
        try
        {
            await Task.Delay(1500); // Имитация отправки
            successMessage = "Сообщение отправлено!";
            contactModel = new();
        }
        catch
        {
            // Handle error
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Введите имя")]
        public string Name { get; set; } = "";
        
        [Required(ErrorMessage = "Введите телефон")]
        public string Phone { get; set; } = "";
        
        [Required(ErrorMessage = "Введите email")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";
        
        public string Subject { get; set; } = "";
        public string Message { get; set; } = "";
    }
}