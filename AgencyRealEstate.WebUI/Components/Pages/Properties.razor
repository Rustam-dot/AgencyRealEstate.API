@page "/properties"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="page-wrapper">
    <div class="hero-header">
        <h1>Каталог недвижимости</h1>
        <p>Найдите идеальный вариант среди сотен проверенных объектов</p>
    </div>

    <div class="property-grid">
        @if (filteredProperties == null)
        {
            <div class="loader">Загрузка каталога...</div>
        }
        else
        {
            @foreach (var prop in filteredProperties)
            {
                <div class="luxury-card" @onclick="() => GoToProperty(prop.PropertyID)" style="cursor:pointer;">
                    <div class="card-image-box">
                        @if (prop.PhotoUrls != null && prop.PhotoUrls.Any())
                        {
                            <img src="@prop.PhotoUrls.First()" alt="Property" />
                        }
                        else
                        {
                            <div class="no-photo" style="background: #333; height: 100%; display: flex; align-items: center; justify-content: center; color: #777;">Нет фото</div>
                        }
                        <div class="status-badge-overlay @prop.StatusName.ToLower()">
                            @TranslateStatus(prop.StatusName)
                        </div>
                    </div>
                    <div class="card-body-luxury">
                        <h3 class="card-address-title">@prop.Address</h3>
                        <p class="card-location-subtitle">@prop.PropertyTypeName</p>
                        
                        <div class="card-price-tag">@prop.Price?.ToString("N0") ₽</div>
                        
                        <div class="card-features-row">
                            <span>@prop.TotalArea м²</span>
                            <span>@prop.Rooms комн.</span>
                            <span>@prop.Floor этаж</span>
                        </div>

                        <div class="card-btn-pill">Подробнее</div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    List<PropertyDto>? allProperties;
    List<PropertyDto>? filteredProperties;

    protected override async Task OnInitializedAsync()
    {
        allProperties = await Api.GetPropertiesAsync();
        filteredProperties = allProperties;
    }

    void GoToProperty(int id) => Navigation.NavigateTo($"/property/{id}");

    string TranslateStatus(string status) => status switch
    {
        "Available" => "Доступно",
        "Reserved" => "Забронировано",
        "Sold" => "Продано",
        "Rented" => "Сдано",
        _ => status
    };
}