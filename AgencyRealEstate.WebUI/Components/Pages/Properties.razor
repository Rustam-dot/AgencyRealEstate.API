@page "/properties"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@using System.Timers
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="catalog-page">
    <!-- Header -->
    <div class="catalog-header fade-in">
        <div class="title-area">
            <h1 class="section-title">Каталог <span class="purple-text">Недвижимости</span></h1>
            <p class="result-count">Найдено @(filteredProperties?.Count ?? 0) объектов</p>
        </div>
    </div>

    <!-- Controls Bar -->
    <div class="controls-bar fade-in delay-100">
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" 
                   placeholder="Поиск по названию или локации..." 
                   @bind="SearchQuery" 
                   @bind:event="oninput" />
        </div>
        
        <div class="controls-right">
            <button class="filter-btn @(showFilters ? "active" : "")" @onclick="ToggleFilters">
                <i class="fas fa-sliders-h"></i> 
                <span>Фильтры</span>
            </button>
            
            <div class="view-toggles">
                <button class="view-btn @(viewMode == "grid" ? "active" : "")" @onclick='() => { viewMode = "grid"; StateHasChanged(); }'>
                    <i class="fas fa-th"></i>
                </button>
                <button class="view-btn @(viewMode == "list" ? "active" : "")" @onclick='() => { viewMode = "list"; StateHasChanged(); }'>
                    <i class="fas fa-list"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    @if (showFilters)
    {
        <div class="filter-panel animate-slide-down">
            <div class="filter-grid">
                <div class="filter-group">
                    <label>Тип недвижимости</label>
                    <select @bind="FilterType">
                        <option value="">Все типы</option>
                        <option value="Квартира">Квартира</option>
                        <option value="Дом">Дом</option>
                        <option value="Пентхаус">Пентхаус</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Сортировка</label>
                    <select @bind="FilterSort">
                        <option value="new">Сначала новые</option>
                        <option value="price_asc">Цена: по возрастанию</option>
                        <option value="price_desc">Цена: по убыванию</option>
                    </select>
                </div>
            </div>
            <button class="reset-link" @onclick="ResetFilters">
                <i class="fas fa-times"></i> Сбросить фильтры
            </button>
        </div>
    }

    <!-- Property Grid / List -->
    <div class="property-container @(viewMode)">
        @if (filteredProperties == null)
        {
            @for (int i = 0; i < 6; i++)
            {
                <div class="skeleton-card"></div>
            }
        }
        else if (!filteredProperties.Any())
        {
            <div class="empty-state fade-in">
                <i class="fas fa-search"></i>
                <h3>Ничего не найдено</h3>
                <p>Попробуйте изменить параметры поиска или фильтры</p>
                <button class="reset-btn" @onclick="ResetFilters">Сбросить всё</button>
            </div>
        }
        else
        {
            @for (int i = 0; i < filteredProperties.Count; i++)
            {
                var prop = filteredProperties[i];
                var cardIndex = i;
                var cardPhotoIndex = cardPhotoIndexes.TryGetValue(prop.PropertyID, out var idx) ? idx : 0;
                var hasMultiplePhotos = prop.PhotoUrls != null && prop.PhotoUrls.Count > 1;
                var currentPhotoUrl = prop.PhotoUrls != null && prop.PhotoUrls.Any() 
                    ? prop.PhotoUrls[cardPhotoIndex % prop.PhotoUrls.Count] 
                    : null;

                <div class="property-card animate-card" 
                     @onmouseenter="() => StartPhotoRotation(prop)" 
                     @onmouseleave="() => StopPhotoRotation(prop)">
                    <div class="card-image-box" @onclick="@(() => OpenModal(prop))">
                        @if (currentPhotoUrl != null)
                        {
                            <img src="@currentPhotoUrl" alt="@prop.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="no-photo">
                                <i class="fas fa-image"></i>
                            </div>
                        }
                        
                        @if (hasMultiplePhotos)
                        {
                            <div class="photo-counter">
                                <span>@(cardPhotoIndex + 1) / @prop.PhotoUrls!.Count</span>
                            </div>
                        }
                        
                        <div class="image-overlay"></div>
                    </div>
                    
                    <div class="card-content">
                        <h3 class="card-title">@prop.Title</h3>
                        <div class="card-location">
                            <i class="fas fa-map-marker-alt"></i> @prop.Address
                        </div>
                        
                        <div class="card-price">@prop.Price?.ToString("N0") ₽</div>
                        
                        <div class="card-specs">
                            <div class="spec">
                                <i class="fas fa-bed"></i> <span>@prop.Rooms спальни</span>
                            </div>
                            <div class="spec">
                                <i class="fas fa-bath"></i> <span>@prop.Bathrooms ванные</span>
                            </div>
                            <div class="spec">
                                <i class="fas fa-ruler-combined"></i> <span>@prop.TotalArea м²</span>
                            </div>
                        </div>

                        <button class="btn-showing" @onclick:stopPropagation @onclick="@(() => OpenModal(prop))">
                            Посмотреть
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal -->
@if (selectedProperty != null)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-container" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">
                <i class="fas fa-times"></i>
            </button>
            
            <!-- Modal Photo Carousel -->
            <div class="modal-image-carousel">
                @if (modalPhotoUrls != null && modalPhotoUrls.Any())
                {
                    <div class="carousel-track" style="transform: translateX(-@(modalCurrentPhotoIndex * 100)%);">
                        @foreach (var photoUrl in modalPhotoUrls)
                        {
                            <div class="carousel-slide">
                                <img src="@photoUrl" alt="@selectedProperty.Title" />
                            </div>
                        }
                    </div>
                    
                    @if (modalPhotoUrls.Count > 1)
                    {
                        <button class="carousel-prev" @onclick="PrevModalPhoto">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button class="carousel-next" @onclick="NextModalPhoto">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        
                        <div class="carousel-dots">
                            @for (int j = 0; j < modalPhotoUrls.Count; j++)
                            {
                                <div class="carousel-dot @(j == modalCurrentPhotoIndex ? "active" : "")" 
                                     @onclick="@(() => GoToModalPhoto(j))"></div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="no-photo-modal">
                        <i class="fas fa-image"></i>
                    </div>
                }
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body">
                <div class="modal-price-row">
                    <div class="modal-price-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <div class="modal-price-value">@selectedProperty.Price?.ToString("N0") ₽</div>
                </div>
                
                <h3 class="modal-title">@selectedProperty.Title</h3>
                
                <div class="modal-address">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>@selectedProperty.Address</span>
                </div>
                
                <div class="modal-info-grid">
                    <div class="modal-info-item">
                        <div class="modal-info-icon">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="modal-info-content">
                            <div class="modal-info-label">Тип недвижимости</div>
                            <div class="modal-info-value">@selectedProperty.PropertyTypeName</div>
                        </div>
                    </div>
                    <div class="modal-info-item">
                        <div class="modal-info-icon">
                            <i class="fas fa-paint-roller"></i>
                        </div>
                        <div class="modal-info-content">
                            <div class="modal-info-label">Отделка стен</div>
                            <div class="modal-info-value">@selectedProperty.WallMaterialName</div>
                        </div>
                    </div>
                    <div class="modal-info-item">
                        <div class="modal-info-icon">
                            <i class="fas fa-vector-square"></i>
                        </div>
                        <div class="modal-info-content">
                            <div class="modal-info-label">Жилая площадь</div>
                            <div class="modal-info-value">@selectedProperty.LivingArea м²</div>
                        </div>
                    </div>
                    <div class="modal-info-item">
                        <div class="modal-info-icon">
                            <i class="fas fa-ruler-combined"></i>
                        </div>
                        <div class="modal-info-content">
                            <div class="modal-info-label">Общая площадь</div>
                            <div class="modal-info-value">@selectedProperty.TotalArea м²</div>
                        </div>
                    </div>
                    <div class="modal-info-item">
                        <div class="modal-info-icon">
                            <i class="fas fa-bed"></i>
                        </div>
                        <div class="modal-info-content">
                            <div class="modal-info-label">Спальни</div>
                            <div class="modal-info-value">@selectedProperty.Rooms</div>
                        </div>
                    </div>
                    <div class="modal-info-item">
                        <div class="modal-info-icon">
                            <i class="fas fa-bath"></i>
                        </div>
                        <div class="modal-info-content">
                            <div class="modal-info-label">Ванные</div>
                            <div class="modal-info-value">@selectedProperty.Bathrooms</div>
                        </div>
                    </div>
                </div>
                
                <button class="modal-booking-btn" @onclick="() => GoToBooking(selectedProperty.PropertyID)">
                    <i class="fas fa-calendar-check"></i>
                    Записаться на показ
                </button>
            </div>
        </div>
    </div>
}



@code {
    string? _searchQuery;
    string? SearchQuery 
    { 
        get => _searchQuery; 
        set { if (_searchQuery != value) { _searchQuery = value; ApplyFilters(); } } 
    }

    string? _filterType;
    string? FilterType 
    { 
        get => _filterType; 
        set { if (_filterType != value) { _filterType = value; ApplyFilters(); } } 
    }

    string _filterSort = "new";
    string FilterSort 
    { 
        get => _filterSort; 
        set { if (_filterSort != value) { _filterSort = value; ApplyFilters(); } } 
    }

    bool showFilters = false;
    string viewMode = "grid";
    PropertyDto? selectedProperty;

    // Photo rotation for cards
    Dictionary<int, int> cardPhotoIndexes = new();
    Dictionary<int, System.Threading.Timer> cardPhotoTimers = new();

    // Modal carousel
    List<string>? modalPhotoUrls;
    int modalCurrentPhotoIndex = 0;

    List<PropertyDto>? allProperties;
    List<PropertyDto>? filteredProperties;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allProperties = await Api.GetPropertiesAsync();
            ApplyFilters();
        }
        catch
        {
            filteredProperties = new();
        }
    }

    void ToggleFilters() => showFilters = !showFilters;

    void ApplyFilters()
    {
        if (allProperties == null)
        {
            filteredProperties = new();
            return;
        }

        var query = allProperties.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            query = query.Where(p => 
                (p.Title?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) == true) ||
                (p.Address?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) == true)
            );
        }

        if (!string.IsNullOrEmpty(FilterType))
            query = query.Where(p => p.PropertyTypeName == FilterType);

        query = FilterSort switch
        {
            "price_asc" => query.OrderBy(p => p.Price),
            "price_desc" => query.OrderByDescending(p => p.Price),
            _ => query
        };

        filteredProperties = query.ToList();
    }

    void ResetFilters()
    {
        SearchQuery = null;
        FilterType = null;
        FilterSort = "new";
        ApplyFilters();
    }

    // Card photo rotation
    void StartPhotoRotation(PropertyDto prop)
    {
        if (prop.PhotoUrls == null || prop.PhotoUrls.Count <= 1) return;
        StopPhotoRotation(prop);
        var timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                var current = cardPhotoIndexes.GetValueOrDefault(prop.PropertyID, 0);
                cardPhotoIndexes[prop.PropertyID] = (current + 1) % prop.PhotoUrls!.Count;
                StateHasChanged();
            });
        }, null, 1500, 1500);
        cardPhotoTimers[prop.PropertyID] = timer;
    }

    void StopPhotoRotation(PropertyDto prop)
    {
        if (cardPhotoTimers.TryGetValue(prop.PropertyID, out var timer))
        {
            timer.Dispose();
            cardPhotoTimers.Remove(prop.PropertyID);
        }
    }

    void OpenModal(PropertyDto prop)
    {
        selectedProperty = prop;
        modalPhotoUrls = prop.PhotoUrls?.ToList() ?? new();
        modalCurrentPhotoIndex = 0;
    }

    void CloseModal()
    {
        selectedProperty = null;
        modalPhotoUrls = null;
        modalCurrentPhotoIndex = 0;
    }

    void PrevModalPhoto()
    {
        if (modalPhotoUrls == null || modalPhotoUrls.Count <= 1) return;
        modalCurrentPhotoIndex = (modalCurrentPhotoIndex - 1 + modalPhotoUrls.Count) % modalPhotoUrls.Count;
        StateHasChanged();
    }

    void NextModalPhoto()
    {
        if (modalPhotoUrls == null || modalPhotoUrls.Count <= 1) return;
        modalCurrentPhotoIndex = (modalCurrentPhotoIndex + 1) % modalPhotoUrls.Count;
        StateHasChanged();
    }

    void GoToModalPhoto(int index)
    {
        modalCurrentPhotoIndex = index;
        StateHasChanged();
    }

    void GoToBooking(int id)
    {
        selectedProperty = null;
        modalPhotoUrls = null;
        Navigation.NavigateTo($"/booking/{id}");
    }

    public void Dispose()
    {
        foreach (var timer in cardPhotoTimers.Values)
        {
            timer.Dispose();
        }
        cardPhotoTimers.Clear();
    }
}