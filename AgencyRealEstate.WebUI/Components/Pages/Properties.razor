@page "/properties"
@rendermode InteractiveServer
@using AgencyRealEstate.WebUI.Services
@using AgencyRealEstate.WebUI.Models
@inject ApiClient Api
@inject NavigationManager Navigation

<div class="main-container">
    @* Декоративные фоновые свечения *@
    <div class="bg-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <div class="page-wrapper">
        
        <div class="section-header fade-in">
            <div class="title-group">
                <h1 class="section-title">Каталог <span class="gold-gradient">недвижимости</span><span class="gold-dot">.</span></h1>
                <p class="section-subtitle">
                    @if (!string.IsNullOrWhiteSpace(Search))
                    {
                        <span>Результаты поиска по запросу: <strong style="color: #fff;">"@Search"</strong></span>
                    }
                    else
                    {
                        <span>Найдите идеальный вариант среди проверенных эксклюзивных объектов</span>
                    }
                </p>
                <div class="section-line"></div>
            </div>

            <div class="filter-pills">
                <button class="pill @(selectedType == null ? "active" : "")" @onclick='() => FilterByType(null)'>
                    <i class="fas fa-layer-group"></i> Все
                </button>
                <button class="pill @(selectedType == "Apartment" ? "active" : "")" @onclick='() => FilterByType("Apartment")'>
                    <i class="fas fa-building"></i> Квартиры
                </button>
                <button class="pill @(selectedType == "House" ? "active" : "")" @onclick='() => FilterByType("House")'>
                    <i class="fas fa-home"></i> Дома
                </button>
                <button class="pill @(selectedType == "Commercial" ? "active" : "")" @onclick='() => FilterByType("Commercial")'>
                    <i class="fas fa-city"></i> Коммерция / Участки
                </button>
            </div>
        </div>

        <div class="property-grid">
            @if (filteredProperties == null)
            {
                @for (int i = 0; i < 8; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-img"></div>
                        <div class="skeleton-text"></div>
                        <div class="skeleton-text short"></div>
                    </div>
                }
            }
            else if (!filteredProperties.Any())
            {
                <div class="empty-state fade-in">
                    <div class="empty-icon-box">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h3>Ничего не нашли</h3>
                    <p>По вашему запросу нет доступных объектов. Попробуйте изменить параметры фильтрации.</p>
                    <button class="reset-btn" @onclick='() => { Search = null; FilterByType(null); }'>Сбросить всё</button>
                </div>
            }
            else
            {
                @foreach (var prop in filteredProperties)
                {
                    <div class="luxury-card fade-in" @onclick="() => GoToProperty(prop.PropertyID)">
                        <div class="card-image-box">
                            @if (prop.PhotoUrls != null && prop.PhotoUrls.Any())
                            {
                                <img src="@prop.PhotoUrls.First()" alt="@prop.PropertyTypeName" />
                            }
                            else
                            {
                                <div class="no-photo-placeholder">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                            
                            <div class="status-badge @prop.StatusName.ToLower()">
                                <span class="status-dot-inner"></span>
                                @TranslateStatus(prop.StatusName)
                            </div>
                            <div class="card-tag-overlay">@prop.PropertyTypeName</div>
                            <div class="card-gradient-overlay"></div>
                        </div>

                        <div class="card-body-luxury">
                            <h3 class="card-address-title">@prop.Address</h3>
                            
                            <div class="card-specs">
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-bed"></i></div>
                                    <span>@prop.Rooms к.</span>
                                </div>
                                <div class="spec-divider"></div>
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-ruler-combined"></i></div>
                                    <span>@prop.TotalArea м²</span>
                                </div>
                                <div class="spec-divider"></div>
                                <div class="spec-item">
                                    <div class="spec-icon"><i class="fas fa-layer-group"></i></div>
                                    <span>@prop.Floor эт.</span>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="price-container">
                                    <span class="price-label">Стоимость</span>
                                    <div class="card-price-tag">@prop.Price?.ToString("N0") <span class="currency">₽</span></div>
                                </div>
                                <div class="btn-view-circle">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    :root {
        --gold: #f39c12;
        --bg-dark: #0a0a0a;
        --card-bg: rgba(25, 25, 25, 0.7);
        --border-glass: rgba(255, 255, 255, 0.08);
    }

    .main-container { background: var(--bg-dark); min-height: 100vh; color: #fff; position: relative; overflow-x: hidden; font-family: 'Inter', sans-serif; }
    .page-wrapper { max-width: 1440px; margin: 0 auto; padding: 120px 40px 80px 40px; position: relative; z-index: 2; }

    /* ФОНОВЫЕ СВЕЧЕНИЯ */
    .bg-orbs { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .orb { position: absolute; filter: blur(140px); border-radius: 50%; opacity: 0.12; animation: floatOrb 12s infinite alternate ease-in-out; }
    .orb-1 { top: -5%; left: -5%; width: 600px; height: 600px; background: var(--gold); }
    .orb-2 { bottom: 10%; right: -5%; width: 500px; height: 500px; background: #3498db; }

    @@keyframes floatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(30px, 40px) scale(1.1); } }

    /* HEADER */
    .section-header { 
        display: flex; justify-content: space-between; align-items: flex-end; 
        margin-bottom: 60px; gap: 30px; 
    }
    .section-title { font-size: 3.5rem; font-weight: 900; margin: 0; letter-spacing: -1.5px; line-height: 1.1; }
    .gold-gradient { background: linear-gradient(135deg, #fbc531, #e67e22); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .gold-dot { color: var(--gold); }
    .section-subtitle { color: #888; margin: 15px 0 0 0; font-size: 1.15rem; font-weight: 300; }
    .section-line { width: 80px; height: 4px; background: var(--gold); margin-top: 25px; border-radius: 4px; }

    /* FILTERS */
    .filter-pills { display: flex; gap: 12px; background: rgba(255,255,255,0.02); padding: 10px; border-radius: 60px; border: 1px solid var(--border-glass); backdrop-filter: blur(10px); }
    .pill {
        padding: 12px 28px; border-radius: 50px; color: #888; background: transparent; border: none;
        cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); font-weight: 600; font-size: 0.95rem;
        display: flex; align-items: center; gap: 8px; font-family: inherit;
    }
    .pill i { font-size: 1rem; transition: 0.3s; }
    .pill.active { background: var(--gold); color: #000; box-shadow: 0 10px 20px rgba(243, 156, 18, 0.2); }
    .pill:hover:not(.active) { color: #fff; background: rgba(255,255,255,0.08); }

    /* GRID & CARDS */
    .property-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 35px; }

    .luxury-card {
        background: var(--card-bg); backdrop-filter: blur(20px); border-radius: 32px; overflow: hidden;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid var(--border-glass); cursor: pointer; position: relative;
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }
    .luxury-card:hover { transform: translateY(-12px); border-color: rgba(243, 156, 18, 0.4); box-shadow: 0 40px 80px rgba(0,0,0,0.6); }

    .card-image-box { height: 260px; position: relative; overflow: hidden; }
    .card-image-box img { width: 100%; height: 100%; object-fit: cover; transition: 0.8s ease; }
    .luxury-card:hover .card-image-box img { transform: scale(1.08); }
    .card-gradient-overlay { position: absolute; inset: 0; background: linear-gradient(to top, var(--card-bg) 0%, transparent 40%); pointer-events: none; }

    /* БЭЙДЖИ СТАТУСА */
    .status-badge {
        position: absolute; top: 20px; right: 20px;
        padding: 8px 16px; border-radius: 12px; font-size: 0.75rem; font-weight: 800;
        text-transform: uppercase; display: flex; align-items: center; gap: 8px;
        backdrop-filter: blur(15px); z-index: 2; border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }
    .status-dot-inner { width: 8px; height: 8px; border-radius: 50%; }

    .status-badge.available { background: rgba(74, 222, 128, 0.15); color: #4ade80; border-color: rgba(74, 222, 128, 0.3); }
    .status-badge.available .status-dot-inner { background: #4ade80; box-shadow: 0 0 10px #4ade80; }
    
    .status-badge.reserved { background: rgba(243, 156, 18, 0.15); color: var(--gold); border-color: rgba(243, 156, 18, 0.3); }
    .status-badge.reserved .status-dot-inner { background: var(--gold); box-shadow: 0 0 10px var(--gold); }
    
    .status-badge.sold, .status-badge.rented { background: rgba(255, 94, 94, 0.15); color: #ff5e5e; border-color: rgba(255, 94, 94, 0.3); }
    .status-badge.sold .status-dot-inner, .status-badge.rented .status-dot-inner { background: #ff5e5e; }

    .card-tag-overlay {
        position: absolute; top: 20px; left: 20px;
        background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); color: #fff; 
        padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 600;
        border: 1px solid rgba(255,255,255,0.1); z-index: 2;
    }

    /* СОДЕРЖИМОЕ КАРТОЧКИ */
    .card-body-luxury { padding: 30px; position: relative; z-index: 2; }
    .card-address-title { font-size: 1.35rem; font-weight: 800; margin-bottom: 20px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #fff; }
    
    .card-specs { display: flex; align-items: center; gap: 12px; margin-bottom: 30px; color: #ccc; background: rgba(255,255,255,0.03); padding: 12px 15px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    .spec-item { display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 600; }
    .spec-icon { color: var(--gold); display: flex; align-items: center; justify-content: center; }
    .spec-divider { width: 1px; height: 16px; background: rgba(255,255,255,0.1); }

    .card-footer { display: flex; justify-content: space-between; align-items: center; }
    .price-label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px; }
    .card-price-tag { font-size: 1.6rem; font-weight: 900; color: #fff; }
    .currency { font-size: 1rem; color: var(--gold); margin-left: 2px; }

    .btn-view-circle {
        width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--border-glass);
        display: flex; align-items: center; justify-content: center; transition: 0.4s; font-size: 1.1rem;
    }
    .luxury-card:hover .btn-view-circle { background: var(--gold); color: #000; border-color: var(--gold); transform: scale(1.1) rotate(-45deg); box-shadow: 0 10px 20px rgba(243,156,18,0.3); }

    /* EMPTY STATE & SKELETON */
    .empty-state { grid-column: 1/-1; text-align: center; padding: 100px 20px; background: var(--card-bg); backdrop-filter: blur(10px); border-radius: 32px; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-icon-box { width: 80px; height: 80px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 2rem; color: var(--gold); }
    .empty-state h3 { font-size: 1.8rem; font-weight: 700; margin-bottom: 10px; }
    .empty-state p { color: #888; font-size: 1.1rem; margin-bottom: 25px; }
    .reset-btn { background: var(--gold); color: #000; border: none; padding: 15px 35px; border-radius: 16px; font-weight: 800; cursor: pointer; transition: 0.3s; }
    .reset-btn:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(243,156,18,0.3); }

    .skeleton-card { height: 480px; background: var(--card-bg); border-radius: 32px; border: 1px solid var(--border-glass); animation: pulse 1.5s infinite; }
    @@keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 0.2; } 100% { opacity: 0.5; } }

    /* ANIMATIONS */
    .fade-in { animation: fadeIn 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) forwards; opacity: 0; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(25px); } to { opacity: 1; transform: translateY(0); } }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .section-header { flex-direction: column; align-items: flex-start; gap: 30px; }
        .section-title { font-size: 2.8rem; }
        .filter-pills { width: 100%; overflow-x: auto; white-space: nowrap; padding: 10px; justify-content: flex-start; border-radius: 20px; }
        .pill { flex-shrink: 0; }
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    string? selectedType;
    List<PropertyDto>? allProperties;
    List<PropertyDto>? filteredProperties;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allProperties = await Api.GetPropertiesAsync();
            ApplyFilters();
        }
        catch { filteredProperties = new(); }
    }

    protected override void OnParametersSet()
    {
        ApplyFilters();
    }

    void FilterByType(string? type)
    {
        selectedType = type;
        ApplyFilters();
    }

    void ApplyFilters()
    {
        if (allProperties == null)
        {
            filteredProperties = new();
            return;
        }

        var query = allProperties.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(Search))
            query = query.Where(p => p.Address?.Contains(Search, StringComparison.OrdinalIgnoreCase) == true);

        if (!string.IsNullOrEmpty(selectedType))
        {
            query = selectedType switch
            {
                "Apartment" => query.Where(p => p.PropertyTypeName == "Квартира"),
                "House" => query.Where(p => p.PropertyTypeName == "Дом" || p.PropertyTypeName == "Таунхаус"),
                "Commercial" => query.Where(p => p.PropertyTypeName == "Коммерческая" || p.PropertyTypeName == "Участок"),
                _ => query
            };
        }

        filteredProperties = query.ToList();
    }

    void GoToProperty(int id) => Navigation.NavigateTo($"/property/{id}");

    string TranslateStatus(string status) => status switch
    {
        "Available" => "Доступно",
        "Reserved" => "В резерве",
        "Sold" => "Продано",
        "Rented" => "Сдано",
        _ => status
    };
}