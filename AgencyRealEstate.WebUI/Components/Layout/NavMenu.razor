@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation

<div class="nav-bar">
    <div class="nav-content">
      
        <div class="logo-wrapper" @onclick='() => Navigation.NavigateTo("/")'>
            <div class="logo-icon"><i class="fas fa-crown"></i></div>
            <div class="logo-text">Elite Estates<span class="accent-dot">.</span></div>
        </div>
        
        <div class="nav-actions">
            
            <a href="/properties" class="nav-link-simple">Каталог</a>

            <AuthorizeView>
                <Authorized>
                    @{
                        var user = context.User;
                        var isAdmin = user.IsInRole("Administrator");
                        var isManager = user.IsInRole("Manager");
                        var isRealtor = user.IsInRole("Realtor");
                        var isClient = user.IsInRole("Client");
                        var hasStaffAccess = isAdmin || isManager || isRealtor;
                        var userName = user.Identity?.Name ?? "Пользователь";
                    }

                    <div class="dropdown-wrapper">
                       
                        <button class="user-profile-btn @(isMenuOpen ? "active" : "")" @onclick="ToggleMenu">
                            <div class="avatar-circle">
                                @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <span class="user-name">@userName</span>
                            <i class="fas fa-chevron-down arrow @(isMenuOpen ? "rotate" : "")"></i>
                        </button>
                        
                       
                        <ul class="luxury-dropdown @(isMenuOpen ? "show" : "")">
                            
                            @if (isClient)
                            {
                                <li class="menu-header">Личный кабинет</li>
                                <li><a href="/profile" @onclick="CloseMenu"><i class="fas fa-user-edit"></i> Мой профиль</a></li>
                                <li><a href="/my-requests" @onclick="CloseMenu"><i class="fas fa-clipboard-list"></i> Мои заявки</a></li>
                            }

                            @if (hasStaffAccess)
                            {
                                <li class="menu-header">Панель управления</li>
                                @if (isAdmin)
                                {
                                    <li><a href="/admin" @onclick="CloseMenu"><i class="fas fa-shield-alt"></i> Администрирование</a></li>
                                }
                                
                                <li class="menu-header">Рабочая область</li>
                                @if (isRealtor)
                                {
                                    <li><a href="/clients" @onclick="CloseMenu"><i class="fas fa-address-book"></i> База клиентов</a></li>
                                }
                                <li><a href="/deals" @onclick="CloseMenu"><i class="fas fa-file-invoice-dollar"></i> Сделки</a></li>
                                <li><a href="/calendar" @onclick="CloseMenu"><i class="fas fa-calendar-check"></i> Расписание</a></li>
                            }
                            
                            <li class="divider"></li>
                            <li>
                                <a href="/logout" class="logout-item" @onclick="CloseMenu">
                                    <i class="fas fa-power-off"></i>
                                    <span>Завершить сеанс</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="sign-in-btn">
                        <span>Личный кабинет</span>
                        <i class="fas fa-sign-in-alt"></i>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@if (isMenuOpen)
{
    <div class="menu-overlay" @onclick="CloseMenu"></div>
}

<style>
    /* Базовые стили из твоего проекта */
    .nav-bar {
        background: rgba(18, 18, 18, 0.85); 
        backdrop-filter: blur(15px); 
        -webkit-backdrop-filter: blur(15px);
        height: 90px;
        width: 100%;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        position: fixed;
        top: 0;
        left: 0;
        z-index: 10000;
    }

    .nav-content {
        max-width: 1440px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 40px;
    }

    .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 15px;
        cursor: pointer;
    }

    .logo-icon {
        width: 40px;
        height: 40px;
        background: #f39c12;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.2rem;
        box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
    }

    .logo-text {
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .accent-dot { color: #f39c12; }
    .nav-actions { display: flex; align-items: center; gap: 30px; }
    
    .nav-link-simple {
        color: #888;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
        font-size: 0.95rem;
    }

    .nav-link-simple:hover { color: #f39c12; }

    .user-profile-btn {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 50px;
        padding: 6px 18px 6px 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #fff;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .user-profile-btn:hover, .user-profile-btn.active {
        background: rgba(255, 255, 255, 0.08);
        border-color: #f39c12;
    }

    .avatar-circle {
        width: 36px;
        height: 36px;
        background: #f39c12;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.9rem;
    }

    .user-name { font-weight: 600; font-size: 0.9rem; }
    .arrow { font-size: 0.7rem; transition: 0.4s; color: #666; }
    .arrow.rotate { transform: rotate(180deg); color: #f39c12; }

    .luxury-dropdown {
        position: absolute;
        top: calc(100% + 15px);
        right: 0;
        background: #1a1a1a;
        min-width: 280px;
        list-style: none;
        padding: 20px 0;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .luxury-dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .menu-header {
        padding: 10px 25px;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #444;
        letter-spacing: 2px;
        font-weight: 800;
        margin-top: 5px;
    }

    .luxury-dropdown li a {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 25px;
        color: #bbb;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: 0.3s;
    }

    .luxury-dropdown li a i { color: #f39c12; opacity: 0.6; font-size: 1rem; width: 20px; text-align: center; }
    
    .luxury-dropdown li a:hover {
        background: rgba(243, 156, 18, 0.05);
        color: #fff;
        padding-left: 32px;
    }

    .luxury-dropdown li a:hover i { opacity: 1; transform: scale(1.1); }
    .divider { height: 1px; background: rgba(255, 255, 255, 0.03); margin: 15px 0; }
    .logout-item { color: #ff5e5e !important; }
    .logout-item i { color: #ff5e5e !important; }

    .sign-in-btn {
        background: #f39c12;
        color: #fff;
        padding: 12px 28px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(243, 156, 18, 0.2);
    }

    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
    }

    @@media (max-width: 768px) {
        .user-name { display: none; }
        .luxury-dropdown { right: -10px; width: calc(100vw - 40px); }
    }
</style>

@code {
    bool isMenuOpen = false;
    void ToggleMenu() => isMenuOpen = !isMenuOpen;
    void CloseMenu() => isMenuOpen = false;
}