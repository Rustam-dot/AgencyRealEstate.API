@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<div class="menu-trigger" onclick="window.menu.toggle()">
    <span class="menu-trigger-bar"></span>
    <span class="menu-trigger-bar"></span>
    <span class="menu-trigger-bar"></span>
</div>

<div class="menu-overlay">
    <div class="menu-container">
        <ul class="menu">
            @if (isLoggedIn)
            {
                <li><a href="/">Главная</a></li>

                @if (hasRealtorAccess)
                {
                    <li><a href="/properties">Каталог объектов</a></li>
                }

                @if (roles.Contains("Realtor"))
                {
                    <li><a href="/clients">Клиенты</a></li>
                }

                @if (hasRealtorAccess)
                {
                    <li><a href="/deals">Сделки</a></li>
                }

                @if (hasManagerAccess)
                {
                    <li><a href="/reports">Отчёты</a></li>
                }

                @if (roles.Contains("Client"))
                {
                    <li><a href="/client-cabinet">Личный кабинет</a></li>
                }

                <li><a href="/logout">Выйти</a></li>
            }
            else
            {
                <li><a href="/login">Войти</a></li>
            }
        </ul>
    </div>
</div>

@code {
    bool isLoggedIn;
    List<string> roles = new();
    bool hasRealtorAccess;
    bool hasManagerAccess;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask is not null)
        {
            var authState = await authenticationStateTask;
            isLoggedIn = authState.User.Identity?.IsAuthenticated == true;
            roles = authState.User.Claims
                .Where(c => c.Type == ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();

            hasRealtorAccess = roles.Contains("Administrator") || roles.Contains("Manager") || roles.Contains("Realtor");
            hasManagerAccess = roles.Contains("Administrator") || roles.Contains("Manager");
        }
    }
}