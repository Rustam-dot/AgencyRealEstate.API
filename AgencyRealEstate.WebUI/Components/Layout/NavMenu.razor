@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation

<div class="nav-bar">
    <div class="nav-content">
        <div class="logo" @onclick='() => Navigation.NavigateTo("/")'>
            Elite Estates<span class="accent-dot">.</span>
        </div>
        
        <div class="nav-actions">
            @if (isLoggedIn)
            {
                <div class="dropdown-wrapper">
                    @* Кнопка управления меню *@
                    <button class="menu-toggle-btn @(isMenuOpen ? "active" : "")" @onclick="ToggleMenu">
                        <span>Меню</span>
                        <i class="fas fa-chevron-down arrow @(isMenuOpen ? "rotate" : "")"></i>
                    </button>
                    
                    @* Выпадающее меню *@
                    <ul class="luxury-dropdown @(isMenuOpen ? "show" : "")">
                        <li class="menu-header">Навигация</li>
                        <li><a href="/" @onclick="CloseMenu"><i class="fas fa-home"></i> Главная</a></li>
                        
                        @if (roles.Contains("Administrator"))
                        {
                            <li><a href="/admin" @onclick="CloseMenu"><i class="fas fa-users-cog"></i> Пользователи</a></li>
                        }
                        @if (hasRealtorAccess)
                        {
                            <li><a href="/properties" @onclick="CloseMenu"><i class="fas fa-building"></i> Каталог</a></li>
                        }
                        @if (roles.Contains("Realtor"))
                        {
                            <li><a href="/clients" @onclick="CloseMenu"><i class="fas fa-user-tie"></i> Клиенты</a></li>
                        }
                        @if (hasRealtorAccess)
                        {
                            <li><a href="/deals" @onclick="CloseMenu"><i class="fas fa-handshake"></i> Сделки</a></li>
                        }
                        
                        <li class="divider"></li>
                        <li>
                            <a href="/logout" class="logout-item" @onclick="CloseMenu">
                                <span>Выйти</span>
                                <i class="fas fa-sign-out-alt"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/login" class="sign-in-btn">Войти</a>
            }
        </div>
    </div>
</div>

@* Подложка для закрытия при клике вне меню *@
@if (isMenuOpen)
{
    <div class="menu-overlay" @onclick="CloseMenu"></div>
}

<style>
    /* ГЛАВНАЯ ПАНЕЛЬ */
    .nav-bar {
        background: #1a1a1a;
        height: 80px;
        width: 100%;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        position: fixed; /* Чтобы всегда была сверху при скролле */
        top: 0;
        left: 0;
        z-index: 9999; /* Максимальный приоритет */
        overflow: visible; /* ВАЖНО: чтобы меню не обрезалось */
    }

    .nav-content {
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 40px;
    }

    .logo {
        color: #fff;
        font-size: 1.6rem;
        font-weight: 800;
        cursor: pointer;
        letter-spacing: -0.5px;
    }

    .accent-dot { color: #f39c12; }

    /* КНОПКА МЕНЮ (как на скриншоте) */
    .menu-toggle-btn {
        background: transparent;
        border: none;
        color: #f39c12; /* Оранжевый текст как на скриншоте */
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 15px;
        transition: all 0.3s ease;
    }

    .menu-toggle-btn .arrow {
        font-size: 0.9rem;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .menu-toggle-btn .arrow.rotate {
        transform: rotate(180deg);
    }

    /* ВЫПАДАЮЩИЙ СПИСОК (LUXURY STYLE) */
    .dropdown-wrapper {
        position: relative;
    }

    .luxury-dropdown {
        position: absolute;
        top: calc(100% + 15px);
        right: 0;
        background: #242424;
        min-width: 260px;
        list-style: none;
        padding: 15px 0;
        margin: 0;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        z-index: 10000;
        
        /* Анимация появления */
        display: block;
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px) scale(0.95);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        transform-origin: top right;
    }

    .luxury-dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .menu-header {
        padding: 0 25px 10px 25px;
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #666;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .luxury-dropdown li a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 25px;
        color: #ddd;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .luxury-dropdown li a i {
        width: 20px;
        color: #555;
        transition: color 0.2s;
    }

    .luxury-dropdown li a:hover {
        background: rgba(243, 156, 18, 0.1);
        color: #f39c12;
        padding-left: 30px;
    }

    .luxury-dropdown li a:hover i {
        color: #f39c12;
    }

    .divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.05);
        margin: 10px 0;
    }

    /* ВЫХОД (СТИЛЬ КНОПКИ) */
    .logout-item {
        color: #ff5e5e !important;
        justify-content: space-between;
    }

    .logout-item:hover {
        background: rgba(255, 94, 94, 0.1) !important;
    }

    /* КНОПКА ВОЙТИ (Pill style) */
    .sign-in-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        padding: 10px 25px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

    .sign-in-btn:hover {
        background: #fff;
        color: #1a1a1a;
    }

    /* ФОНОВАЯ ПОДЛОЖКА */
    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: transparent;
        z-index: 9998;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .nav-content { padding: 0 20px; }
        .luxury-dropdown { width: calc(100vw - 40px); right: -10px; }
    }
</style>

@code {
    bool isLoggedIn;
    List<string> roles = new();
    bool hasRealtorAccess;
    bool hasManagerAccess;
    bool isMenuOpen = false;

    void ToggleMenu() => isMenuOpen = !isMenuOpen;
    void CloseMenu() => isMenuOpen = false;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask is not null)
        {
            var authState = await authenticationStateTask;
            isLoggedIn = authState.User.Identity?.IsAuthenticated == true;
            roles = authState.User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).ToList();
            hasRealtorAccess = roles.Contains("Administrator") || roles.Contains("Manager") || roles.Contains("Realtor");
            hasManagerAccess = roles.Contains("Administrator") || roles.Contains("Manager");
        }
    }
}